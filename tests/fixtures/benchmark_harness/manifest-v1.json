          "oracle": {
            "signal": "text_declaration",
            "module": "Pkg.CoreShared",
            "name": "keptUnsafe",
            "kind": "def",
            "authority": "lexical_text",
            "expected": true
          }
        },
        {
          "id": "declaration.opaque",
          "class": "positive",
          "metricFamily": "coverage",
          "signalKind": "text_declaration_opaque",
          "expectedOutcome": "present",
