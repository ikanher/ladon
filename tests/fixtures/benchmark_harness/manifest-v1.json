          "oracle": {
            "signal": "text_declaration",
            "module": "Pkg.CoreShared",
            "name": "keptAxiom",
            "kind": "axiom",
            "authority": "lexical_text",
            "expected": true
          }
        },
        {
          "id": "declaration.masked-block-comment",
          "class": "intentional_negative",
          "metricFamily": "coverage",
          "signalKind": "text_declaration_masking",
          "expectedOutcome": "absent",
          "rationale": "Declaration-shaped text in a block comment must not enter the inventory.",
          "oracle": {
            "signal": "text_declaration",
            "module": "Pkg.CoreShared",
            "name": "BlockFake",
            "expected": false
          }
        },
        {
          "id": "declaration.masked-string",
          "class": "intentional_negative",
          "metricFamily": "coverage",
          "signalKind": "text_declaration_masking",
          "expectedOutcome": "absent",
          "rationale": "Declaration-shaped string content must not enter the inventory.",
          "oracle": {
            "signal": "text_declaration",
            "module": "Pkg.CoreShared",
            "name": "StringFake",
            "expected": false
          }
        },
        {
          "id": "trust.lexical-sorry",
          "class": "positive",
          "metricFamily": "coverage",
          "signalKind": "trust_footprint",
          "expectedOutcome": "present",
          "authority": "lexical_text",
          "rationale": "A real source sorry is preserved as non-elaborated lexical trust evidence.",
          "oracle": {
            "signal": "lexical_marker",
            "module": "Pkg.CoreShared",
            "kind": "sorry",
            "authority": "lexical_text",
            "expected": true
          }
        },
        {
          "id": "facade.public-root",
          "class": "positive",
          "metricFamily": "correctness",
          "signalKind": "facade_classification",
          "expectedOutcome": "exact",
          "rationale": "The top-level import-only project root is a portable public-root facade.",
          "oracle": {
            "signal": "facade_subtype_count",
            "subtype": "public_root_facade",
            "expected": 1
