          "oracle": {
            "signal": "architecture_pair_count",
            "sourceGroup": "owners",
            "targetGroup": "cores",
            "expected": 6
          }
        },
        {
          "id": "source-pattern.present",
          "class": "positive",
          "metricFamily": "correctness",
          "signalKind": "source_pattern",
          "expectedOutcome": "exact",
          "promotionFamily": "source_pattern",
          "rationale": "The reviewed source contains exactly one deprecated local term.",
          "oracle": {
            "signal": "source_pattern_match_count",
            "patternId": "deprecated-local-term",
            "expected": 1
          }
        },
        {
          "id": "source-pattern.intentional-absent",
          "class": "intentional_negative",
          "metricFamily": "correctness",
          "signalKind": "source_pattern",
          "expectedOutcome": "absent",
          "promotionFamily": "source_pattern",
          "rationale": "An absent configured term must not produce a match.",
          "oracle": {
            "signal": "source_pattern_match_count",
            "patternId": "intentional-absent-term",
            "expected": 0
          }
        },
        {
          "id": "source-pattern.count-boundary",
          "class": "boundary",
          "metricFamily": "correctness",
          "signalKind": "source_pattern",
          "expectedOutcome": "exact",
          "promotionFamily": "source_pattern",
          "rationale": "The promoted source pattern is guarded by an exact reviewed count, not merely substring presence.",
          "oracle": {
            "signal": "source_pattern_match_count",
            "patternId": "deprecated-local-term",
            "expected": 1
          }
        }
      ],
      "rationale": "One installed text-backend run exercises the signal-correctness handoff without a benchmark-only analysis route."
