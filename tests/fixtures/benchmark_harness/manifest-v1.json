          "oracle": {
            "signal": "text_declaration",
            "module": "Pkg.CoreShared",
            "name": "keptOpaque",
            "kind": "opaque",
            "authority": "lexical_text",
            "expected": true
          }
        },
        {
          "id": "declaration.axiom",
          "class": "positive",
          "metricFamily": "coverage",
          "signalKind": "text_declaration_axiom",
          "expectedOutcome": "present",
          "authority": "lexical_text",
