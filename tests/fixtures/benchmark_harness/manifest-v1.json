{
  "artifactKind": "ladon_signal_benchmark_manifest",
  "schemaVersion": 1,
  "productVersion": "0.1.0-alpha",
  "reportVersion": "ladon-report-v2",
  "metricFamilies": [
    "correctness",
    "coverage",
    "runtime",
    "memory",
    "cache",
    "process",
    "stability"
  ],
  "budgets": {
    "coldWallSeconds": 20.0,
    "warmWallSeconds": 20.0,
    "peakRssMiB": 512.0,
    "jsonBytes": 2000000,
    "textBytes": 500000,
    "timeoutCleanupSeconds": 5.0,
    "inventoryHelperLaunches": 12,
    "rationale": "Portable fixtures normally finish in well under one second and below 100 MiB on development hardware. The required ceilings are deliberately broad CI regression tripwires, not throughput claims."
  },
  "cases": [
    {
      "id": "text-structural-signals",
      "required": true,
      "fixture": "tests/fixtures/benchmark_harness/text_signals",
      "fixtureOwner": "ladon-signal-benchmark-harness from the reviewed signal-correctness handoff",
      "executionMode": "installed_cli",
      "command": [
        "ladon",
        "--repo-root",
        "{fixture}",
        "--root",
        "Pkg.lean",
        "--format",
        "json",
        "--output",
        "{output}",
        "--generated-at-utc",
        "2026-07-25T00:00:00+00:00"
      ],
      "reportVersion": "ladon-report-v2",
      "metrics": [
        "correctness",
        "coverage",
        "runtime",
        "memory",
        "stability"
      ],
      "labels": [
        {
          "id": "missing-internal.pkg-missing",
          "class": "positive",
          "metricFamily": "correctness",
          "signalKind": "missing_internal_import",
          "expectedOutcome": "present",
          "authority": "lexical_text",
          "promotionFamily": "missing_internal_import",
          "rationale": "Pkg is a discovered project namespace even though the missing import is owned by a nested module.",
          "oracle": {
            "signal": "missing_internal_import",
            "targetModule": "Pkg.Missing",
            "authority": "lexical_text",
            "expected": true
          }
        },
        {
          "id": "missing-internal.external-missing",
          "class": "intentional_negative",
          "metricFamily": "correctness",
          "signalKind": "missing_internal_import",
          "expectedOutcome": "absent",
          "promotionFamily": "missing_internal_import",
          "rationale": "The fixture does not own the External namespace, so the absent import is not an internal missing module.",
          "oracle": {
            "signal": "missing_internal_import",
            "targetModule": "External.Missing",
            "expected": false
          }
        },
        {
          "id": "missing-internal.authority-boundary",
          "class": "boundary",
          "metricFamily": "correctness",
          "signalKind": "missing_internal_import",
          "expectedOutcome": "exact",
          "authority": "lexical_text",
          "promotionFamily": "missing_internal_import",
          "rationale": "The internal-missing classification remains source-authority evidence at the project-namespace boundary.",
          "oracle": {
            "signal": "missing_internal_import",
            "targetModule": "Pkg.Missing",
            "authority": "lexical_text",
            "expected": true
          }
        },
        {
