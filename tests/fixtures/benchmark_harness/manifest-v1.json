          "metricFamily": "coverage",
          "signalKind": "text_declaration_theorem",
          "expectedOutcome": "present",
          "authority": "lexical_text",
          "rationale": "Attributes and a private modifier are within the scanner's documented bounded surface.",
          "oracle": {
            "signal": "text_declaration",
            "module": "Pkg.CoreShared",
            "name": "keptTheorem",
            "kind": "theorem",
            "authority": "lexical_text",
            "expected": true
          }
        },
        {
          "id": "declaration.modified-def",
          "class": "positive",
          "metricFamily": "coverage",
          "signalKind": "text_declaration_def",
          "expectedOutcome": "present",
          "authority": "lexical_text",
          "rationale": "A noncomputable definition is a documented supported modifier and kind.",
          "oracle": {
            "signal": "text_declaration",
            "module": "Pkg.CoreShared",
            "name": "keptDef",
            "kind": "def",
            "authority": "lexical_text",
            "expected": true
          }
        },
        {
          "id": "declaration.unsafe-def",
