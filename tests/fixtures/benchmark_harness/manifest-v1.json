          }
        },
        {
          "id": "fan-in.mixed-handwritten",
          "class": "boundary",
          "metricFamily": "correctness",
          "signalKind": "fan_population",
          "expectedOutcome": "exact",
          "authority": "module_import_graph",
          "rationale": "The handwritten population excludes generated importers and generated targets.",
          "oracle": {
            "signal": "fan_population_count",
            "table": "top_handwritten_fan_in",
            "module": "Pkg.CoreMixed",
            "population": "handwritten_importers_to_handwritten_targets",
