          "oracle": {
            "signal": "fan_population_count",
            "table": "top_generated_importer_fan_in",
            "module": "Pkg.CoreMixed",
            "population": "generated_importers_to_all_targets",
            "authority": "module_import_graph",
            "expected": 5
          }
        },
        {
          "id": "fan-in.equivalent-promotion",
          "class": "boundary",
          "metricFamily": "correctness",
          "signalKind": "finding_deduplication",
          "expectedOutcome": "exact",
