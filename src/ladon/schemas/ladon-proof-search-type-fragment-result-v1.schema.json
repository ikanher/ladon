{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ladon-proof-search-type-fragment-result-v1.schema.json",
  "title": "Normalized lexical type-fragment shortlist",
  "type": "object",
  "required": ["schema", "schemaVersion", "operation", "matchMode", "matchingPolicy", "status", "freshness", "results", "matched", "matchedExact", "returned", "diagnostics", "query", "coverage", "truncated", "omissions", "nonclaims"],
  "properties": {
    "schema": {"const": "ladon-proof-search-type-fragment-result-v1"},
    "schemaVersion": {"const": 1},
    "operation": {"const": "search-type-text"},
    "matchMode": {"const": "normalized-type-fragments"},
    "matchingPolicy": {"const": "case-sensitive-lean-token-sequence-v1"},
    "status": {"const": "available"},
    "freshness": {"enum": ["stored", "verified-fresh"]},
    "results": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/row"}},
    "matched": {"type": "integer", "minimum": 0, "maximum": 2001},
    "matchedExact": {"type": "boolean"},
    "returned": {"type": "integer", "minimum": 0, "maximum": 1000},
    "diagnostics": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "query": {"type": "object", "required": ["fragments", "scope", "module", "namespace", "package", "freshness"], "properties": {"fragments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "coverage": {"type": "object", "required": ["shortlistMatchedLowerBound", "returned", "diagnosticReturned", "cap", "diagnosticCap", "populationComplete", "rowEvidenceComplete", "authority", "scope", "fieldContributionCounts"], "properties": {"authority": {"const": "sqlite_lexical_shortlist"}, "scope": {"type": "object"}, "fieldContributionCounts": {"type": "object"}}},
    "truncated": {"type": "boolean"},
    "omissions": {"type": "array", "items": {"type": "object"}},
    "nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "row": {"type": "object", "required": ["declarationId", "candidateName", "authority", "verification", "typeStatus", "typeText", "typeTextBytes", "typeTextTruncated", "renderedType", "conclusionText", "fieldContributions", "fragmentEvidence", "fragmentMatches", "conclusionAvailable", "conclusionMatchCount", "bucket"], "properties": {"authority": {"const": "lexical_shortlist"}, "verification": {"const": "not_requested"}, "fragmentEvidence": {"type": "array", "items": {"type": "object", "required": ["fragment", "fields"], "properties": {"fragment": {"type": "string"}, "fields": {"type": "array", "items": {"enum": ["renderedType", "conclusionText", "typeText"]}}}}}, "fragmentMatches": {"type": "array", "items": {"type": "string"}}, "conclusionAvailable": {"type": "boolean"}, "conclusionMatchCount": {"type": "integer", "minimum": 0}, "bucket": {"const": "normalized-fragment-match"}}}
  }
}
