{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ladon:result-manifest:v1",
  "title": "Experimental Ladon result manifest v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ladon-result-manifest-v1",
      "type": "string"
    },
    "resultId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "x-maxUtf8Bytes": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previousRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "x-maxUtf8Bytes": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "x-maxUtf8Bytes": 4096
    },
    "claimInventory": {
      "$ref": "#/$defs/inventory"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schema",
    "resultId",
    "revision",
    "title",
    "claimInventory",
    "claims",
    "targets",
    "links",
    "reviews"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "x-maxUtf8Bytes": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "document": {
      "type": "object",
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "locator",
        "digest"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "projectRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-maxUtf8Bytes": 256
        }
      },
      "required": [
        "path",
        "digest",
        "projectRevision"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "toolchain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-maxUtf8Bytes": 256
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "toolchain",
        "digest"
      ],
      "additionalProperties": false
    },
    "subjectRef": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "x-maxUtf8Bytes": 512
        }
      },
      "required": [
        "artifactId",
        "subjectId"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "x-maxUtf8Bytes": 65536
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-maxUtf8Bytes": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "revision",
        "statement",
        "document",
        "components"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "x-maxUtf8Bytes": 512
        },
        "typeText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "x-maxUtf8Bytes": 65536
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "subjectRef": {
          "$ref": "#/$defs/subjectRef"
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "typeText",
        "source",
        "environment"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "claimId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "componentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-maxUtf8Bytes": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "targetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-maxUtf8Bytes": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "claimId",
        "componentIds",
        "targetIds"
      ],
      "additionalProperties": false
    },
    "targetRevision": {
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "targetId",
        "revision"
      ],
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "x-maxUtf8Bytes": 512
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "enum": [
            "human",
            "model",
            "tool"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "difference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "enum": [
            "assumption",
            "domain",
            "quantifier",
            "conclusion",
            "scope"
          ]
        },
        "claimAnchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "formalAnchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "x-maxUtf8Bytes": 65536
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "enum": [
            "reviewer-asserted",
            "syntactic-comparison",
            "external-comparison-quoted"
          ]
        }
      },
      "required": [
        "kind",
        "claimAnchor",
        "formalAnchor",
        "description",
        "basis"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "linkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "linkDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "claimRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "x-maxUtf8Bytes": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "targetRevisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetRevision"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-maxUtf8Bytes": 64,
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "x-maxUtf8Bytes": 65536
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "enum": [
            "reviewed-aligned",
            "reviewed-with-differences",
            "disputed"
          ]
        },
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/difference"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "linkId",
        "linkDigest",
        "claimRevision",
        "targetRevisions",
        "reviewer",
        "method",
        "timestamp",
        "rationale",
        "status",
        "differences"
      ],
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "x-maxUtf8Bytes": 4096
        },
        "coverage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        }
      },
      "required": [
        "scope",
        "coverage"
      ],
      "additionalProperties": false
    }
  }
}
