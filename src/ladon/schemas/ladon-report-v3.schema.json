{
  "$id": "urn:ladon:report:ladon-report-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "id", "severity", "message", "phase", "subject", "data"],
      "properties": {
        "ref": {"type": "string", "pattern": "^diagnostic:"},
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string"},
        "phase": {"type": ["string", "null"]},
        "subject": {"type": ["string", "null"]},
        "data": {"type": "object"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "source", "backend", "version"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "backend": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "required",
        "disposition",
        "elapsed_seconds",
        "counters",
        "reason",
        "diagnosticRefs",
        "provenance",
        "payloadRef"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "skipped", "partial", "failed"]},
        "required": {"type": "boolean"},
        "disposition": {
          "enum": [
            "accepted",
            "complete",
            "failed",
            "required-rejection",
            "selector-rejection",
            "skipped",
            "strict-rejection"
          ]
        },
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "counters": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "reason": {"type": ["string", "null"]},
        "diagnosticRefs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^diagnostic:"},
          "uniqueItems": true
        },
        "provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/provenance"}
        },
        "payloadRef": {
          "type": ["string", "null"],
          "pattern": "^#/sections/"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "elapsed_seconds", "counters", "payloadRef"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "skipped", "partial", "failed"]},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "counters": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "payloadRef": {
          "type": ["string", "null"],
          "pattern": "^#/sections/"
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "version",
        "status",
        "authority",
        "provenance",
        "reason",
        "payloadRef",
        "payloadView"
      ],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "skipped", "partial", "failed"]},
        "authority": {"type": "string", "minLength": 1},
        "provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/provenance"}
        },
        "reason": {"type": ["string", "null"]},
        "payloadRef": {
          "type": ["string", "null"],
          "pattern": "^#/sections/"
        },
        "payloadView": {"type": ["object", "null"]}
      }
    },
    "coverageCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "detail", "controllingCap"],
      "properties": {
        "kind": {
          "enum": [
            "extraction",
            "analysis",
            "projection",
            "drift",
            "compatibility"
          ]
        },
        "id": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "controllingCap": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "collectionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"totalKnown": {"const": true}},
            "required": ["totalKnown"]
          },
          "then": {
            "properties": {
              "total": {"type": "integer", "minimum": 0},
              "omitted": {"type": "integer", "minimum": 0}
            }
          },
          "else": {
            "properties": {
              "total": {"type": "null"},
              "omitted": {"type": "null"},
              "completeness": {
                "enum": ["partial", "unavailable", "unstable"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"completeness": {"const": "complete"}},
            "required": ["completeness"]
          },
          "then": {
            "properties": {
              "totalKnown": {"const": true},
              "omitted": {"const": 0},
              "causes": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "causes": {"minItems": 1}
            }
          }
        }
      ],
      "required": [
        "id",
        "pointer",
        "visible",
        "observedLowerBound",
        "totalKnown",
        "total",
        "omitted",
        "completeness",
        "population",
        "scope",
        "authority",
        "sourceFingerprint",
        "scopeFingerprint",
        "analysisFingerprint",
        "causes"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "pointer": {"type": "string", "pattern": "^#/"},
        "visible": {"type": "integer", "minimum": 0},
        "observedLowerBound": {"type": "integer", "minimum": 0},
        "totalKnown": {"type": "boolean"},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "omitted": {"type": ["integer", "null"], "minimum": 0},
        "completeness": {
          "enum": ["complete", "partial", "unavailable", "unstable"]
        },
        "population": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "sourceFingerprint": {"type": ["string", "null"]},
        "scopeFingerprint": {"type": ["string", "null"]},
        "analysisFingerprint": {"type": ["string", "null"]},
        "causes": {
          "type": "array",
          "items": {"$ref": "#/$defs/coverageCause"}
        }
      }
    },
    "coverageRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "collections"],
      "properties": {
        "schema": {"const": "ladon-collection-coverage-v1"},
        "collections": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/collectionCoverage"
          }
        }
      }
    },
    "snapshotIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "identity", "sourceIndexFingerprint", "decision"],
      "properties": {
        "schema": {"const": "ladon-analysis-snapshot-v1"},
        "identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceIndexFingerprint": {"type": "string", "minLength": 1},
        "decision": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/snapshotDecision"}
          ]
        }
      }
    },
    "snapshotDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostic", "mismatches", "nonclaim"],
      "properties": {
        "status": {"enum": ["stable", "changed"]},
        "diagnostic": {
          "type": ["string", "null"],
          "enum": [null, "source_changed_during_analysis"]
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["path", "expected", "actual", "collectionRefs"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "collectionRefs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "nonclaim": {"type": "string", "minLength": 1}
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "reason", "omitted_count"],
      "properties": {
        "pointer": {"type": "string", "pattern": "^#/sections/"},
        "reason": {
          "enum": [
            "projection_collection_limit",
            "projection_evidence_unavailable"
          ]
        },
        "omitted_count": {"type": "integer", "minimum": 1},
        "coverageRef": {"type": ["string", "null"]}
      }
    }
  },
  "required": [
    "metadata",
    "projection",
    "warnings",
    "diagnostics",
    "phases",
    "extensions",
    "pipeline",
    "sections"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tool_name",
        "tool_version",
        "report_version",
        "source_report_version",
        "generated_at_utc",
        "repo_root",
        "analysis_root",
        "analysis_root_module",
        "inventory_root",
        "extraction_backend"
      ],
      "properties": {
        "tool_name": {"const": "ladon"},
        "tool_version": {"type": "string"},
        "report_version": {"const": "ladon-report-v3"},
        "source_report_version": {"const": "ladon-report-v2"},
        "generated_at_utc": {"type": ["string", "null"]},
        "repo_root": {"type": "string"},
        "analysis_root": {"type": "string"},
        "analysis_root_module": {"type": "string"},
        "inventory_root": {"type": "string"},
        "report_anchor": {"type": "string"},
        "report_anchor_module": {"type": "string"},
        "extraction_backend": {"type": "string"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "analysis_fingerprint",
        "included_sections",
        "omissions",
        "limits"
      ],
      "properties": {
        "id": {
          "enum": [
            "ladon-report-v3:summary",
            "ladon-report-v3:review",
            "ladon-report-v3:full"
          ]
        },
        "name": {"enum": ["summary", "review", "full"]},
        "analysis_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "included_sections": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "omissions": {
          "type": "array",
          "items": {"$ref": "#/$defs/omission"}
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_collection_items"],
          "properties": {
            "max_collection_items": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "max_unstratified_collection_items": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "max_items_per_present_stratum": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "selection_policy": {
              "enum": ["per_present_stratum", "unbounded"]
            }
          }
        },
        "ownerProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "selectedPopulation", "globalPopulation", "globalSuppressed", "suppressedCount", "globalSample", "cap", "widening"],
          "properties": {
            "policy": {"const": "owner-first-v1"},
            "selectedPopulation": {"type": "integer", "minimum": 0},
            "globalPopulation": {"type": "integer", "minimum": 0},
            "globalSuppressed": {"type": "boolean"},
            "suppressedCount": {"type": "integer", "minimum": 0},
            "globalSample": {"enum": ["included", "opt-in-via-full-projection"]},
            "cap": {"type": ["integer", "null"], "minimum": 1},
            "widening": {"type": ["string", "null"]}
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "coverage": {"$ref": "#/$defs/coverageRegistry"},
    "snapshot": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/snapshotIdentity"}
      ]
    },
    "phases": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/phase"},
      "propertyNames": {
        "enum": [
          "build",
          "discover",
          "lean_extraction",
          "indexing",
          "module_dag",
          "declaration_graph",
          "module_readiness",
          "architecture_policy",
          "source_patterns",
          "import_diet",
          "proof_xray",
          "quality_baseline",
          "findings",
          "refactoring_prescriptions",
          "packet_evidence",
          "review_regions",
          "rendering"
        ]
      },
      "required": [
        "build",
        "discover",
        "lean_extraction",
        "indexing",
        "module_dag",
        "declaration_graph",
        "module_readiness",
        "architecture_policy",
        "source_patterns",
        "import_diet",
        "proof_xray",
        "quality_baseline",
        "findings",
        "refactoring_prescriptions",
        "packet_evidence",
        "review_regions",
        "rendering"
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/extension"},
      "propertyNames": {
        "enum": [
          "atlas",
          "elaborated_declarations",
          "packet_evidence",
          "proof_xray"
        ]
      },
      "required": [
        "atlas",
        "elaborated_declarations",
        "packet_evidence",
        "proof_xray"
      ]
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timings"],
      "properties": {
        "timings": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/timing"},
          "propertyNames": {
            "enum": [
              "build",
              "discover",
              "lean_extraction",
              "indexing",
              "module_dag",
              "declaration_graph",
              "module_readiness",
              "architecture_policy",
              "source_patterns",
              "import_diet",
              "proof_xray",
              "quality_baseline",
              "findings",
              "refactoring_prescriptions",
              "packet_evidence",
              "review_regions",
              "rendering"
            ]
          },
          "required": [
            "build",
            "discover",
            "lean_extraction",
            "indexing",
            "module_dag",
            "declaration_graph",
            "module_readiness",
            "architecture_policy",
            "source_patterns",
            "import_diet",
            "proof_xray",
            "quality_baseline",
            "findings",
            "refactoring_prescriptions",
            "packet_evidence",
            "review_regions",
            "rendering"
          ]
        }
      }
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  }
}
