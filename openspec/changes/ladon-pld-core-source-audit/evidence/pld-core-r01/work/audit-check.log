Mf.DP.analyticGaussianCondition_iff_gaussianReal_event_form_explicit (Δ σ ε δ : ℝ) (hσ : 0 < σ) :
  Mf.DP.analyticGaussianCondition Δ σ ε δ ↔
    (ProbabilityTheory.gaussianReal (Δ / 2) ⟨σ ^ 2, ⋯⟩).real (Set.Iic (Δ - ε * σ ^ 2 / Δ)) -
        Real.exp ε * (ProbabilityTheory.gaussianReal (-Δ / 2) ⟨σ ^ 2, ⋯⟩).real (Set.Iic (-Δ - ε * σ ^ 2 / Δ)) ≤
      δ
Mf.DP.gaussianPair_eventApproxDP_centered_of_analyticCondition_lt_one {n : ℕ} (d : Mf.DP.BSROutput n) (Δ σ ε δ : ℝ) :
  0 < σ →
    0 ≤ ε →
      0 ≤ Δ →
        (Mf.DP.bsrSqDist d fun x => 0) ≤ (Δ / 2) ^ 2 →
          Mf.DP.analyticGaussianCondition Δ σ ε δ →
            δ < 1 →
              ∀ (s : Set (Mf.Probability.FiniteGaussian.Vector n)),
                MeasurableSet s →
                  (Mf.DP.bsrGaussianMeasure σ d) s ≤
                    ENNReal.ofReal (Real.exp ε) * (Mf.DP.bsrGaussianMeasure σ fun i => -d i) s + ENNReal.ofReal δ
