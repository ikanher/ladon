\n### evidence/manifest.json
{
  "schema": "ladon-result-manifest-v1",
  "resultId": "poisson-fixed-epoch-exposition-20261003-r02",
  "title": "Fixed-participation finite and sparse comparison: exact printed claims",
  "claimInventory": {
    "scope": "Every theorem, lemma, proposition and corollary environment in the final TeX, with components distinguishing transcript statements, conventional average-only extensions and translations. Does not inventory every equation, definition or proof step. Links carry the existing model-attributed source correspondence; exact stored target resolution does not establish informal equivalence.",
    "coverage": "complete"
  },
  "claims": [
    {
      "id": "lem:calibration",
      "statement": "\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "finite-properties",
        "fullbatch",
        "gaussian-and-average"
      ],
      "revision": "sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5"
    },
    {
      "id": "thm:rate-adaptive-pointwise",
      "statement": "\\begin{theorem}[Finite-horizon comparison]\\label{thm:rate-adaptive-pointwise}\nLet $T>E>0$ be integers, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n$a^2\\leq\\Lambda_{E,T}\\varepsilon$, then\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\\qquad\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S)\n \\quad(S\\geq0).\n\\]\n\\end{theorem}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-pointwise",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "transcript",
        "closed-symmetric",
        "average"
      ],
      "revision": "sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a"
    },
    {
      "id": "cor:fixed-epoch-all-horizon",
      "statement": "\\begin{corollary}[All finite horizons]\\label{cor:fixed-epoch-all-horizon}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n\\begin{equation}\\label{eq:epoch-uniform-condition}\n a^2\\leq\\Lambda_E\\varepsilon,\\qquad \\Lambda_E=\\frac{6E}{3E+2},\n\\end{equation}\nthen for every integer $T>E$,\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, simultaneously for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{corollary}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#cor:fixed-epoch-all-horizon",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "transcript",
        "average"
      ],
      "revision": "sha256:0108f8bad055aabc20a15fde2fed178bec5d26a78e097a8113a6d68967beea83"
    },
    {
      "id": "thm:strict-interior-counterexample",
      "statement": "\\begin{theorem}[An adjacent smaller batch can win]\\label{thm:strict-interior-counterexample}\nFor $\\Delta=1$, $E=2$, $\\varepsilon=1/4$, and $\\delta=3/4$, write\n$v_T=v_{2,T}$. Then\n\\[\n v_3\\leq\\frac5{32}<\\frac4{25}<v_2,\n \\qquad\n V_2(3,S)<V_2(2,S)\\quad\\text{for }0\\leq S\\leq\\frac9{400}.\n\\]\nThe same strict total-variance comparison holds for average-only calibration.\n\\end{theorem}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:strict-interior-counterexample",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "transcript",
        "average"
      ],
      "revision": "sha256:636c1150f4da72acb9f277996c4c41540d68c084dec5f7ed60943e53072b1d8b"
    },
    {
      "id": "thm:smallbatch",
      "statement": "\\begin{theorem}[Sparse transcript calibration]\\label{thm:smallbatch}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon\\geq0$, and\n\\begin{equation}\\label{eq:interior}\n 0<\\delta<1-e^{-E}.\n\\end{equation}\nThen, along integer horizons,\n\\[\n \\frac\\Delta{\\sigma_{E,T}}-\\sqrt{2\\log T}\n \\longrightarrow s_{E,\\delta}:=\n \\Phi^{-1}\\!\\left(-\\frac{\\log(1-\\delta)}E\\right).\n\\]\nConsequently,\n\\begin{align}\n \\sigma_{E,T}&\\sim\\frac\\Delta{\\sqrt{2\\log T}}\\longrightarrow0,\n \\label{eq:sigmaasymptotic}\\\\\n v_{E,T}&\\sim\\frac{\\Delta^2T}{2E^2\\log T}\\longrightarrow\\infty,\n \\label{eq:privacydivergence}\\\\\n V_E(T,S)&\\sim v_{E,T}\\qquad\\text{for each fixed }S\\geq0.\n \\label{eq:total-equivalent}\n\\end{align}\n\\end{theorem}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:smallbatch",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "offset",
        "leading"
      ],
      "revision": "sha256:bf37f1efcf293770fba61f4b50f99a8a32d5f0425b9db71bb59e3c760afb9ec0"
    },
    {
      "id": "cor:eventual",
      "statement": "\\begin{corollary}[One cutoff for all energies]\\label{cor:eventual}\nUnder the hypotheses of Theorem~\\ref{thm:smallbatch}, some integer $T_0>E$\nsatisfies $V_E(E,S)<V_E(T,S)$ for every $T\\geq T_0$ and every $S\\geq0$.\n\\end{corollary}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#cor:eventual",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "uniform"
      ],
      "revision": "sha256:02f2bb6625d667b7dfca660d192372461093817fd1043929ee8cafc091e082e3"
    },
    {
      "id": "prop:average-uniform-bound",
      "statement": "\\begin{proposition}[Average-only calibration stays bounded]\\label{prop:average-uniform-bound}\nFor integers $T\\geq E>0$, $\\Delta>0$, $\\varepsilon\\geq0$, and $0<\\delta<1$,\n\\[\n \\overline v_{E,T}\\leq\\frac{\\Delta^2}{2\\pi\\delta^2},\\qquad\n \\overline V_E(T,S)\\leq\\frac SE+\\frac{\\Delta^2}{2\\pi\\delta^2}\\quad(S\\geq0).\n\\]\n\\end{proposition}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#prop:average-uniform-bound",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "bound"
      ],
      "revision": "sha256:98adfc1f05587ac23d55fa2bf1c0f1ee6c92d060f48da7fe21e2cb76381d8fe5"
    },
    {
      "id": "thm:rate-adaptive-center",
      "statement": "\\begin{theorem}[The binomial center comparison]\\label{thm:rate-adaptive-center}\nLet $T>E>0$ be integers and $h>0$. Then\n$\\Gamma_{E,T}(\\theta,h)>0$ under the following conditions:\n\\begin{equation}\\label{eq:rate-adaptive-center-condition}\n \\begin{array}{c|c}\n T>2E & \\theta\\geq c_{E,T}:=(1-2E/T)/3,\\\\\n T=2E & \\theta>0,\\\\\n E<T<2E & \\theta\\geq0.\n \\end{array}\n\\end{equation}\nAt $T=2E$ and $\\theta=0$, the gap is zero.\n\\end{theorem}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-center",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "positive",
        "zero"
      ],
      "revision": "sha256:5ec94143a489a958a3ff42a4e23ff1db84712481f7f73c79fe7f84f17294fd47"
    },
    {
      "id": "lem:binomial-propagation",
      "statement": "\\begin{lemma}[Propagation of positivity]\\label{lem:binomial-propagation}\nFix $h>0$ and $0\\leq\\theta_1<\\theta_2$. If\n$\\Gamma_{E,T}(\\theta_1,h)\\geq0$, then\n$\\Gamma_{E,T}(\\theta_2,h)>0$.\n\\end{lemma}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:binomial-propagation",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "propagation"
      ],
      "revision": "sha256:b3cf99cfd36ca744273387be6f9ad774877318e0722087c00299943dc1ca3b18"
    },
    {
      "id": "lem:binomial-stein-polynomial",
      "statement": "\\begin{lemma}[A binomial telescoping identity]\\label{lem:binomial-stein-polynomial}\nPut $C=T-E$. For any real $R$, define\n\\[\n A_R(z)=R^2-2Er-3c^2+z-z^2.\n\\]\nThen for every $z\\in\\R$,\n\\begin{equation}\\label{eq:binomial-cubic-stein-polynomial}\n \\begin{split}\n &(z-c)\\{R^2-(z-c)^2\\}+c(R^2-c^2)\\\\\n &\\hspace{2em}=r(E+z)A_R(z)-p(C-z)A_R(z+1).\n \\end{split}\n\\end{equation}\n\\end{lemma}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:binomial-stein-polynomial",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "polynomial"
      ],
      "revision": "sha256:74340e6f05c8612f26cb6e759f87be49a49c86622aa0301e5d3cd8a0d2ae4579"
    },
    {
      "id": "lem:binomial-double-cumulative",
      "statement": "\\begin{lemma}[Nonnegativity of the hinge transform]\n\\label{lem:binomial-double-cumulative}\nIf $T>2E$, then $J(t)\\geq0$ for every $t\\geq0$, and\n$J((1-c)^2)>0$.\n\\end{lemma}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:binomial-double-cumulative",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "hinge",
        "strict"
      ],
      "revision": "sha256:1dc10cffe6bd81b1f5eda04b3211d97f132de164f36240d163c205066a7f5230"
    },
    {
      "id": "lem:binomial-reflected-zero",
      "statement": "\\begin{lemma}[The zero-center sign]\\label{lem:binomial-reflected-zero}\nFor $h>0$, the gap $\\Gamma_{E,T}(0,h)$ is negative when $T>2E$, zero when\n$T=2E$, and positive when $E<T<2E$.\n\\end{lemma}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:binomial-reflected-zero",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "signs"
      ],
      "revision": "sha256:a3c763d3a071e862ca9b15d046478e505e83ddf62a2e2382c59b4496fabcb4ee"
    },
    {
      "id": "lem:strict-average-endpoint",
      "statement": "\\begin{lemma}[Improving the threshold at half rate]\\label{lem:strict-average-endpoint}\nLet $E\\in\\N_{>0}$, $a>0$, and $K\\sim\\operatorname{Binomial}(2E,1/2)$.\nLet $Q=\\Normal(0,1)$, and let $P$ be the mixture whose conditional law\ngiven $K=k$ is $\\Normal(ak/E,1)$. With $\\varepsilon=a^2/2$,\n\\[\n H_{e^\\varepsilon}(P, Q)\n >\\frac12-e^\\varepsilon\\overline\\Phi(a).\n\\]\n\\end{lemma}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:strict-average-endpoint",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "endpoint"
      ],
      "revision": "sha256:fabcf8ace9c947fe34509115ca2734694b3ca4c45b7026dd09e647e2d9d4300c"
    },
    {
      "id": "thm:accountant-limit",
      "statement": "\\begin{theorem}[The fixed-participation profile limit]\\label{thm:accountant-limit}\nLet $\\rho>0$, $\\Delta>0$, and $\\varepsilon\\geq0$. Suppose\n$q_T\\in[0,1]$, $Tq_T\\to\\rho$, $\\sigma_T>0$ eventually, and\n\\[\n \\frac{\\Delta}{\\sigma_T}-\\sqrt{2\\log T}\\longrightarrow s\\in\\R.\n\\]\nThen\n\\[\n \\AO_S(\\sigma_T,\\Delta,q_T,T,\\varepsilon)\n \\longrightarrow1-\\exp\\{-\\rho\\Phi(s)\\}.\n\\]\n\\end{theorem}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:accountant-limit",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "profile"
      ],
      "revision": "sha256:fa568c1b36e683ed12deb097a7cac602850a9680a928ce3b36e1b9d2b53dfe5d"
    },
    {
      "id": "thm:fixed-participation-calibration",
      "statement": "\\begin{theorem}[Fixed-participation calibration]\n\\label{thm:fixed-participation-calibration}\nLet $\\rho>0$, $\\Delta>0$, $\\varepsilon\\geq0$, and\n$0<\\delta<1-e^{-\\rho}$. Suppose $q_T\\in[0,1]$ and $Tq_T\\to\\rho$, and define\n\\[\n \\sigma_T^{\\mathrm{cal}}:=\\inf\\left\\{\\sigma\\geq0:\n \\AO_S(\\sigma,\\Delta,q_T,T,\\varepsilon)\\leq\\delta\\right\\}.\n\\]\nThen $\\sigma_T^{\\mathrm{cal}}>0$ eventually, and\n\\[\n \\frac{\\Delta}{\\sigma_T^{\\mathrm{cal}}}-\\sqrt{2\\log T}\n \\longrightarrow s_{\\rho,\\delta}:=\n \\Phi^{-1}\\!\\left(-\\frac{\\log(1-\\delta)}\\rho\\right).\n\\]\nFor the capped exact-budget schedule $q_T=\\min\\{1,\\rho/T\\}$, it follows that\n\\[\n \\frac{\\sigma_T^{\\mathrm{cal}}\\sqrt{2\\log(1/q_T)}}\\Delta\\longrightarrow1.\n\\]\n\\end{theorem}",
      "document": {
        "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:fixed-participation-calibration",
        "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
      },
      "components": [
        "offset",
        "capped",
        "positive"
      ],
      "revision": "sha256:29a94d4c6ed0af007291954680e81c57324c961be2adf9298233ef2e8a1240e0"
    }
  ],
