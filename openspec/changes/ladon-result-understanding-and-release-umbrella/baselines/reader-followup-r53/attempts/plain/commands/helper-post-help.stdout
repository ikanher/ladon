usage: ultra_code_bb.py post [-h] --db DB --author AUTHOR --role
                             {root,test_author,documentation_scout,falsifier,implementer,auditor,other}
                             [--recipient RECIPIENT] --topic TOPIC --kind
                             {contract,finding,question,answer,test,implementation,review,status}
                             [--state {proposed,frozen,accepted,refuted,blocked,info}]
                             (--body BODY | --body-file BODY_FILE | --body-stdin)
                             [--ref REF] [--tag TAG] [--reply-to REPLY_TO]
                             [--supersedes SUPERSEDES]

options:
  -h, --help            show this help message and exit
  --db DB
  --author AUTHOR
  --role {root,test_author,documentation_scout,falsifier,implementer,auditor,other}
  --recipient RECIPIENT
  --topic TOPIC
  --kind {contract,finding,question,answer,test,implementation,review,status}
  --state {proposed,frozen,accepted,refuted,blocked,info}
  --body BODY
  --body-file BODY_FILE
  --body-stdin
  --ref REF
  --tag TAG
  --reply-to REPLY_TO
  --supersedes SUPERSEDES
