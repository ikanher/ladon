usage: ultra_code_bb.py read [-h] --db DB [--since SINCE] [--topic TOPIC]
                             [--recipient RECIPIENT] [--tag TAG]
                             [--in-reply-to IN_REPLY_TO] [--limit LIMIT]
                             [--format {human,jsonl}]
                             [--color {auto,always,never}]

options:
  -h, --help            show this help message and exit
  --db DB
  --since SINCE
  --topic TOPIC
  --recipient RECIPIENT
  --tag TAG
  --in-reply-to IN_REPLY_TO
                        show only direct replies to this post ID
  --limit LIMIT
  --format {human,jsonl}
  --color {auto,always,never}
