 point h query', {'path': 'Mf/DP/PoissonFixedEpochCenterGapPropagation.lean', 'digest': 'sha256:7c8705d47510f00dab5076c09172b9748c07622d8381a49f09fa7adfdadc97c0', 'projectRevision': 'capture-state:sha256:a2d0b570f9b5d479619abb83cc559b878fd5a39918601c7e3f34187679a88ef5'}), ('polynomial', 'Mf.DP.binomialSkewBoundary_boundarySteinPolynomial_identity', '∀ (epoch complement : ℕ),\n  0 < epoch + complement →\n    ∀ (radius centered : ℝ),\n      have total := ↑epoch + ↑complement;\n      have rate := ↑epoch / total;\n      have complementRate := ↑complement / total;\n      have boundary := (↑complement - ↑epoch) / (3 * total);\n      have steinPotential := fun value =>\n        radius ^ 2 - 2 * ↑epoch * complementRate - 3 * boundary ^ 2 + value - value ^ 2;\n      (centered - boundary) * ((centered - boundary) ^ 2 - radius ^ 2) - boundary * (radius ^ 2 - boundary ^ 2) =\n        rate * (↑complement - centered) * steinPotential (centered + 1) -\n          complementRate * (↑epoch + centered) * steinPotential centered', {'path': 'Mf/DP/PoissonFixedEpochBinomialSkewBoundary.lean', 'digest': 'sha256:8e78ca9846b6f614ac3fbac802fc8ed7cd1bfb7329d7faed0dfed216469528b9', 'projectRevision': 'capture-state:sha256:fbada67f54a8105fb1f19ebef27b2b8dd986bff6a8d8b0603d92febee3a8cd2f'}), ('hinge-nonnegative', 'Mf.DP.binomialSkewBoundary_boundaryDoubleCumulative_nonneg', '∀ (epoch complement : ℕ),\n  0 < epoch →\n    epoch ≤ complement →\n      ∀ (radius : ℝ), 0 ≤ radius → 0 ≤ Mf.DP.binomialSkewBoundary_boundaryDoubleCumulative epoch complement radius', {'path': 'Mf/DP/PoissonFixedEpochBoundaryDoubleCumulative.lean', 'digest': 'sha256:28069941382e5544fe697582567eb1c2ec83707b8337b7adf93456a95989d0c2', 'projectRevision': 'capture-state:sha256:948e0ac2a4245e2c6215beb7ed65352f301ff8fdbfaffadda6e01881a57af221'}), ('hinge-positive', 'Mf.DP.FixedEpochBoundarySignedLaplace.boundaryDoubleCumulative_firstPositiveKnot_pos', '∀ (epoch complement : ℕ),\n  0 < epoch →\n    epoch < complement →\n      have 