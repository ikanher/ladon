### Mf/DP/PoissonFixedEpochEpochUniformDomain.lean
import Mf.DP.PoissonFixedEpochSkewBoundaryTrace
import Mf.DP.PoissonFixedEpochThresholdPoissonMargin
import Mf.DP.PoissonFixedEpochTraceDominance

/-!
# Fixed-epoch all-horizon dominance domain

For each positive expected epoch budget `E`, this module exposes the exact
finite-horizon-uniform coefficient `6 E / (3 E + 2)`.  The smaller universal
constant `6 / 5` is only the infimum of these coefficients over all epoch
budgets; it is not the organizing theorem here.
-/

namespace Mf.DP

open scoped BigOperators

noncomputable section

set_option autoImplicit false

/-- At exact full-batch calibration, the fixed-epoch coefficient supplies the
strict threshold-trace comparison at every finite non-full horizon. -/
theorem
    poissonFixedEpochThresholdTail_calibrated_lt_traceAverage_of_epochUniformSignal
    (point : PoissonFixedEpochPoint)
    (sensitivity epsilon delta : Real)
    (hNonFull : point.epoch < point.horizon)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1)
    (hSignalSq :
      poissonFixedEpochStandardizedSignal sensitivity
          (poissonFixedEpochFullBatchCalibratedRunVariance
            sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos
              hDeltaLtOne) ^ 2 ≤
        poissonFixedEpochEpochUniformSignalSquareFactor point.epoch * epsilon) :
    poissonFixedEpochThresholdTail sensitivity epsilon
        (poissonFixedEpochFullBatchCalibratedRunVariance
          sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne) 1 <
      ∑ trace : ParticipationTrace point.horizon,
        poissonTraceProb (point.samplingRate : Real) trace *
          poissonFixedEpochThresholdTail sensitivity epsilon
            (poissonFixedEpochFullBatchCalibratedRunVariance
              sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne)
            (poissonFixedEpochNormalizedTraceCount point trace) := by
  let runVariance := poissonFixedEpochFullBatchCalibratedRunVariance
    sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne
  let signalReal := poissonFixedEpochStandardizedSignal sensitivity runVariance
  let signal : NNReal := Real.toNNReal signalReal
  let centerDistance :=
    poissonFixedEpochPositiveCenterDistance epsilon signalReal
  have hRunVariance : 0 < runVariance :=
    poissonFixedEpochFullBatchCalibratedRunVariance_pos sensitivity epsilon delta
      hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne
  have hSignalReal : 0 < signalReal := by
    dsimp [signalReal, poissonFixedEpochStandardizedSignal]
    exact div_pos hSensitivity (Real.sqrt_pos.2 hRunVariance)
  have hSignal : 0 < signal := by
    dsimp [signal]
    exact Real.toNNReal_pos.mpr hSignalReal
  have hSignalCoe : (signal : Real) = signalReal :=
    Real.coe_toNNReal _ hSignalReal.le
  have hSignalSq' :
      (signal : Real) ^ 2 ≤
        poissonFixedEpochEpochUniformSignalSquareFactor point.epoch * epsilon := by
    simpa [hSignalCoe, signalReal, runVariance] using hSignalSq
  have hTrace :=
    stdNormalCDFReal_lt_fixedEpochGaussianTraceAverage_of_epochUniformSignalFactor_le
      point epsilon signal hNonFull hSignal hSignalSq'
  have hCount (count : Nat) :
      fixedEpochGaussianCountTest point (-centerDistance) signal count =
        poissonFixedEpochThresholdTail sensitivity epsilon runVariance
          ((count : Real) / point.epoch) := by
    have hRaw :=
      fixedEpochGaussianCountTest_eq_poissonFixedEpochThresholdTail
        point sensitivity epsilon runVariance hRunVariance hSensitivity count
    simpa [signal, signalReal, centerDistance,
      poissonFixedEpochPositiveCenterDistance] using hRaw
  have hAtEpoch :
      stdNormalCDFReal (-centerDistance) =
        poissonFixedEpochThresholdTail sensitivity epsilon runVariance 1 := by
    rw [← fixedEpochGaussianCountTest_at_epoch point (-centerDistance) signal,
      hCount]
    congr 1
    field_simp [point.epoch_pos.ne']
  have hTrace' :
      stdNormalCDFReal (-centerDistance) <
        poissonTraceCountAverage point.horizon point.samplingRate
          (fixedEpochGaussianCountTest point (-centerDistance) signal) := by
    simpa [centerDistance, hSignalCoe] using hTrace
  rw [hAtEpoch] at hTrace'
  unfold poissonTraceCountAverage at hTrace'
  simpa only [hCount, poissonFixedEpochNormalizedTraceCount, runVariance] using hTrace'

/-- Product-accountant dominance under the fixed-epoch, all-horizon signal
factor. -/
theorem
    poissonFixedEpoch_productProfile_calibratedRunVariance_gt_of_epochUniformSignal
    (point : PoissonFixedEpochPoint)
    (sensitivity epsilon delta : Real)
    (hNonFull : point.epoch < point.horizon)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1)
    (hSignalSq :
      poissonFixedEpochStandardizedSignal sensitivity
          (poissonFixedEpochFullBatchCalibratedRunVariance
            sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos
              hDeltaLtOne) ^ 2 ≤
        poissonFixedEpochEpochUniformSignalSquareFactor point.epoch * epsilon) :
    ENNReal.ofReal delta <
      binaryAccountingProfile
        (sampledGaussianSourceProductLaw point.horizon point.samplingRate
          point.samplingRate_le_one sensitivity
          (poissonFixedEpochRawNoiseVariance point
            (poissonFixedEpochFullBatchCalibratedRunVariance sensitivity epsilon delta
              hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne)))
        (sampledGaussianReferenceProductLaw point.horizon
          (poissonFixedEpochRawNoiseVariance point
            (poissonFixedEpochFullBatchCalibratedRunVariance sensitivity epsilon delta
              hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne))) epsilon := by
  apply poissonFixedEpoch_productProfile_calibratedRunVariance_gt_of_traceGap
    point sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne
  exact
    poissonFixedEpochThresholdTail_calibrated_lt_traceAverage_of_epochUniformSignal
      point sensitivity epsilon delta hNonFull hSensitivity hEpsilon hDeltaPos
        hDeltaLtOne hSignalSq

/-- Calibrated run-level privacy variance is strictly larger at every finite
non-full horizon under the fixed-epoch factor. -/
theorem
    poissonFixedEpochCalibratedPrivacyVariance_gt_fullBatch_of_epochUniformSignal
    (point : PoissonFixedEpochPoint)
    (sensitivity epsilon delta : Real)
    (hNonFull : point.epoch < point.horizon)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1)
    (hSignalSq :
      poissonFixedEpochStandardizedSignal sensitivity
          (poissonFixedEpochFullBatchCalibratedRunVariance
            sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos
              hDeltaLtOne) ^ 2 ≤
        poissonFixedEpochEpochUniformSignalSquareFactor point.epoch * epsilon) :
    (poissonFixedEpochFullBatchCalibratedRunVariance sensitivity epsilon delta
        hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne : Real) <
      poissonFixedEpochCalibratedPrivacyVariance point sensitivity epsilon delta := by
  apply poissonFixedEpochCalibratedPrivacyVariance_gt_fullBatch_of_traceGap
    point sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne
  exact
    poissonFixedEpochThresholdTail_calibrated_lt_traceAverage_of_epochUniformSignal
      point sensitivity epsilon delta hNonFull hSensitivity hEpsilon hDeltaPos
        hDeltaLtOne hSignalSq

/-- Full batch has strictly smaller frozen-average total variance at every
finite non-full horizon and every nonnegative energy. -/
theorem
    poissonFixedEpochTotalAverageVariance_fullBatch_lt_allEnergy_of_epochUniformSignal
    (point : PoissonFixedEpochPoint)
    (sensitivity epsilon delta energy : Real)
    (hNonFull : point.epoch < point.horizon)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1)
    (hEnergy : 0 ≤ energy)
    (hSignalSq :
      poissonFixedEpochStandardizedSignal sensitivity
          (poissonFixedEpochFullBatchCalibratedRunVariance
            sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos
              hDeltaLtOne) ^ 2 ≤
        poissonFixedEpochEpochUniformSignalSquareFactor point.epoch * epsilon) :
    poissonFixedEpochTotalAverageVariance
        (PoissonFixedEpochPoint.fullBatch point.epoch point.epoch_pos)
        sensitivity epsilon delta energy <
      poissonFixedEpochTotalAverageVariance point sensitivity epsilon delta energy := by
  apply poissonFixedEpochTotalAverageVariance_fullBatch_lt_allEnergy_of_traceGap
    point sensitivity epsilon delta energy hSensitivity hEpsilon.le hDeltaPos
      hDeltaLtOne hEnergy
  exact
    poissonFixedEpochThresholdTail_calibrated_lt_traceAverage_of_epochUniformSignal
      point sensitivity epsilon delta hNonFull hSensitivity hEpsilon hDeltaPos
        hDeltaLtOne hSignalSq

/-- Gaussian-profile boundary corresponding to the exact fixed-epoch,
all-horizon coefficient `6 E / (3 E + 2)`. -/
def poissonFixedEpochEpochUniformDeltaThreshold
    (epoch : Nat) (epsilon : Real) : Real :=
  gdpProfile
    (Real.sqrt
      (poissonFixedEpochEpochUniformSignalSquareFactor epoch * epsilon))
    epsilon

/-- Exact equivalence between the fixed-epoch delta threshold and the
calibrated full-batch signal-square condition. -/
theorem
    poissonFixedEpochDelta_le_epochUniformThreshold_iff_fullBatchCalibratedSignal_sq_le
    (epoch : Nat) (sensitivity epsilon delta : Real)
    (hEpoch : 0 < epoch)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1) :
    delta ≤ poissonFixedEpochEpochUniformDeltaThreshold epoch epsilon ↔
      poissonFixedEpochStandardizedSignal sensitivity
            (poissonFixedEpochFullBatchCalibratedRunVariance
              sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos
                hDeltaLtOne) ^ 2 ≤
          poissonFixedEpochEpochUniformSignalSquareFactor epoch * epsilon := by
  let runVariance := poissonFixedEpochFullBatchCalibratedRunVariance
    sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne
  let signal := poissonFixedEpochStandardizedSignal sensitivity runVariance
  let factor := poissonFixedEpochEpochUniformSignalSquareFactor epoch
  let boundary := Real.sqrt (factor * epsilon)
  have hRunVariance : 0 < runVariance :=
    poissonFixedEpochFullBatchCalibratedRunVariance_pos sensitivity epsilon delta
      hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne
  have hSignal : 0 < signal := by
    dsimp [signal, poissonFixedEpochStandardizedSignal]
    exact div_pos hSensitivity (Real.sqrt_pos.2 hRunVariance)
  have hFactor : 0 < factor := by
    dsimp [factor, poissonFixedEpochEpochUniformSignalSquareFactor]
    have hEpochReal : (0 : Real) < epoch := by exact_mod_cast hEpoch
    positivity
  have hBoundary : 0 < boundary := by
    dsimp [boundary]
    exact Real.sqrt_pos.2 (mul_pos hFactor hEpsilon)
  have hBoundarySq : boundary ^ 2 = factor * epsilon := by
    dsimp [boundary]
    exact Real.sq_sqrt (mul_pos hFactor hEpsilon).le
  have hCalibratedProfile : gdpProfile signal epsilon = delta := by
    have hEvent := poissonFixedEpochFullBatchThreshold_eventValue_calibrated_eq
      sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne
    have hGDP := poissonFixedEpochFullBatchThreshold_eventValue_eq_gdpProfile
      sensitivity epsilon runVariance hSignal.ne'
    exact hGDP.symm.trans hEvent
  have hProfileIff := (Training.gdpProfile_strictMonoOn_pos epsilon).le_iff_le
    hSignal hBoundary
  change delta ≤ gdpProfile boundary epsilon ↔ signal ^ 2 ≤ factor * epsilon
  rw [← hCalibratedProfile, hProfileIff]
  constructor
  · intro h
    nlinarith [sq_nonneg (boundary - signal)]
  · intro h
    nlinarith [sq_nonneg (boundary - signal)]

/-- Delta-coordinate product-accountant consumer at the fixed-epoch
all-horizon boundary. -/
theorem
    poissonFixedEpoch_productProfile_calibratedRunVariance_gt_of_delta_le_epochUniformThreshold
    (point : PoissonFixedEpochPoint)
    (sensitivity epsilon delta : Real)
    (hNonFull : point.epoch < point.horizon)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1)
    (hDeltaThreshold :
      delta ≤ poissonFixedEpochEpochUniformDeltaThreshold point.epoch epsilon) :
    ENNReal.ofReal delta <
      binaryAccountingProfile
        (sampledGaussianSourceProductLaw point.horizon point.samplingRate
          point.samplingRate_le_one sensitivity
          (poissonFixedEpochRawNoiseVariance point
            (poissonFixedEpochFullBatchCalibratedRunVariance sensitivity epsilon delta
              hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne)))
        (sampledGaussianReferenceProductLaw point.horizon
          (poissonFixedEpochRawNoiseVariance point
            (poissonFixedEpochFullBatchCalibratedRunVariance sensitivity epsilon delta
              hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne))) epsilon := by
  apply
    poissonFixedEpoch_productProfile_calibratedRunVariance_gt_of_epochUniformSignal
      point sensitivity epsilon delta hNonFull hSensitivity hEpsilon hDeltaPos
        hDeltaLtOne
  exact
    (poissonFixedEpochDelta_le_epochUniformThreshold_iff_fullBatchCalibratedSignal_sq_le
      point.epoch sensitivity epsilon delta point.epoch_pos hSensitivity hEpsilon
        hDeltaPos hDeltaLtOne).1 hDeltaThreshold

/-- Delta-coordinate calibrated privacy-variance consumer. -/
theorem
    poissonFixedEpochCalibratedPrivacyVariance_gt_fullBatch_of_delta_le_epochUniformThreshold
    (point : PoissonFixedEpochPoint)
    (sensitivity epsilon delta : Real)
    (hNonFull : point.epoch < point.horizon)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1)
    (hDeltaThreshold :
      delta ≤ poissonFixedEpochEpochUniformDeltaThreshold point.epoch epsilon) :
    (poissonFixedEpochFullBatchCalibratedRunVariance sensitivity epsilon delta
        hSensitivity hEpsilon.le hDeltaPos hDeltaLtOne : Real) <
      poissonFixedEpochCalibratedPrivacyVariance point sensitivity epsilon delta := by
  apply
    poissonFixedEpochCalibratedPrivacyVariance_gt_fullBatch_of_epochUniformSignal
      point sensitivity epsilon delta hNonFull hSensitivity hEpsilon hDeltaPos
        hDeltaLtOne
  exact
    (poissonFixedEpochDelta_le_epochUniformThreshold_iff_fullBatchCalibratedSignal_sq_le
      point.epoch sensitivity epsilon delta point.epoch_pos hSensitivity hEpsilon
        hDeltaPos hDeltaLtOne).1 hDeltaThreshold

/-- Delta-coordinate all-energy total-variance consumer. -/
theorem
    poissonFixedEpochTotalAverageVariance_fullBatch_lt_allEnergy_of_delta_le_epochUniformThreshold
    (point : PoissonFixedEpochPoint)
    (sensitivity epsilon delta energy : Real)
    (hNonFull : point.epoch < point.horizon)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1)
    (hEnergy : 0 ≤ energy)
    (hDeltaThreshold :
      delta ≤ poissonFixedEpochEpochUniformDeltaThreshold point.epoch epsilon) :
    poissonFixedEpochTotalAverageVariance
        (PoissonFixedEpochPoint.fullBatch point.epoch point.epoch_pos)
        sensitivity epsilon delta energy <
      poissonFixedEpochTotalAverageVariance point sensitivity epsilon delta energy := by
  apply
    poissonFixedEpochTotalAverageVariance_fullBatch_lt_allEnergy_of_epochUniformSignal
      point sensitivity epsilon delta energy hNonFull hSensitivity hEpsilon
        hDeltaPos hDeltaLtOne hEnergy
  exact
    (poissonFixedEpochDelta_le_epochUniformThreshold_iff_fullBatchCalibratedSignal_sq_le
      point.epoch sensitivity epsilon delta point.epoch_pos hSensitivity hEpsilon
        hDeltaPos hDeltaLtOne).1 hDeltaThreshold

/-- Literal fixed-epoch, all-horizon consumer.  One delta-threshold hypothesis
simultaneously yields calibrated privacy-variance and all-energy total-variance
dominance at every finite non-full horizon with the selected epoch budget. -/
theorem
    poissonFixedEpoch_allHorizon_dominance_of_delta_le_epochUniformThreshold
    (epoch : Nat) (sensitivity epsilon delta : Real)
    (hEpoch : 0 < epoch)
    (hSensitivity : 0 < sensitivity) (hEpsilon : 0 < epsilon)
    (hDeltaPos : 0 < delta) (hDeltaLtOne : delta < 1)
    (hDeltaThreshold :
      delta ≤ poissonFixedEpochEpochUniformDeltaThreshold epoch epsilon) :
    ∀ point : PoissonFixedEpochPoint,
      point.epoch = epoch → point.epoch < point.horizon →
        ((poissonFixedEpochFullBatchCalibratedRunVariance
              sensitivity epsilon delta hSensitivity hEpsilon.le hDeltaPos
                hDeltaLtOne : Real) <
            poissonFixedEpochCalibratedPrivacyVariance
              point sensitivity epsilon delta ∧
          ∀ energy : Real, 0 ≤ energy →
            poissonFixedEpochTotalAverageVariance
                (PoissonFixedEpochPoint.fullBatch epoch hEpoch)
                sensitivity epsilon delta energy <
              poissonFixedEpochTotalAverageVariance
                point sensitivity epsilon delta energy) := by
  intro point hPointEpoch hNonFull
  subst epoch
  constructor
  · exact
      poissonFixedEpochCalibratedPrivacyVariance_gt_fullBatch_of_delta_le_epochUniformThreshold
        point sensitivity epsilon delta hNonFull hSensitivity hEpsilon hDeltaPos
          hDeltaLtOne hDeltaThreshold
  · intro energy hEnergy
    simpa only using
      poissonFixedEpochTotalAverageVariance_fullBatch_lt_allEnergy_of_delta_le_epochUniformThreshold
        point sensitivity epsilon delta energy hNonFull hSensitivity hEpsilon
          hDeltaPos hDeltaLtOne hEnergy hDeltaThreshold

end

end Mf.DP
### Mf/DP/PoissonFixedEpochCenterGapPropagation.lean
import Mf.DP.PoissonFixedEpochTraceSignalInterpolation
import Mf.Probability.StandardGaussianTailBounds
import Mathlib.Analysis.Convex.Slope

/-!
# Fixed-center propagation for finite Poisson-participation traces

For a fixed positive Gaussian signal scale, this module studies the gap
between the exact finite participation-count average and its value at the
deterministic mean.  An exponential tilt controls the center derivative.
Strict convexity of that tilt, its strict deficit at zero, and the vanishing
right-center limit show that a nonnegative gap at one nonnegative boundary
propagates to a strict gap at every larger center.
-/

open Filter Set
open scoped BigOperators Topology

noncomputable section

set_option autoImplicit false

namespace Mf.DP

/-- Fixed-`h` center gap for the exact finite participation trace. -/
def fixedEpochCenterGap
    (point : PoissonFixedEpochPoint) (h theta : ℝ) : ℝ :=
  ∑ trace : ParticipationTrace point.horizon,
      poissonTraceProb (point.samplingRate : ℝ) trace *
        stdNormalCDFReal
          (h * ((participationCount trace : ℝ) - point.epoch - theta)) -
    stdNormalCDFReal (-h * theta)

/-- Exponential tilt controlling the sign of the center derivative. -/
def fixedEpochCenterTilt
    (point : PoissonFixedEpochPoint) (h theta : ℝ) : ℝ :=
  ∑ trace : ParticipationTrace point.horizon,
    poissonTraceProb (point.samplingRate : ℝ) trace *
      Real.exp
        ((h ^ 2 * ((participationCount trace : ℝ) - point.epoch)) * theta -
          h ^ 2 * ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2)

def fixedEpochCenterTiltDerivative
    (point : PoissonFixedEpochPoint) (h theta : ℝ) : ℝ :=
  ∑ trace : ParticipationTrace point.horizon,
    poissonTraceProb (point.samplingRate : ℝ) trace *
      (h ^ 2 * ((participationCount trace : ℝ) - point.epoch)) *
      Real.exp
        ((h ^ 2 * ((participationCount trace : ℝ) - point.epoch)) * theta -
          h ^ 2 * ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2)

def fixedEpochCenterTiltSecond
    (point : PoissonFixedEpochPoint) (h theta : ℝ) : ℝ :=
  ∑ trace : ParticipationTrace point.horizon,
    poissonTraceProb (point.samplingRate : ℝ) trace *
      (h ^ 2 * ((participationCount trace : ℝ) - point.epoch)) ^ 2 *
      Real.exp
        ((h ^ 2 * ((participationCount trace : ℝ) - point.epoch)) * theta -
          h ^ 2 * ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2)

/-- Exact finite differentiation of the center gap. -/
theorem hasDerivAt_fixedEpochCenterGap
    (point : PoissonFixedEpochPoint) (h theta : ℝ) :
    HasDerivAt (fixedEpochCenterGap point h)
      (h * stdNormalPdfReal (h * theta) *
        (1 - fixedEpochCenterTilt point h theta)) theta := by
  have hSum : HasDerivAt
      (fun current : ℝ =>
        ∑ trace : ParticipationTrace point.horizon,
          poissonTraceProb (point.samplingRate : ℝ) trace *
            stdNormalCDFReal
              (h * ((participationCount trace : ℝ) - point.epoch - current)))
      (∑ trace : ParticipationTrace point.horizon,
        poissonTraceProb (point.samplingRate : ℝ) trace *
          (-h * stdNormalPdfReal
            (h * ((participationCount trace : ℝ) - point.epoch - theta)))) theta := by
    apply HasDerivAt.fun_sum
    intro trace _htrace
    have hArgument : HasDerivAt
        (fun current : ℝ =>
          h * ((participationCount trace : ℝ) - point.epoch - current))
        (-h) theta := by
      have hRaw := ((hasDerivAt_const theta
        ((participationCount trace : ℝ) - point.epoch)).sub
          (hasDerivAt_id' theta)).const_mul h
      convert hRaw using 1
      all_goals first | rfl | ring
    have hCdf := (hasDerivAt_stdNormalCDFReal
      (h * ((participationCount trace : ℝ) - point.epoch - theta))).comp
        theta hArgument
    have hWeighted := hCdf.const_mul
      (poissonTraceProb (point.samplingRate : ℝ) trace)
    convert hWeighted using 1
    all_goals first | rfl | ring
  have hBase : HasDerivAt (fun current : ℝ => stdNormalCDFReal (-h * current))
      (-h * stdNormalPdfReal (h * theta)) theta := by
    have hArgument : HasDerivAt (fun current : ℝ => -h * current) (-h) theta := by
      convert (hasDerivAt_id' theta).const_mul (-h) using 1
      all_goals first | rfl | ring
    have hCdf := (hasDerivAt_stdNormalCDFReal (-h * theta)).comp theta hArgument
    convert hCdf using 1
    all_goals first | rfl | (rw [show -h * theta = -(h * theta) by ring,
      stdNormalPdfReal_neg]; ring)
  have hRaw := hSum.sub hBase
  have hFunction : fixedEpochCenterGap point h =
      (fun current : ℝ =>
        ∑ trace : ParticipationTrace point.horizon,
          poissonTraceProb (point.samplingRate : ℝ) trace *
            stdNormalCDFReal
              (h * ((participationCount trace : ℝ) - point.epoch - current))) -
        fun current : ℝ => stdNormalCDFReal (-h * current) := by
    rfl
  rw [hFunction]
  have hSumFactor : (∑ trace : ParticipationTrace point.horizon,
      poissonTraceProb (point.samplingRate : ℝ) trace *
        (-h * stdNormalPdfReal
          (h * ((participationCount trace : ℝ) - point.epoch - theta)))) =
    -h * stdNormalPdfReal (h * theta) *
      fixedEpochCenterTilt point h theta := by
      unfold fixedEpochCenterTilt
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro trace _
      rw [show
        h * ((participationCount trace : ℝ) - point.epoch - theta) =
          -(h * theta) + h *
            ((participationCount trace : ℝ) - point.epoch) by ring]
      rw [stdNormalPdfReal_displacement_factor]
      rw [show
        h * theta *
              (h * ((participationCount trace : ℝ) - point.epoch)) -
            (h * ((participationCount trace : ℝ) - point.epoch)) ^ 2 / 2 =
          (h ^ 2 * ((participationCount trace : ℝ) - point.epoch)) * theta -
            h ^ 2 * ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2 by ring]
      ring
  rw [hSumFactor] at hRaw
  have hDerivative :
      -h * stdNormalPdfReal (h * theta) * fixedEpochCenterTilt point h theta -
          -h * stdNormalPdfReal (h * theta) =
        h * stdNormalPdfReal (h * theta) *
          (1 - fixedEpochCenterTilt point h theta) := by
    ring
  rw [hDerivative] at hRaw
  exact hRaw

/-- First derivative of the exponential tilt. -/
theorem hasDerivAt_fixedEpochCenterTilt
    (point : PoissonFixedEpochPoint) (h theta : ℝ) :
    HasDerivAt (fixedEpochCenterTilt point h)
      (fixedEpochCenterTiltDerivative point h theta) theta := by
  unfold fixedEpochCenterTilt
  unfold fixedEpochCenterTiltDerivative
  apply HasDerivAt.fun_sum
  intro trace _htrace
  have hArg : HasDerivAt
      (fun current : ℝ =>
        (h ^ 2 * ((participationCount trace : ℝ) - point.epoch)) * current -
          h ^ 2 * ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2)
      (h ^ 2 * ((participationCount trace : ℝ) - point.epoch)) theta := by
    have hRaw := ((hasDerivAt_id' theta).const_mul
      (h ^ 2 * ((participationCount trace : ℝ) - point.epoch))).sub_const
        (h ^ 2 * ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2)
    simpa only [mul_one] using hRaw
  have hExp := (Real.hasDerivAt_exp _).comp theta hArg
  have hWeighted := hExp.const_mul
    (poissonTraceProb (point.samplingRate : ℝ) trace)
  convert hWeighted using 1
  all_goals first | rfl | ring

/-- Second derivative of the exponential tilt. -/
theorem hasDerivAt_fixedEpochCenterTiltDerivative
    (point : PoissonFixedEpochPoint) (h theta : ℝ) :
    HasDerivAt (fixedEpochCenterTiltDerivative point h)
      (fixedEpochCenterTiltSecond point h theta) theta := by
  unfold fixedEpochCenterTiltDerivative fixedEpochCenterTiltSecond
  apply HasDerivAt.fun_sum
  intro trace _htrace
  let coefficient : ℝ :=
    h ^ 2 * ((participationCount trace : ℝ) - point.epoch)
  let offset : ℝ :=
    h ^ 2 * ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2
  have hArgument : HasDerivAt
      (fun current : ℝ => coefficient * current - offset) coefficient theta := by
    simpa only [mul_one] using
      ((hasDerivAt_id' theta).const_mul coefficient).sub_const offset
  have hExp := (Real.hasDerivAt_exp _).comp theta hArgument
  have hWeighted := (hExp.const_mul coefficient).const_mul
    (poissonTraceProb (point.samplingRate : ℝ) trace)
  dsimp [coefficient, offset] at hWeighted ⊢
  convert hWeighted using 1
  all_goals first | rfl | ring

/-- Every non-full fixed-epoch trace has a strictly convex center tilt. -/
theorem fixedEpochCenterTiltSecond_pos
    (point : PoissonFixedEpochPoint) (h theta : ℝ)
    (hNonFull : point.epoch < point.horizon) (hh : 0 < h) :
    0 < fixedEpochCenterTiltSecond point h theta := by
  unfold fixedEpochCenterTiltSecond
  rw [Finset.sum_pos_iff_of_nonneg]
  · refine ⟨trueTrace point.horizon, Finset.mem_univ _, ?_⟩
    have hRatePos : 0 < (point.samplingRate : ℝ) := by
      exact_mod_cast point.samplingRate_pos
    have hTrueWeight : 0 < poissonTraceProb (point.samplingRate : ℝ)
        (trueTrace point.horizon) := by
      unfold poissonTraceProb trueTrace
      apply Finset.prod_pos
      intro i _
      simp only [↓reduceIte, NNReal.coe_pos]
      exact hRatePos
    rw [participationCount_trueTrace]
    have hCentered : 0 < (point.horizon : ℝ) - point.epoch := by
      apply sub_pos.mpr
      exact_mod_cast hNonFull
    positivity
  · intro trace _
    have hRateNonneg : 0 ≤ (point.samplingRate : ℝ) := by positivity
    have hRateUpper : (point.samplingRate : ℝ) ≤ 1 := by
      exact_mod_cast point.samplingRate_le_one
    exact mul_nonneg
      (mul_nonneg (poissonTraceProb_nonneg hRateNonneg hRateUpper trace)
        (sq_nonneg _)) (Real.exp_pos _).le

/-- The finite tilt is strictly convex; this is stronger than the convexity
needed by `gap_pos_of_boundary_nonneg`. -/
theorem fixedEpochCenterTilt_strictConvex
    (point : PoissonFixedEpochPoint) (h : ℝ)
    (hNonFull : point.epoch < point.horizon) (hh : 0 < h) :
    StrictConvexOn ℝ univ (fixedEpochCenterTilt point h) := by
  have hDifferentiable : Differentiable ℝ (fixedEpochCenterTilt point h) :=
    fun theta => (hasDerivAt_fixedEpochCenterTilt point h theta).differentiableAt
  have hDeriv : deriv (fixedEpochCenterTilt point h) =
      fixedEpochCenterTiltDerivative point h := by
    funext theta
    exact (hasDerivAt_fixedEpochCenterTilt point h theta).deriv
  apply strictConvexOn_univ_of_deriv2_pos hDifferentiable.continuous
  intro theta
  change 0 < deriv (deriv (fixedEpochCenterTilt point h)) theta
  rw [hDeriv]
  rw [(hasDerivAt_fixedEpochCenterTiltDerivative point h theta).deriv]
  exact fixedEpochCenterTiltSecond_pos point h theta hNonFull hh

/-- At zero center the non-full tilt is strictly below one. -/
theorem fixedEpochCenterTilt_zero_lt_one
    (point : PoissonFixedEpochPoint) (h : ℝ)
    (hNonFull : point.epoch < point.horizon) (hh : 0 < h) :
    fixedEpochCenterTilt point h 0 < 1 := by
  have hRateNonneg : 0 ≤ (point.samplingRate : ℝ) := by positivity
  have hRateUpper : (point.samplingRate : ℝ) ≤ 1 := by
    exact_mod_cast point.samplingRate_le_one
  have hTermLe (trace : ParticipationTrace point.horizon) :
      poissonTraceProb (point.samplingRate : ℝ) trace *
          Real.exp
            (-h ^ 2 *
              ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2) ≤
        poissonTraceProb (point.samplingRate : ℝ) trace := by
    have hWeight := poissonTraceProb_nonneg hRateNonneg hRateUpper trace
    have hExp : Real.exp
        (-h ^ 2 * ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      nlinarith [sq_nonneg h,
        sq_nonneg ((participationCount trace : ℝ) - point.epoch)]
    nlinarith [mul_le_mul_of_nonneg_left hExp hWeight]
  have hStrict :
      poissonTraceProb (point.samplingRate : ℝ) (trueTrace point.horizon) *
          Real.exp
            (-h ^ 2 *
              ((participationCount (trueTrace point.horizon) : ℝ) -
                point.epoch) ^ 2 / 2) <
        poissonTraceProb (point.samplingRate : ℝ) (trueTrace point.horizon) := by
    have hRatePos : 0 < (point.samplingRate : ℝ) := by
      exact_mod_cast point.samplingRate_pos
    have hTrueWeight : 0 < poissonTraceProb (point.samplingRate : ℝ)
        (trueTrace point.horizon) := by
      unfold poissonTraceProb trueTrace
      apply Finset.prod_pos
      intro i _
      simp only [↓reduceIte, NNReal.coe_pos]
      exact hRatePos
    rw [participationCount_trueTrace]
    have hCentered : 0 < (point.horizon : ℝ) - point.epoch := by
      apply sub_pos.mpr
      exact_mod_cast hNonFull
    have hExp : Real.exp
        (-h ^ 2 * ((point.horizon : ℝ) - point.epoch) ^ 2 / 2) < 1 := by
      rw [Real.exp_lt_one_iff]
      have hhSq : 0 < h ^ 2 := sq_pos_of_pos hh
      have hCenteredSq : 0 < ((point.horizon : ℝ) - point.epoch) ^ 2 :=
        sq_pos_of_pos hCentered
      nlinarith [mul_pos hhSq hCenteredSq]
    nlinarith [mul_lt_mul_of_pos_left hExp hTrueWeight]
  calc
    fixedEpochCenterTilt point h 0 =
        ∑ trace : ParticipationTrace point.horizon,
          poissonTraceProb (point.samplingRate : ℝ) trace *
            Real.exp
              (-h ^ 2 *
                ((participationCount trace : ℝ) - point.epoch) ^ 2 / 2) := by
          unfold fixedEpochCenterTilt
          apply Finset.sum_congr rfl
          intro trace _
          congr 2
          ring
    _ < ∑ trace : ParticipationTrace point.horizon,
          poissonTraceProb (point.samplingRate : ℝ) trace := by
      apply Finset.sum_lt_sum
      · intro trace _
        exact hTermLe trace
      · exact ⟨trueTrace point.horizon, Finset.mem_univ _, hStrict⟩
    _ = 1 := sum_poissonTraceProb_eq_one _

/-- Finite support makes the center gap vanish at the right endpoint. -/
theorem tendsto_fixedEpochCenterGap_atTop_zero
    (point : PoissonFixedEpochPoint) (h : ℝ) (hh : 0 < h) :
    Tendsto (fixedEpochCenterGap point h) atTop (nhds 0) := by
  have hCdfAtBot : Tendsto stdNormalCDFReal atBot (nhds 0) := by
    change Tendsto (ProbabilityTheory.cdf stdNormalMeasure) atBot (nhds 0)
    exact ProbabilityTheory.tendsto_cdf_atBot (μ := stdNormalMeasure)
  have hTrace (trace : ParticipationTrace point.horizon) : Tendsto
      (fun theta : ℝ =>
        poissonTraceProb (point.samplingRate : ℝ) trace *
          stdNormalCDFReal
            (h * ((participationCount trace : ℝ) - point.epoch - theta)))
      atTop (nhds 0) := by
    have hArgument : Tendsto
        (fun theta : ℝ =>
          h * ((participationCount trace : ℝ) - point.epoch - theta))
        atTop atBot := by
      have hLinear : Tendsto (fun theta : ℝ => (-h) * theta) atTop atBot :=
        tendsto_id.const_mul_atTop_of_neg (by linarith)
      have hAffine := tendsto_atBot_add_const_right atTop
        (h * ((participationCount trace : ℝ) - point.epoch)) hLinear
      convert hAffine using 1
      funext theta
      ring
    simpa using (hCdfAtBot.comp hArgument).const_mul
      (poissonTraceProb (point.samplingRate : ℝ) trace)
  have hSum : Tendsto
      (fun theta : ℝ =>
        ∑ trace : ParticipationTrace point.horizon,
          poissonTraceProb (point.samplingRate : ℝ) trace *
            stdNormalCDFReal
              (h * ((participationCount trace : ℝ) - point.epoch - theta)))
      atTop (nhds 0) := by
    simpa using tendsto_finsetSum Finset.univ (fun trace _ => hTrace trace)
  have hBaseArgument : Tendsto (fun theta : ℝ => -h * theta) atTop atBot :=
    tendsto_id.const_mul_atTop_of_neg (by linarith)
  have hBase : Tendsto (fun theta : ℝ => stdNormalCDFReal (-h * theta))
      atTop (nhds 0) := hCdfAtBot.comp hBaseArgument
  unfold fixedEpochCenterGap
  simpa only [sub_zero, neg_mul] using hSum.sub hBase

/-- Abstract shape lemma isolated from the finite Gaussian trace.  Convexity
of the exponential tilt, its strict deficit at zero, the exact derivative
sign, and the vanishing right endpoint are the only inputs. -/
theorem gap_pos_of_boundary_nonneg
    (gap tilt positiveFactor : ℝ → ℝ) (boundary query : ℝ)
    (hBoundaryNonneg : 0 ≤ boundary)
    (hBoundaryQuery : boundary < query)
    (hTiltConvex : ConvexOn ℝ (Ici 0) tilt)
    (hTiltZero : tilt 0 < 1)
    (hFactor : ∀ x, 0 < positiveFactor x)
    (hGapDeriv : ∀ x,
      HasDerivAt gap (positiveFactor x * (1 - tilt x)) x)
    (hGapBoundary : 0 ≤ gap boundary)
    (hGapLimit : Tendsto gap atTop (nhds 0)) :
    0 < gap query := by
  have hBoundaryPos : 0 < query := hBoundaryNonneg.trans_lt hBoundaryQuery
  by_cases hQueryTilt : tilt query < 1
  · have hTiltLt : ∀ x ∈ Icc boundary query, tilt x < 1 := by
      intro x hx
      have hx0 : 0 ≤ x := hBoundaryNonneg.trans hx.1
      rcases eq_or_lt_of_le hx.2 with rfl | hxQuery
      · exact hQueryTilt
      rcases eq_or_lt_of_le hx0 with rfl | hxPos
      · exact hTiltZero
      · have hSecant := hTiltConvex.secant_mono_aux1
          (x := 0) (y := x) (z := query)
          (by simp) (by exact hBoundaryPos.le) hxPos hxQuery
        nlinarith
    have hGapContinuous : ContinuousOn gap (Icc boundary query) :=
      (continuous_iff_continuousAt.mpr fun x => (hGapDeriv x).continuousAt).continuousOn
    have hStrictMono : StrictMonoOn gap (Icc boundary query) := by
      apply strictMonoOn_of_hasDerivWithinAt_pos (convex_Icc boundary query)
        hGapContinuous
      · intro x _hx
        exact (hGapDeriv x).hasDerivWithinAt
      · intro x hx
        rw [interior_Icc] at hx
        exact mul_pos (hFactor x) (sub_pos.mpr (hTiltLt x ⟨hx.1.le, hx.2.le⟩))
    exact lt_of_le_of_lt hGapBoundary
      (hStrictMono ⟨le_rfl, hBoundaryQuery.le⟩ ⟨hBoundaryQuery.le, le_rfl⟩
        hBoundaryQuery)
  · have hTiltQuery : 1 ≤ tilt query := le_of_not_gt hQueryTilt
    have hTiltGt : ∀ x, query < x → 1 < tilt x := by
      intro x hQueryX
      have hSecant := hTiltConvex.secant_mono_aux1
        (x := 0) (y := query) (z := x)
        (by simp) (by simp; linarith) hBoundaryPos hQueryX
      nlinarith
    have hGapContinuousOn (upper : ℝ) (hUpper : query < upper) :
        ContinuousOn gap (Icc query upper) :=
      (continuous_iff_continuousAt.mpr fun x => (hGapDeriv x).continuousAt).continuousOn
    have hStrictAntiOn (upper : ℝ) (hUpper : query < upper) :
        StrictAntiOn gap (Icc query upper) := by
      apply strictAntiOn_of_hasDerivWithinAt_neg (convex_Icc query upper)
        (hGapContinuousOn upper hUpper)
      · intro x _hx
        exact (hGapDeriv x).hasDerivWithinAt
      · intro x hx
        rw [interior_Icc] at hx
        exact mul_neg_of_pos_of_neg (hFactor x)
          (sub_neg.mpr (hTiltGt x hx.1))
    have hTailLower (upper : ℝ) (hUpper : query + 1 < upper) :
        gap upper < gap (query + 1) := by
      exact hStrictAntiOn upper (by linarith)
        ⟨by linarith, hUpper.le⟩ ⟨by linarith, le_rfl⟩
        hUpper
    have hGapOneNonneg : 0 ≤ gap (query + 1) := by
      apply le_of_tendsto hGapLimit
      filter_upwards [eventually_gt_atTop (query + 1)] with upper hUpper
      exact (hTailLower upper hUpper).le
    have hQueryGtOne : gap (query + 1) < gap query := by
      exact hStrictAntiOn (query + 1) (by linarith)
        ⟨le_rfl, by linarith⟩ ⟨by linarith, le_rfl⟩ (by linarith)
    exact hGapOneNonneg.trans_lt hQueryGtOne

/-- Fixed-`h` center propagation for the exact finite trace.  A nonnegative
gap at one nonnegative boundary center becomes a strict positive gap at every
larger center. -/
theorem fixedEpochCenterGap_pos_of_boundary_nonneg
    (point : PoissonFixedEpochPoint) (h boundary query : ℝ)
    (hNonFull : point.epoch < point.horizon) (hh : 0 < h)
    (hBoundaryNonneg : 0 ≤ boundary) (hBoundaryQuery : boundary < query)
    (hBoundaryGap : 0 ≤ fixedEpochCenterGap point h boundary) :
    0 < fixedEpochCenterGap point h query := by
  apply gap_pos_of_boundary_nonneg
    (fixedEpochCenterGap point h)
    (fixedEpochCenterTilt point h)
    (fun theta => h * stdNormalPdfReal (h * theta))
    boundary query hBoundaryNonneg hBoundaryQuery
  · exact (fixedEpochCenterTilt_strictConvex point h hNonFull hh).convexOn.subset
      (by simp) (convex_Ici 0)
  · exact fixedEpochCenterTilt_zero_lt_one point h hNonFull hh
  · intro theta
    exact mul_pos hh (stdNormalPdfReal_pos _)
  · exact hasDerivAt_fixedEpochCenterGap point h
  · exact hBoundaryGap
  · exact tendsto_fixedEpochCenterGap_atTop_zero point h hh

/-- The abstract center gap is exactly the existing Gaussian count-test gap
after expressing the positive center distance in count-step units. -/
theorem fixedEpochCenterGap_eq_countTestAverage_sub
    (point : PoissonFixedEpochPoint) (centerDistance : Real)
    (signal : NNReal) (hSignal : 0 < signal) :
    fixedEpochCenterGap point ((signal : Real) / point.epoch)
        ((point.epoch : Real) * centerDistance / (signal : Real)) =
      poissonTraceCountAverage point.horizon point.samplingRate
          (fixedEpochGaussianCountTest point (-centerDistance) signal) -
        stdNormalCDFReal (-centerDistance) := by
  have hEpoch : (point.epoch : Real) ≠ 0 := by
    exact_mod_cast point.epoch_pos.ne'
  have hSignalReal : (signal : Real) ≠ 0 := by
    exact_mod_cast hSignal.ne'
  unfold fixedEpochCenterGap poissonTraceCountAverage fixedEpochGaussianCountTest
  have hBase :
      -((signal : Real) / point.epoch) *
          ((point.epoch : Real) * centerDistance / (signal : Real)) =
        -centerDistance := by
    field_simp [hEpoch, hSignalReal]
  rw [hBase]
  apply congrArg (fun value : Real ↦ value - stdNormalCDFReal (-centerDistance))
  apply Finset.sum_congr rfl
  intro trace _hTrace
  congr 2
  field_simp [hEpoch, hSignalReal]
  ring

end Mf.DP
### Mf/DP/PoissonFixedEpochStrictInteriorCounterexample.lean
import Mf.DP.PoissonFixedEpochRectangleHybridConcreteAggregate
import Mf.DP.PoissonFixedEpochOutputSum
import Mf.DP.PoissonFixedEpochEnergyThreshold
import Mf.DP.PoissonFixedEpochFullBatchCandidateBracket
import Mf.DP.PoissonFixedEpochFullBatchFourTwentyFifthsBracket
import Mf.DP.SampledGaussianFiniteFeasibility

namespace Mf.DP

open PoissonFixedEpochRectangleActiveHinge
open PoissonFixedEpochRectangleAtomicIntervals
open PoissonFixedEpochFullBatchCandidateBracket
open PoissonFixedEpochFullBatchFourTwentyFifthsBracket

noncomputable section

def strictInteriorPoint : PoissonFixedEpochPoint :=
  PoissonFixedEpochPoint.ofExtra 2 (by norm_num) 1

/-- The selected target `delta = 3/4` lies strictly below the zero-noise
nonparticipation boundary `1 - exp (-2)` for expected participation two. -/
theorem three_quarters_lt_one_sub_exp_neg_two :
    (3 / 4 : Real) < 1 - Real.exp (-2) := by
  have he' : (1 : Real) + 1 < Real.exp 1 :=
    Real.add_one_lt_exp (by norm_num : (1 : Real) ≠ 0)
  have he : (2 : Real) < Real.exp 1 := by
    norm_num at he' ⊢
    exact he'
  have hexp : (4 : Real) < Real.exp 2 := by
    have heSq : (4 : Real) < (Real.exp 1) ^ 2 := by
      nlinarith [Real.exp_pos 1]
    calc
      (4 : Real) < (Real.exp 1) ^ 2 := heSq
      _ = Real.exp 2 := by rw [pow_two, ← Real.exp_add]; norm_num
  have hinv : Real.exp (-2) < (1 / 4 : Real) := by
    rw [Real.exp_neg]
    simpa only [one_div] using
      (one_div_lt_one_div_of_lt (by norm_num : (0 : Real) < 4) hexp)
  linarith

/-- The concrete counterexample parameters have positive epsilon and lie in
the strict fixed-participation privacy domain. -/
theorem strictInterior_privacyParameters :
    (0 : Real) < 1 / 4 ∧
      (0 : Real) < 3 / 4 ∧
      (3 / 4 : Real) < 1 - Real.exp (-2) := by
  exact ⟨by norm_num, by norm_num, three_quarters_lt_one_sub_exp_neg_two⟩

def strictInteriorRunVariance : NNReal := 5 / 32

def strictInteriorNoiseStddev : NNReal :=
  ⟨tilt⁻¹, inv_nonneg.mpr (by
    unfold tilt Training.BMinSep.SqrtRationalData.value
    positivity)⟩

theorem rawVariance_eq :
    poissonFixedEpochRawNoiseVariance strictInteriorPoint strictInteriorRunVariance =
      (5 / 24 : NNReal) := by
  ext
  norm_num [poissonFixedEpochRawNoiseVariance, strictInteriorPoint,
    strictInteriorRunVariance, PoissonFixedEpochPoint.samplingRate,
    PoissonFixedEpochPoint.ofExtra, NNReal.coe_div]

theorem rawStddev_coe_eq :
    (strictInteriorNoiseStddev : Real) = tilt⁻¹ := rfl

theorem sampled_profile_lt :
    sampledGaussianProductProfileStddev 3 twoThirdsSamplingRate
        twoThirdsSamplingRate_le_one 1
        strictInteriorNoiseStddev (1 / 4) <
      ENNReal.ofReal (3 / 4 : Real) := by
  have hstd : 0 < strictInteriorNoiseStddev := by
    change 0 < tilt⁻¹
    exact inv_pos.mpr (by
      unfold tilt Training.BMinSep.SqrtRationalData.value
      positivity)
  rw [sampledGaussianProductProfileStddev_eq_sparseGaussianProductProfile
    3 twoThirdsSamplingRate twoThirdsSamplingRate_le_one 1 _ hstd (1 / 4)]
  have hshift : 1 / (strictInteriorNoiseStddev : Real) = tilt := by
    rw [rawStddev_coe_eq]
    simpa only [one_div] using inv_inv tilt
  rw [hshift]
  have hlog : Real.log alpha = 1 / 4 := by
    simp [alpha]
  rw [← hlog]
  exact max_lt
    PoissonFixedEpochRectangleHybridConcreteAggregate.directed_profiles_lt_three_quarters.1
    PoissonFixedEpochRectangleHybridConcreteAggregate.directed_profiles_lt_three_quarters.2

theorem strictInteriorNoiseStddev_sq :
    (strictInteriorNoiseStddev : Real) ^ 2 = 5 / 24 := by
  change (tilt⁻¹) ^ 2 = (5 / 24 : Real)
  rw [inv_pow, tilt_sq]
  norm_num

theorem strictInteriorNoiseStddev_feasible :
    strictInteriorNoiseStddev ∈
      sampledGaussianFeasibleStddevSet 3 twoThirdsSamplingRate
        twoThirdsSamplingRate_le_one 1 (1 / 4) (3 / 4) := by
  rw [mem_sampledGaussianFeasibleStddevSet_iff]
  exact sampled_profile_lt.le

/-- The exact calibrated privacy variance at the strict-interior sampled point
is no larger than the certified candidate `5/32`. -/
theorem strictInterior_calibratedPrivacyVariance_le_five_thirty_seconds :
    poissonFixedEpochCalibratedPrivacyVariance strictInteriorPoint
        1 (1 / 4) (3 / 4) ≤ 5 / 32 := by
  have hcalibrated := sampledGaussianCalibratedStddev_le_of_feasible
    3 twoThirdsSamplingRate twoThirdsSamplingRate_le_one
    1 (1 / 4) (3 / 4) strictInteriorNoiseStddev
    strictInteriorNoiseStddev_feasible
  have hcalibrated' :
      poissonFixedEpochCalibratedStddev strictInteriorPoint
          1 (1 / 4) (3 / 4) ≤ strictInteriorNoiseStddev := by
    have hrate : strictInteriorPoint.samplingRate = twoThirdsSamplingRate := by
      apply NNReal.eq
      rfl
    unfold poissonFixedEpochCalibratedStddev
    simpa only [show strictInteriorPoint.horizon = 3 by rfl, hrate] using
      hcalibrated
  have hsquare :
      (poissonFixedEpochCalibratedStddev strictInteriorPoint
          1 (1 / 4) (3 / 4) : Real) ^ 2 ≤
        (strictInteriorNoiseStddev : Real) ^ 2 :=
    (sq_le_sq₀ (by positivity) (by positivity)).2 (by exact_mod_cast hcalibrated')
  rw [strictInteriorNoiseStddev_sq] at hsquare
  unfold poissonFixedEpochCalibratedPrivacyVariance
    poissonFixedEpochPrivacyVarianceOfStddev
  change (3 / (2 : Real) ^ 2) *
      (poissonFixedEpochCalibratedStddev strictInteriorPoint
        1 (1 / 4) (3 / 4) : Real) ^ 2 ≤ 5 / 32
  rw [show (3 / (2 : Real) ^ 2) = 3 / 4 by norm_num]
  calc
    (3 / 4 : Real) *
        (poissonFixedEpochCalibratedStddev strictInteriorPoint
          1 (1 / 4) (3 / 4) : Real) ^ 2 ≤
        (3 / 4 : Real) * (5 / 24) :=
      mul_le_mul_of_nonneg_left hsquare (by norm_num)
    _ = 5 / 32 := by norm_num

/-- The sampled point has strictly smaller calibrated privacy variance than
the full-batch endpoint at `E=2`, with positive epsilon and interior delta. -/
theorem strictInterior_calibratedPrivacyVariance_lt_fullBatch :
    poissonFixedEpochCalibratedPrivacyVariance strictInteriorPoint
        1 (1 / 4) (3 / 4) <
      (fullBatchGaussianBaseStddev 1 (1 / 4) (3 / 4)
        (by norm_num) (by norm_num) (by norm_num) (by norm_num)) ^ 2 :=
  strictInterior_calibratedPrivacyVariance_le_five_thirty_seconds.trans_lt
    five_thirty_seconds_lt_calibrated_sq

/-- The adjacent point `T=3` has strictly smaller calibrated privacy variance
than the fixed-epoch full-batch point `T=E=2`. -/
theorem strictInterior_calibratedPrivacyVariance_lt_adjacentFullBatch :
    poissonFixedEpochCalibratedPrivacyVariance strictInteriorPoint
        1 (1 / 4) (3 / 4) <
      poissonFixedEpochCalibratedPrivacyVariance
        (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
        1 (1 / 4) (3 / 4) := by
  unfold poissonFixedEpochCalibratedPrivacyVariance
  rw [poissonFixedEpochPrivacyVariance_fullBatch_eq_base_sq 2 (by norm_num)
    1 (1 / 4) (3 / 4) (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
  exact strictInterior_calibratedPrivacyVariance_lt_fullBatch

/-- Calibrated privacy variance is not nondecreasing on the first adjacent
horizon step `T=2` to `T=3` at the selected strict-interior target. -/
theorem strictInterior_not_adjacent_calibratedPrivacyVariance_nondec :
    ¬ poissonFixedEpochCalibratedPrivacyVariance
        (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
        1 (1 / 4) (3 / 4) ≤
      poissonFixedEpochCalibratedPrivacyVariance strictInteriorPoint
        1 (1 / 4) (3 / 4) :=
  not_le_of_gt strictInterior_calibratedPrivacyVariance_lt_adjacentFullBatch

/-- The exact energy threshold at the selected adjacent point is strictly
larger than the explicit certified endpoint `9/400`. -/
theorem nine_four_hundred_lt_six_mul_strictInterior_calibratedPrivacyVariance_gap :
    9 / 400 < 6 *
      (poissonFixedEpochCalibratedPrivacyVariance
          (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
          1 (1 / 4) (3 / 4) -
        poissonFixedEpochCalibratedPrivacyVariance strictInteriorPoint
          1 (1 / 4) (3 / 4)) := by
  have sampled_le :
      poissonFixedEpochCalibratedPrivacyVariance strictInteriorPoint
          1 (1 / 4) (3 / 4) ≤ 5 / 32 :=
    strictInterior_calibratedPrivacyVariance_le_five_thirty_seconds
  have fullBatch_gt :
      4 / 25 <
        poissonFixedEpochCalibratedPrivacyVariance
          (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
          1 (1 / 4) (3 / 4) := by
    unfold poissonFixedEpochCalibratedPrivacyVariance
    rw [poissonFixedEpochPrivacyVariance_fullBatch_eq_base_sq 2 (by norm_num)
      1 (1 / 4) (3 / 4) (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
    exact four_twenty_fifths_lt_calibrated_sq
  linarith

/-- At the selected adjacent point, the true calibrated privacy-variance gap
algebraically characterizes strict total-variance reversal for every real
energy; the frozen-gradient interpretation uses the physical domain
`0 ≤ energy`. -/
theorem strictInterior_totalVariance_lt_fullBatch_iff_energy_lt_calibrated_gap
    (energy : Real) :
    poissonFixedEpochTotalAverageVariance strictInteriorPoint
        1 (1 / 4) (3 / 4) energy <
      poissonFixedEpochTotalAverageVariance
        (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
        1 (1 / 4) (3 / 4) energy ↔
      energy < 6 *
        (poissonFixedEpochCalibratedPrivacyVariance
            (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
            1 (1 / 4) (3 / 4) -
          poissonFixedEpochCalibratedPrivacyVariance strictInteriorPoint
            1 (1 / 4) (3 / 4)) := by
  have fullBatch_privacy_eq :
      poissonFixedEpochCalibratedPrivacyVariance
          (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
          1 (1 / 4) (3 / 4) =
        (fullBatchGaussianBaseStddev 1 (1 / 4) (3 / 4)
          (by norm_num) (by norm_num) (by norm_num) (by norm_num)) ^ 2 := by
    unfold poissonFixedEpochCalibratedPrivacyVariance
    rw [poissonFixedEpochPrivacyVariance_fullBatch_eq_base_sq 2 (by norm_num)
      1 (1 / 4) (3 / 4) (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
  rw [fullBatch_privacy_eq]
  rw [poissonFixedEpochTotalAverageVariance_fullBatch_eq_base_sq 2 (by norm_num)
    1 (1 / 4) (3 / 4) energy (by norm_num) (by norm_num) (by norm_num)
    (by norm_num)]
  unfold poissonFixedEpochTotalAverageVariance
    poissonFixedEpochTotalAverageVarianceOfStddev
    poissonFixedEpochCalibratedPrivacyVariance
  have sampling_eq :
      poissonFixedEpochSamplingVariance strictInteriorPoint energy = energy / 6 := by
    norm_num [poissonFixedEpochSamplingVariance, strictInteriorPoint,
      PoissonFixedEpochPoint.ofExtra]
    <;> ring
  rw [sampling_eq]
  constructor <;> intro h <;> linarith

/-- A strict finite fixed-epoch counterexample: at zero frozen-gradient energy,
the infimal calibrated total-variance benchmark for `T=3`, `q=2/3` is smaller
than the full-batch benchmark at `T=E=2` for
`(epsilon, delta) = (1/4, 3/4)`. -/
theorem strictInterior_totalVariance_lt_fullBatch_zeroEnergy :
    poissonFixedEpochTotalAverageVariance strictInteriorPoint
        1 (1 / 4) (3 / 4) 0 <
      poissonFixedEpochTotalAverageVariance
        (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
        1 (1 / 4) (3 / 4) 0 := by
  apply poissonFixedEpoch_totalVariance_lt_fullBatch_of_certified_upper
    strictInteriorPoint 1 (1 / 4) (3 / 4) 0 (5 / 32)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    strictInterior_calibratedPrivacyVariance_le_five_thirty_seconds
  unfold poissonFixedEpochSamplingVariance
  norm_num [strictInteriorPoint, PoissonFixedEpochPoint.ofExtra]
  exact five_thirty_seconds_lt_calibrated_sq

/-- The strict-interior total-variance reversal persists throughout the closed
nonnegative-energy interval `0 ≤ S ≤ 9/400`. -/
theorem strictInterior_totalVariance_lt_fullBatch_of_energy_le_nine_four_hundred
    (energy : Real) (_energy_nonneg : 0 ≤ energy)
    (energy_le : energy ≤ 9 / 400) :
    poissonFixedEpochTotalAverageVariance strictInteriorPoint
        1 (1 / 4) (3 / 4) energy <
      poissonFixedEpochTotalAverageVariance
        (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
        1 (1 / 4) (3 / 4) energy := by
  apply poissonFixedEpoch_totalVariance_lt_fullBatch_of_certified_upper
    strictInteriorPoint 1 (1 / 4) (3 / 4) energy (5 / 32)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    strictInterior_calibratedPrivacyVariance_le_five_thirty_seconds
  calc
    poissonFixedEpochSamplingVariance strictInteriorPoint energy + 5 / 32 =
        energy / 6 + 5 / 32 := by
      norm_num [poissonFixedEpochSamplingVariance, strictInteriorPoint,
        PoissonFixedEpochPoint.ofExtra]
      <;> ring
    _ ≤ 4 / 25 := by linarith
    _ < (fullBatchGaussianBaseStddev 1 (1 / 4) (3 / 4)
        (by norm_num) (by norm_num) (by norm_num) (by norm_num)) ^ 2 :=
      four_twenty_fifths_lt_calibrated_sq

/-- Open-interval compatibility corollary of the closed endpoint theorem. -/
theorem strictInterior_totalVariance_lt_fullBatch_of_energy_lt_nine_four_hundred
    (energy : Real) (energy_nonneg : 0 ≤ energy)
    (energy_lt : energy < 9 / 400) :
    poissonFixedEpochTotalAverageVariance strictInteriorPoint
        1 (1 / 4) (3 / 4) energy <
      poissonFixedEpochTotalAverageVariance
        (PoissonFixedEpochPoint.fullBatch 2 (by norm_num))
        1 (1 / 4) (3 / 4) energy :=
  strictInterior_totalVariance_lt_fullBatch_of_energy_le_nine_four_hundred
    energy energy_nonneg energy_lt.le

end
end Mf.DP
