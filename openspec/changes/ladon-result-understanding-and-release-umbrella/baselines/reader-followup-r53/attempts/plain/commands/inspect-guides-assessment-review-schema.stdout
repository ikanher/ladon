STEP {
  "id": "fixed-participation-limit",
  "revision": "sha256:6c53e759f427b4e354de2550a3b0627c60afa46fe6a2bcaf9b330ecb91a64dbd",
  "claimId": "thm:accountant-limit",
  "claimRevision": "sha256:fa568c1b36e683ed12deb097a7cac602850a9680a928ce3b36e1b9d2b53dfe5d",
  "targetRevisions": [
    {
      "targetId": "profile-limit",
      "revision": "sha256:38d1919ba72d0ae45f049ae988b026083a176ace1e5c334d4a451a574de43c75"
    }
  ],
  "purpose": "Put the fixed-rate background in its proper place.",
  "explanation": "The appendix gives a general fixed-participation privacy-profile limit and calibrated offset. The exposition compares it with the fixed-rate result cited from Räisä, Jälkö, and Honkela (2024), while explicitly explaining that fixed q>0 does not specialize to q=E/T without uniformity in q. The source-correspondence assessment describes schedule adapters; this is not an asserted direct identity between differently parameterized statements.",
  "sources": [
    {
      "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:accountant-limit",
      "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
    },
    {
      "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:fixed-participation-calibration",
      "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
    },
    {
      "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex:431 (section Scope of the conclusions)",
      "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
    }
  ],
  "author": {
    "identity": "OpenAI Codex guide agents (field proposal and root revision)",
    "kind": "model"
  },
