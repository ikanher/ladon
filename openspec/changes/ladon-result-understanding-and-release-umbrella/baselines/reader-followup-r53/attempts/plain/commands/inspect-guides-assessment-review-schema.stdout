  "claimId": "prop:average-uniform-bound",
  "claimRevision": "sha256:98adfc1f05587ac23d55fa2bf1c0f1ee6c92d060f48da7fe21e2cb76381d8fe5",
  "targetRevisions": [],
  "purpose": "Distinguish bounded average calibration from transcript divergence.",
  "explanation": "The proposition gives a horizon-uniform upper bound for average-only calibrated variance. Alongside the sparse transcript theorem, it explains the manuscript’s comparison of output choices. The bound is presented as a feasibility estimate, not an asymptotic formula.",
