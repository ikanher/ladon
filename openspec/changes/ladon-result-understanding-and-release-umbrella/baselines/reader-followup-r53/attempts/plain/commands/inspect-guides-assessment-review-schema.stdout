      "targetId": "hinge-positive",
      "revision": "sha256:13fdd87763a261c9e339134ea2b7b4bd1ed9c7ae1a65b2f64cf9682e546c4af7"
    },
    {
      "targetId": "polynomial",
      "revision": "sha256:37d60120ec4c1c981ccf7088ca18adaea2f825235430e7710fe9cdd529989092"
    }
  ],
  "purpose": "Unpack the supporting discrete calculation.",
  "explanation": "The appendix rewrites the comparison as a Laplace integral of a hinge transform and uses a binomial telescoping identity to establish its sign and a strict positive knot. The formal targets cover the nonnegative and strict hinge statements and the polynomial identity. The guide does not independently validate the algebra or the exposition-to-target translations. The supplied correspondence uses radius √t for J(t), radius 1-c for its positive knot, and a sign change on both sides of the general-radius polynomial identity. These translation steps retain their attributed status.",
  "sources": [
    {
      "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:binomial-double-cumulative",
      "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
    },
    {
      "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:binomial-stein-polynomial",
      "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
    },
    {
      "locator": "latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#app:binomial-signs",
      "digest": "sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583"
    }
  ],
  "author": {
    "identity": "OpenAI Codex guide agents (field proposal and root revision)",
    "kind": "model"
  },
