  "id": "hinge-and-telescoping",
  "revision": "sha256:daa367d1d367b9a530a3e651ad30556e594de351c1ec220062f40d525951ec57",
  "claimId": "lem:binomial-double-cumulative",
  "claimRevision": "sha256:1dc10cffe6bd81b1f5eda04b3211d97f132de164f36240d163c205066a7f5230",
  "targetRevisions": [
    {
      "targetId": "hinge-nonnegative",
      "revision": "sha256:9af9796c9f9f7a7a2f3c11f833cd4b235a188c65d6cfc955aef12cbc726cf034"
    },
