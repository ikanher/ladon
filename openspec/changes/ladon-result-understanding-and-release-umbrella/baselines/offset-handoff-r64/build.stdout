        (ProbabilityTheory.bernoulliMeasure x y p) s =
          if x ∈ s then if y ∈ s then 1 else ↑(unitInterval.toNNReal p)
          else if y ∈ s then ↑(unitInterval.toNNReal (unitInterval.symm p)) else 0
instead of
  ∀ {p : NNReal} (h : p ≤ 1) (b : Bool), (PMF.bernoulli p h) b = ↑(bif b then p else 1 - p)

Note: The updated constant is in a different namespace. Dot notation may need to be changed (e.g., from `x.bernoulli_apply` to `ProbabilityTheory.bernoulliMeasure_apply x`).
