targets [
  {
    "id": "fullbatch",
    "name": "Mf.DP.poissonFixedEpochPrivacyVariance_fullBatch_eq_base_sq",
    "typeText": "\u2200 (epoch : \u2115) (epoch_pos : 0 < epoch) (sensitivity epsilon delta : \u211d) (sensitivity_pos : 0 < sensitivity)\n  (epsilon_nonneg : 0 \u2264 epsilon) (delta_pos : 0 < delta) (delta_lt_one : delta < 1),\n  Mf.DP.poissonFixedEpochPrivacyVarianceOfStddev (Mf.DP.PoissonFixedEpochPoint.fullBatch epoch epoch_pos)\n      \u2191(Mf.DP.poissonFixedEpochCalibratedStddev (Mf.DP.PoissonFixedEpochPoint.fullBatch epoch epoch_pos) sensitivity\n          epsilon delta) =\n    Mf.DP.fullBatchGaussianBaseStddev sensitivity epsilon delta sensitivity_pos epsilon_nonneg delta_pos delta_lt_one ^\n      2",
    "source": {
      "path": "Mf/DP/PoissonFixedEpochVariance.lean",
