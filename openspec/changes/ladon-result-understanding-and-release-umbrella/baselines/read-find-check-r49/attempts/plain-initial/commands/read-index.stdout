    {
      "id": "profile-limit",
      "name": "Mf.DP.tendsto_sampledGaussianProductProfileStddev_finiteOffset",
      "typeText": "∀ (schedule : Mf.DP.FixedParticipationSchedule) (sensitivity : ℝ) (noiseStddev : ℕ → NNReal) (offset epsilon : ℝ),\n  0 < sensitivity →\n    0 ≤ epsilon →\n      (∀ᶠ (horizon : ℕ) in Filter.atTop, 0 < noiseStddev horizon) →\n        Filter.Tendsto (fun horizon => sensitivity / ↑(noiseStddev horizon) - Mf.DP.gaussianCriticalScale horizon)\n            Filter.atTop (nhds offset) →\n          Filter.Tendsto\n            (fun horizon =>\n              Mf.DP.sampledGaussianProductProfileStddev horizon (schedule.samplingRate horizon) ⋯ sensitivity\n                (noiseStddev horizon) epsilon)\n            Filter.atTop\n            (nhds (ENNReal.ofReal (1 - Real.exp (-↑schedule.participationBudget * Mf.DP.stdNormalCDFReal offset))))",
      "source": {
        "path": "Mf/DP/FixedParticipationGaussianAccounting.lean",
        "digest": "sha256:c2da34b048b1c5b37180a9e4da3cc6b62d89182628fa9b45e5eb773cd10b133d",
        "projectRevision": "capture-state:sha256:68213e5db068e5e56be5e88155ff4f3cdc808e4c03baddfa92973590b9466720"
      },
