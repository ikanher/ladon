    {
      "id": "hinge-positive",
      "name": "Mf.DP.FixedEpochBoundarySignedLaplace.boundaryDoubleCumulative_firstPositiveKnot_pos",
      "typeText": "∀ (epoch complement : ℕ),\n  0 < epoch →\n    epoch < complement →\n      have total := ↑epoch + ↑complement;\n      have boundary := (↑complement - ↑epoch) / (3 * total);\n      0 < Mf.DP.binomialSkewBoundary_boundaryDoubleCumulative epoch complement (1 - boundary)",
