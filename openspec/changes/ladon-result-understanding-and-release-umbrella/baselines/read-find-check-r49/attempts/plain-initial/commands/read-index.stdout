    {
      "id": "raw-ratio",
      "name": "Mf.DP.tendsto_poissonFixedEpochCalibratedStddev_smallRate_ratio_one",
      "typeText": "∀ (epoch : ℕ) (epoch_pos : 0 < epoch) (sensitivity epsilon delta : ℝ),\n  0 < sensitivity →\n    0 ≤ epsilon →\n      0 < delta →\n        delta < 1 - Real.exp (-↑epoch) →\n          Filter.Tendsto\n            (fun extra =>\n              ↑(Mf.DP.poissonFixedEpochCalibratedStddev (Mf.DP.PoissonFixedEpochPoint.ofExtra epoch epoch_pos extra)\n                      sensitivity epsilon delta) *\n                  √(2 * Real.log (1 / ↑(Mf.DP.PoissonFixedEpochPoint.ofExtra epoch epoch_pos extra).samplingRate)) /\n                sensitivity)\n            Filter.atTop (nhds 1)",
      "source": {
        "path": "Mf/DP/PoissonFixedEpochAsymptotics.lean",
        "digest": "sha256:436ca6b8d6e121a8f398977adbb91f5e3c45dc03e8d8279d88e11b052f737471",
        "projectRevision": "capture-state:sha256:3c9428b241a02fdf7a2c43e926f08f7278d1791caf1a848273fae5e3b8fade62"
