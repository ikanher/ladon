    {
      "id": "polynomial",
      "name": "Mf.DP.binomialSkewBoundary_boundarySteinPolynomial_identity",
      "typeText": "∀ (epoch complement : ℕ),\n  0 < epoch + complement →\n    ∀ (radius centered : ℝ),\n      have total := ↑epoch + ↑complement;\n      have rate := ↑epoch / total;\n      have complementRate := ↑complement / total;\n      have boundary := (↑complement - ↑epoch) / (3 * total);\n      have steinPotential := fun value =>\n        radius ^ 2 - 2 * ↑epoch * complementRate - 3 * boundary ^ 2 + value - value ^ 2;\n      (centered - boundary) * ((centered - boundary) ^ 2 - radius ^ 2) - boundary * (radius ^ 2 - boundary ^ 2) =\n        rate * (↑complement - centered) * steinPotential (centered + 1) -\n          complementRate * (↑epoch + centered) * steinPotential centered",
      "source": {
        "path": "Mf/DP/PoissonFixedEpochBinomialSkewBoundary.lean",
        "digest": "sha256:8e78ca9846b6f614ac3fbac802fc8ed7cd1bfb7329d7faed0dfed216469528b9",
        "projectRevision": "capture-state:sha256:fbada67f54a8105fb1f19ebef27b2b8dd986bff6a8d8b0603d92febee3a8cd2f"
      },
      "environment": {
        "toolchain": "leanprover/lean4:v4.33.0",
        "digest": "sha256:c911232de3f09aacaebccec9893bb7a62a3cb43c007a3e769796fc2f2e2db6b5"
      },
      "subjectRef": {
        "artifactId": "sha256:33dc2904a6190b009eba9b0c0b4c0cfe525686ecdb73eb81d4b32a9160c42183",
        "subjectId": "declaration:sha256:68c28f26f314de37fce67db094953ae90e27d57389fc22da46306f9e4dc0ef80"
      },
      "revision": "sha256:37d60120ec4c1c981ccf7088ca18adaea2f825235430e7710fe9cdd529989092"
    },
    {
      "id": "hinge-nonnegative",
      "name": "Mf.DP.binomialSkewBoundary_boundaryDoubleCumulative_nonneg",
      "typeText": "∀ (epoch complement : ℕ),\n  0 < epoch →\n    epoch ≤ complement →\n      ∀ (radius : ℝ), 0 ≤ radius → 0 ≤ Mf.DP.binomialSkewBoundary_boundaryDoubleCumulative epoch complement radius",
      "source": {
