    {
      "id": "capped-ratio",
      "name": "Mf.DP.tendsto_cappedFixedParticipationCalibratedStddev_smallRate_ratio_one",
      "typeText": "∀ (participationBudget : NNReal) (hBudget : 0 < participationBudget) (sensitivity epsilon delta : ℝ),\n  0 < sensitivity →\n    0 ≤ epsilon →\n      0 < delta →\n        delta < 1 - Real.exp (-↑participationBudget) →\n          Filter.Tendsto\n            (fun horizon =>\n              ↑(Mf.DP.fixedParticipationCalibratedStddev\n                      (Mf.DP.cappedFixedParticipationSchedule participationBudget hBudget) sensitivity epsilon delta\n                      horizon) *\n                  √(2 * Real.log (1 / ↑(Mf.DP.cappedParticipationRate participationBudget horizon))) /\n                sensitivity)\n            Filter.atTop (nhds 1)",
      "source": {
