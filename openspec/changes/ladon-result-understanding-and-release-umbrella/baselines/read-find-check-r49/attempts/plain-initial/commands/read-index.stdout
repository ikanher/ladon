    {
      "id": "offset-limit",
      "name": "Mf.DP.tendsto_fixedParticipationCalibratedStddev_offset",
      "typeText": "∀ (schedule : Mf.DP.FixedParticipationSchedule) (sensitivity epsilon delta : ℝ),\n  0 < sensitivity →\n    0 ≤ epsilon →\n      0 < delta →\n        delta < 1 - Real.exp (-↑schedule.participationBudget) →\n          Filter.Tendsto\n            (fun horizon =>\n              sensitivity / ↑(Mf.DP.fixedParticipationCalibratedStddev schedule sensitivity epsilon delta horizon) -\n                Mf.DP.gaussianCriticalScale horizon)\n            Filter.atTop (nhds (Mf.DP.fixedParticipationTargetOffset (↑schedule.participationBudget) delta))",
      "source": {
        "path": "Mf/DP/FixedParticipationGaussianCalibrationAsymptotics.lean",
