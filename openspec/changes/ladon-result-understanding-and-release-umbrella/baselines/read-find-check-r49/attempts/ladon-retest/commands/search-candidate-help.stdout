usage: ladon proof-search search type-text [-h] [--repo-root REPO_ROOT]
                                           [--index INDEX_PATH]
                                           [--format {text,json}]
                                           [--output OUTPUT] [--progress]
                                           --pattern PATTERN [--module MODULE]
                                           [--namespace NAMESPACE]
                                           [--package PACKAGE]
                                           [--scope {closure,external,file,imports,module,namespace,neighborhood,project,repository}]
                                           [--root ROOT] [--limit LIMIT]
                                           [--diagnostic-limit DIAGNOSTIC_LIMIT]
                                           [--freshness {verify,stored}]

options:
  -h, --help            show this help message and exit
  --repo-root REPO_ROOT
                        Lean repository owning the index.
  --index INDEX_PATH    Override the default <repo>/.ladon/index/proof-
                        search.sqlite path.
  --format {text,json}  Result representation.
  --output OUTPUT       Result path, or - for standard output.
  --progress            Write bounded JSON progress records to standard error.
  --pattern PATTERN
  --module MODULE
  --namespace NAMESPACE
  --package PACKAGE
  --scope {closure,external,file,imports,module,namespace,neighborhood,project,repository}
  --root ROOT
  --limit LIMIT
  --diagnostic-limit DIAGNOSTIC_LIMIT
  --freshness {verify,stored}
