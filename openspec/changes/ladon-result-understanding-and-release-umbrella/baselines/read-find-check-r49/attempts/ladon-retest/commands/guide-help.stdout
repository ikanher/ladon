usage: ladon result guide [-h] [--guide-inputs GUIDE_INPUTS]
                          [--max-bytes MAX_BYTES] [--max-members MAX_MEMBERS]
                          [--artifact ARTIFACT]
                          [--lineage-inputs LINEAGE_INPUTS]
                          [--section {steps,citations,reviews,correspondence,targets,checking,assumptions,lineage,evidence}]
                          [--claim CLAIM] [--target TARGET] [--limit LIMIT]
                          [--cursor CURSOR] [--format {json,text}]
                          manifest

positional arguments:
  manifest

options:
  -h, --help            show this help message and exit
  --guide-inputs GUIDE_INPUTS
                        Versioned authored steps, citations and scoped
                        reviews.
  --max-bytes MAX_BYTES
                        Finite archive/expanded-byte ceiling (default 256
                        MiB).
  --max-members MAX_MEMBERS
                        Finite archive member ceiling (default 10000).
  --artifact ARTIFACT
  --lineage-inputs LINEAGE_INPUTS
                        Explicit stored lineage selections; no refresh.
  --section {steps,citations,reviews,correspondence,targets,checking,assumptions,lineage,evidence}
  --claim CLAIM         Exact claim ID.
  --target TARGET       Exact target ID.
  --limit LIMIT
  --cursor CURSOR       Continuation from identical inputs and query.
  --format {json,text}
