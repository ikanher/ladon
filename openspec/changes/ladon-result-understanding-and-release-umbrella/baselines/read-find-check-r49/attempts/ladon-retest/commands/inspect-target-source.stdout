450-/-- The abstract center gap is exactly the existing Gaussian count-test gap
451-after expressing the positive center distance in count-step units. -/
452:theorem fixedEpochCenterGap_eq_countTestAverage_sub
453-    (point : PoissonFixedEpochPoint) (centerDistance : Real)
454-    (signal : NNReal) (hSignal : 0 < signal) :
455:    fixedEpochCenterGap point ((signal : Real) / point.epoch)
456-        ((point.epoch : Real) * centerDistance / (signal : Real)) =
457-      poissonTraceCountAverage point.horizon point.samplingRate
458-          (fixedEpochGaussianCountTest point (-centerDistance) signal) -
459-        stdNormalCDFReal (-centerDistance) := by
460-  have hEpoch : (point.epoch : Real) ≠ 0 := by
461-    exact_mod_cast point.epoch_pos.ne'
462-  have hSignalReal : (signal : Real) ≠ 0 := by
463-    exact_mod_cast hSignal.ne'
464:  unfold fixedEpochCenterGap poissonTraceCountAverage fixedEpochGaussianCountTest
465-  have hBase :
466-      -((signal : Real) / point.epoch) *
467-          ((point.epoch : Real) * centerDistance / (signal : Real)) =
468-        -centerDistance := by
