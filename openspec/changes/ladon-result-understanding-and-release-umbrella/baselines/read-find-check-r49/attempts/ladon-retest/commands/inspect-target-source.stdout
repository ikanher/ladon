345-  have hBaseArgument : Tendsto (fun theta : ℝ => -h * theta) atTop atBot :=
346-    tendsto_id.const_mul_atTop_of_neg (by linarith)
347-  have hBase : Tendsto (fun theta : ℝ => stdNormalCDFReal (-h * theta))
348-      atTop (nhds 0) := hCdfAtBot.comp hBaseArgument
