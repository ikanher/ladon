427-/-- Fixed-`h` center propagation for the exact finite trace.  A nonnegative
428-gap at one nonnegative boundary center becomes a strict positive gap at every
429-larger center. -/
430:theorem fixedEpochCenterGap_pos_of_boundary_nonneg
431-    (point : PoissonFixedEpochPoint) (h boundary query : ℝ)
432-    (hNonFull : point.epoch < point.horizon) (hh : 0 < h)
433-    (hBoundaryNonneg : 0 ≤ boundary) (hBoundaryQuery : boundary < query)
434:    (hBoundaryGap : 0 ≤ fixedEpochCenterGap point h boundary) :
435:    0 < fixedEpochCenterGap point h query := by
436-  apply gap_pos_of_boundary_nonneg
437:    (fixedEpochCenterGap point h)
438-    (fixedEpochCenterTilt point h)
439-    (fun theta => h * stdNormalPdfReal (h * theta))
440-    boundary query hBoundaryNonneg hBoundaryQuery
441-  · exact (fixedEpochCenterTilt_strictConvex point h hNonFull hh).convexOn.subset
442-      (by simp) (convex_Ici 0)
443-  · exact fixedEpochCenterTilt_zero_lt_one point h hNonFull hh
444-  · intro theta
445-    exact mul_pos hh (stdNormalPdfReal_pos _)
446:  · exact hasDerivAt_fixedEpochCenterGap point h
447-  · exact hBoundaryGap
448:  · exact tendsto_fixedEpochCenterGap_atTop_zero point h hh
