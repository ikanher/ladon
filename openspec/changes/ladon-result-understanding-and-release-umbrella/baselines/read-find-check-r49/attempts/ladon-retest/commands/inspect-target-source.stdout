312:theorem tendsto_fixedEpochCenterGap_atTop_zero
313-    (point : PoissonFixedEpochPoint) (h : ℝ) (hh : 0 < h) :
314:    Tendsto (fixedEpochCenterGap point h) atTop (nhds 0) := by
315-  have hCdfAtBot : Tendsto stdNormalCDFReal atBot (nhds 0) := by
316-    change Tendsto (ProbabilityTheory.cdf stdNormalMeasure) atBot (nhds 0)
317-    exact ProbabilityTheory.tendsto_cdf_atBot (μ := stdNormalMeasure)
318-  have hTrace (trace : ParticipationTrace point.horizon) : Tendsto
