5e2c6215beb7ed65352f301ff8fdbfaffadda6e01881a57af221"},"sourceFreshness":"not-assessed","statementAvailability":"supplied","status":"current","targetId":"hinge-nonnegative","typeText":"∀ (epoch complement : ℕ),\n  0 < epoch →\n    epoch ≤ complement →\n      ∀ (radius : ℝ), 0 ≤ radius → 0 ≤ Mf.DP.binomialSkewBoundary_boundaryDoubleCumulative epoch complement radius"},{"currentRevision":"sha256:13fdd87763a261c9e339134ea2b7b4bd1ed9c7ae1a65b2f64cf9682e546c4af7","hypotheses":{"reason":"no-structured-hypotheses-extraction","status":"unavailable"},"references":{"/resolution":{"appendPath":false,"input":"manifest","pointer":"/targets/19","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/source":{"input":"manifest","pointer":"/targets/19/source","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/typeText":{"input":"manifest","pointer":"/targets/19/typeText","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"requestedRevision":"sha256:13fdd87763a261c9e339134ea2b7b4bd1ed9c7ae1a65b2f64cf9682e546c4af7","resolution":{"checking":"not-assessed","name":"Mf.DP.FixedEpochBoundarySignedLaplace.boundaryDoubleCumulative_firstPositiveKnot_pos","projectRevisionBasis":"producer-declared","reason":"exact-stored-subject-environment-type-source","sourceAnchor":{"artifactId":"sha256:0545cff5f4fdf75254280cf7f4859c73e5e13770fc7d75de8172a61644969d60","basis":"environment-fingerprint","index":0},"sourceFreshness":"not-assessed","status":"resolved","subjectRef":{"artifactId":"sha256:945a7ca4973cc5926e7df3112dd5f5665023bfa2b35fd784e6889228d99cdd14","subjectId":"declaration:sha256:36ff14fc55972eac33cbafe767863778127257575567ce8a0125c7e59e0d753d"},"targetId":"hinge-positive","targetRevision":"sha256:13fdd87763a261c9e339134ea2b7b4bd1ed9c7ae1a65b2f64cf9682e546c4af7"},"reuseApplicability":"not-checked","source":{"digest":"sha256:7dc78cb19fb8d13f5448c66e16e2e5757acb70ec755ccfe73201eccc1871e4d4","path":"Mf/DP/PoissonFixedEpochBoundarySignedLaplace.lean","projectRevision":"capture-state:sha256:1d77098de2121f2333297e1d4369e26cad9cde2d4365ba158d1ed4ce2fcd9a5d"},"sourceFreshness":"not-assessed","statementAvailability":"supplied","status":"current","targetId":"hinge-positive","typeText":"∀ (epoch complement : ℕ),\n  0 < epoch →\n    epoch < complement →\n      have total := ↑epoch + ↑complement;\n      have boundary := (↑complement - ↑epoch) / (3 * total);\n      0 < Mf.DP.binomialSkewBoundary_boundaryDoubleCumulative epoch complement (1 - boundary)"},{"currentRevision":"sha256:37d60120ec4c1c981ccf7088ca18adaea2f825235430e7710fe9cdd529989092","hypotheses":{"reason":"no-structured-hypotheses-extraction","status":"unavailable"},"references":{"/resolution":{"appendPath":false,"input":"manifest","pointer":"/targets/17","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/source":{"input":"manifest","pointer":"/targets/17/source","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/typeText":{"input":"manifest","pointer":"/targets/17/typeText","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"requestedRevision":"sha256:37d60120ec4c1c981ccf7088ca18adaea2f825235430e7710fe9cdd529989092","resolution":{"checking":"not-assessed","name":"Mf.DP.binomialSkewBoundary_boundarySteinPolynomial_identity","projectRevisionBasis":"producer-declared","reason":"exact-stored-subject-environment-type-source","sourceAnchor":{"artifactId":"sha256:639d3f225e2e6eea141e261efe55a81cf2f45b842dc8eae6bcb1962fbe9ab234","basis":"environment-fingerprint","index":0},"sourceFreshness":"not-assessed","status":"resolved","subjectRef":{"artifactId":"sha256:33dc2904a6190b009eba9b0c0b4c0cfe525686ecdb73eb81d4b32a9160c42183","subjectId":"declaration:sha256:68c28f26f314de37fce67db094953ae90e27d57389fc22da46306f9e4dc0ef80"},"targetId":"polynomial","targetRevision":"sha256:37d60120ec4c1c981ccf7088ca18adaea2f825235430e7710fe9cdd529989092"},"reuseApplicability":"not-checked","source":{"digest":"sha256:8e78ca9846b6f614ac3fbac802fc8ed7cd1bfb7329d7faed0dfed216469528b9","path":"Mf/DP/PoissonFixedEpochBinomialSkewBoundary.lean","projectRevision":"capture-state:sha256:fbada67f54a8105fb1f19ebef27b2b8dd986bff6a8d8b0603d92febee3a8cd2f"},"sourceFreshness":"not-assessed","statementAvailability":"supplied","status":"current","targetId":"polynomial","typeText":"∀ (epoch complement : ℕ),\n  0 < epoch + complement →\n    ∀ (radius centered : ℝ),\n      have total := ↑epoch + ↑complement;\n      have rate := ↑epoch / total;\n      have complementRate := ↑complement / total;\n      have boundary := (↑complement - ↑epoch) / (3 * total);\n      have steinPotential := fun value =>\n        radius ^ 2 - 2 * ↑epoch * complementRate - 3 * boundary ^ 2 + value - value ^ 2;\n      (centered - boundary) * ((centered - boundary) ^ 2 - radius ^ 2) - boundary * (radius ^ 2 - boundary ^ 2) =\n        rate * (↑complement - centered) * steinPotential (centered + 1) -\n          complementRate * (↑epoch + centered) * steinPotential centered"}],"targetRevisions":[{"revision":"sha256:9af9796c9f9f7a7a2f3c11f833cd4b235a188c65d6cfc955aef12cbc726cf034","targetId":"hinge-nonnegative"},{"revision":"sha256:13fdd87763a261c9e339134ea2b7b4bd1ed9c7ae1a65b2f64cf9682e546c4af7","targetId":"hinge-positive"},{"revision":"sha256:37d60120ec4c1c981ccf7088ca18adaea2f825235430e7710fe9cdd529989092","targetId":"polynomial"}]},{"author":{"identity":"OpenAI Codex guide agents (field proposal and root revision)","kind":"model"},"authority":"attributed-annotation","claimId":"thm:accountant-limit","claimRevision":"sha256:fa568c1b36e683ed12deb097a7cac602850a9680a928ce3b36e1b9d2b53dfe5d","currency":"current","explanation":"The appendix gives a general fixed-participation privacy-profile limit and calibrated offset. The exposition compares it with the fixed-rate result cited from Räisä, Jälkö, and Honkela (2024), while explicitly explaining that fixed q>0 does not specialize to q=E/T without uniformity in q. The source-correspondence assessment describes schedule adapters; this is not an asserted direct identity between differently parameterized statements.","id":"fixed-participation-limit","identityAuthentication":"not-assessed","position":8,"prerequisites":[{"revision":"sha256:800a6f5130fc846856bf427b6bd31863dcf4bb179fe3b4bf9ee58ba30495a19c","stepId":"release-scope"}],"purpose":"Put the fixed-rate background in its proper place.","references":{"":{"input":"guide-inputs","pointer":"/steps/7","revision":"sha256:906319c5f9a7949f246d28f38e56f76fb8d9808265dd45788f0014117b0b5bce"},"/targetBindings":{"appendPath":false,"input":"guide-inputs","pointer":"/steps/7/targetRevisions","revision":"sha256:906319c5f9a7949f246d28f38e56f76fb8d9808265dd45788f0014117b0b5bce"}},"revision":"sha256:6c53e759f427b4e354de2550a3b0627c60afa46fe6a2bcaf9b330ecb91a64dbd","sources":[{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:accountant-limit"},{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:fixed-participation-calibration"},{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex:431 (section Scope of the conclusions)"}],"stepId":"fixed-participation-limit","targetBindings":[{"currentRevision":"sha256:38d1919ba72d0ae45f049ae988b026083a176ace1e5c334d4a451a574de43c75","hypotheses":{"reason":"no-structured-hypotheses-extraction","status":"unavailable"},"references":{"/resolution":{"appendPath":false,"input":"manifest","pointer":"/targets/22","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/source":{"input":"manifest","pointer":"/targets/22/source","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/typeText":{"input":"manifest","pointer":"/targets/22/typeText","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"requestedRevision":"sha256:38d1919ba72d0ae45f049ae988b026083a176ace1e5c334d4a451a574de43c75","resolution":{"checking":"not-assessed","name":"Mf.DP.tendsto_sampledGaussianProductProfileStddev_finiteOffset","projectRevisionBasis":"producer-declared","reason":"exact-stored-subject-environment-type-source","sourceAnchor":{"artifactId":"sha256:cbd6a6dd885d122c9a7c5a621895e3df0039f774a2f36ec32214fb3d5a01feeb","basis":"environment-fingerprint","index":0},"sourceFreshness":"not-assessed","status":"resolved","subjectRef":{"artifactId":"sha256:1f196d304bf170b6fdfe464bd184b8f9e303bad598a4e8e3015646f56fe4ada6","subjectId":"declaration:sha256:2a08314d37cb55aebd0afd742ebf2d0eb8eeba27dd573ad2fab86940483bb979"},"targetId":"profile-limit","targetRevision":"sha256:38d1919ba72d0ae45f049ae988b026083a176ace1e5c334d4a451a574de43c75"},"reuseApplicability":"not-checked","source":{"digest":"sha256:c2da34b048b1c5b37180a9e4da3cc6b62d89182628fa9b45e5eb773cd10b133d","path":"Mf/DP/FixedParticipationGaussianAccounting.lean","projectRevision":"capture-state:sha256:68213e5db068e5e56be5e88155ff4f3cdc808e4c03baddfa92973590b9466720"},"sourceFreshness":"not-assessed","statementAvailability":"supplied","status":"current","targetId":"profile-limit","typeText":"∀ (schedule : Mf.DP.FixedParticipationSchedule) (sensitivity : ℝ) (noiseStddev : ℕ → NNReal) (offset epsilon : ℝ),\n  0 < sensitivity →\n    0 ≤ epsilon →\n      (∀ᶠ (horizon : ℕ) in Filter.atTop, 0 < noiseStddev horizon) →\n        Filter.Tendsto (fun horizon => sensitivity / ↑(noiseStddev horizon) - Mf.DP.gaussianCriticalScale horizon)\n            Filter.atTop (nhds offset) →\n          Filter.Tendsto\n            (fun horizon =>\n              Mf.DP.sampledGaussianProductProfileStddev horizon (schedule.samplingRate horizon) ⋯ sensitivity\n                (noiseStddev horizon) epsilon)\n            Filter.atTop\n            (nhds (ENNReal.ofReal (1 - Real.exp (-↑schedule.participationBudget * Mf.DP.stdNormalCDFReal offset))))"}],"targetRevisions":[{"revision":"sha256:38d1919ba72d0ae45f049ae988b026083a176ace1e5c334d4a451a574de43c75","targetId":"profile-limit"}]},{"author":{"identity":"OpenAI Codex guide agents (field proposal and root revision)","kind":"model"},"authority":"attributed-annotation","claimId":"prop:average-uniform-bound","claimRevision":"sha256:98adfc1f05587ac23d55fa2bf1c0f1ee6c92d060f48da7fe21e2cb76381d8fe5","currency":"current","explanation":"The proposition gives a horizon-uniform upper bound for average-only calibrated variance. Alongside the sparse transcript theorem, it explains the manuscript’s comparison of output choices. The bound is presented as a feasibility estimate, not an asymptotic formula.","id":"average-only-bound","identityAuthentication":"not-assessed","position":9,"prerequisites":[{"revision":"sha256:6c53e759f427b4e354de2550a3b0627c60afa46fe6a2bcaf9b330ecb91a64dbd","stepId":"fixed-participation-limit"}],"purpose":"Distinguish bounded average calibration from transcript divergence.","references":{"":{"input":"guide-inputs","pointer":"/steps/8","revision":"sha256:906319c5f9a7949f246d28f38e56f76fb8d9808265dd45788f0014117b0b5bce"},"/targetBindings":{"appendPath":false,"input":"guide-inputs","pointer":"/steps/8/targetRevisions","revision":"sha256:906319c5f9a7949f246d28f38e56f76fb8d9808265dd45788f0014117b0b5bce"}},"revision":"sha256:4dadccd4619321d8e8af67275e6ab51f074f286cd7d1e11116e735bcf1557580","sources":[{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#prop:average-uniform-bound"},{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"l