Id":"propagation"}]},{"author":{"identity":"OpenAI Codex guide agents (field proposal and root revision)","kind":"model"},"authority":"attributed-annotation","claimId":"lem:binomial-double-cumulative","claimRevision":"sha256:1dc10cffe6bd81b1f5eda04b3211d97f132de164f36240d163c205066a7f5230","currency":"current","explanation":"The appendix rewrites the comparison as a Laplace integral of a hinge transform and uses a binomial telescoping identity to establish its sign and a strict positive knot. The formal targets cover the nonnegative and strict hinge statements and the polynomial identity. The guide does not independently validate the algebra or the exposition-to-target translations. The supplied correspondence uses radius √t for J(t), radius 1-c for its positive knot, and a sign change on both sides of the general-radius polynomial identity. These translation steps retain their attributed status.","id":"hinge-and-telescoping","identityAuthentication":"not-assessed","position":7,"prerequisites":[{"revision":"sha256:11298bc3fd608193879f0ddb0fd3cf2ff4ef634731825535b2ab863b42208be7","stepId":"center-propagation"}],"purpose":"Unpack the supporting discrete calculation.","references":{"":{"input":"guide-inputs","pointer":"/steps/6","revision":"sha256:906319c5f9a7949f246d28f38e56f76fb8d9808265dd45788f0014117b0b5bce"},"/targetBindings":{"appendPath":false,"input":"guide-inputs","pointer":"/steps/6/targetRevisions","revision":"sha256:906319c5f9a7949f246d28f38e56f76fb8d9808265dd45788f0014117b0b5bce"}},"revision":"sha256:daa367d1d367b9a530a3e651ad30556e594de351c1ec220062f40d525951ec57","sources":[{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:binomial-double-cumulative"},{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#le