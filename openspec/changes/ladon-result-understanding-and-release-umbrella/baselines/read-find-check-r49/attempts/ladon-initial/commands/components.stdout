rows: [{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"finite-properties","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"fullbatch","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"unresolved":1}},"statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"gaussian-and-average","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a","componentId":"transcript","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch","point-privacy","point-total"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/1/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/1/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"unresolved":3}},"statement":"\\begin{theorem}[Finite-horizon comparison]\\label{thm:rate-adaptive-pointwise}\nLet $T>E>0$ be integers, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n$a^2\\leq\\Lambda_{E,T}\\varepsilon$, then\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\\qquad\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S)\n \\quad(S\\geq0).\n\\]\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a","componentId":"closed-symmetric","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/1/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/1/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{theorem}[Finite-horizon comparison]\\label{thm:rate-adaptive-pointwise}\nLet $T>E>0$ be integers, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n$a^2\\leq\\Lambda_{E,T}\\varepsilon$, then\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\\qquad\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S)\n \\quad(S\\geq0).\n\\]\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a","componentId":"average","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/1/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/1/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{theorem}[Finite-horizon comparison]\\label{thm:rate-adaptive-pointwise}\nLet $T>E>0$ be integers, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n$a^2\\leq\\Lambda_{E,T}\\varepsilon$, then\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\\qquad\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S)\n \\quad(S\\geq0).\n\\]\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"cor:fixed-epoch-all-horizon","claimRevision":"sha256:0108f8bad055aabc20a15fde2fed178bec5d26a78e097a8113a6d68967beea83","componentId":"transcript","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#cor:fixed-epoch-all-horizon"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch","uniform-privacy","uniform-total"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/2","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/2/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/2/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"unresolved":3}},"statement":"\\begin{corollary}[All finite horizons]\\label{cor:fixed-epoch-all-horizon}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n\\begin{equation}\\label{eq:epoch-uniform-condition}\n a^2\\leq\\Lambda_E\\varepsilon,\\qquad \\Lambda_E=\\frac{6E}{3E+2},\n\\end{equation}\nthen for every integer $T>E$,\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, simultaneously for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{corollary}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"cor:fixed-epoch-all-horizon","claimRevision":"sha256:0108f8bad055aabc20a15fde2fed178bec5d26a78e097a8113a6d68967beea83","componentId":"average","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#cor:fixed-epoch-all-horizon"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/2","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/2/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/2/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{corollary}[All finite horizons]\\label{cor:fixed-epoch-all-horizon}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n\\begin{equation}\\label{eq:epoch-uniform-condition}\n a^2\\leq\\Lambda_E\\varepsilon,\\qquad \\Lambda_E=\\frac{6E}{3E+2},\n\\end{equation}\nthen for every integer $T>E$,\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, simultaneously for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{corollary}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:strict-interior-counterexample","claimRevision":"sha256:636c1150f4da72acb9f277996c4c41540d68c084dec5f7ed60943e53072b1d8b","componentId":"transcript","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:strict-interior-counterexample"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch","reversal-lower","reversal-total","reversal-upper"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/3","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/3/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/3/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"unresolved":4}},"statement":"\\begin{theorem}[An adjacent smaller batch can win]\\label{thm:strict-interior-counterexample}\nFor $\\Delta=1$, $E=2$, $\\varepsilon=1/4$, and $\\delta=3/4$, write\n$v_T=v_{2,T}$. Then\n\\[\n v_3\\leq\\frac5{32}<\\frac4{25}<v_2,\n \\qquad\n V_2(3,S)<V_2(2,S)\\quad\\text{for }0\\leq S\\leq\\frac9{400}.\n\\]\nThe same strict total-variance comparison holds for average-only calibration.\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:strict-interior-counterexample","claimRevision":"sha256:636c1150f4da72acb9f277996c4c41540d68c084dec5f7ed60943e53072b1d8b","componentId":"average","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:strict-interior-counterexample"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/3","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/3/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/3/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{theorem}[An adjacent smaller batch can win]\\label{thm:strict-interior-counterexample}\nFor $\\Delta=1$, $E=2$, $\\varepsilon=1/4$, and $\\delta=3/4$, write\n$v_T=v_{2,T}$. Then\n\\[\n v_3\\leq\\frac5{32}<\\frac4{25}<v_2,\n \\qquad\n V_2(3,S)<V_2(2,S)\\quad\\text{for }0\\leq S\\leq\\frac9{400}.\n\\]\nThe same strict total-variance comparison holds for average-only calibration.\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:smallbatch","claimRevision":"sha256:bf37f1efcf293770fba61f4b50f99a8a32d5f0425b9db71bb59e3c760afb9ec0","componentId":"offset","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:smallbatch"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["offset-limit"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/4","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/4/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/4/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"unresolved":1}},"statement":"\\begin{theorem}[Sparse transcript calibration]\\label{thm:smallbatch}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon\\geq0$, and\n\\begin{equation}\\label{eq:interior}\n 0<\\delta<1-e^{-E}.\n\\end{equation}\nThen, along integer horizons,\n\\[\n \\frac\\Delta{\\sigma_{E,T}}-\\sqrt{2\\log T}\n \\longrightarrow s_{E,\\delta}:=\n \\Phi^{-1}\\!\\left(-\\frac{\\log(1-\\delta)}E\\right).\n\\]\nConsequently,\n\\begin{align}\n \\sigma_{E,T}&\\sim\\frac\\Delta{\\sqrt{2\\log T}}\\longrightarrow0,\n \\label{eq:sigmaasymptotic}\\\\\n v_{E,T}&\\sim\\frac{\\Delta^2T}{2E^2\\log T}\\longrightarrow\\infty,\n \\label{eq:privacydivergence}\\\\\n V_E(T,S)&\\sim v_{E,T}\\qquad\\text{for each fixed }S\\geq0.\n \\label{eq:total-equivalent}\n\\end{align}\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:smallbatch","claimRevision":"sha256:bf37f1efcf293770fba61f4b50f99a8a32d5f0425b9db71bb59e3c760afb9ec0","componentId":"leading","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:smallbatch"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["raw-ratio","raw-zero","total-ratio","variance-infinity","variance-ratio"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/4","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/4/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/4/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"unresolved":5}},"statement":"\\begin{theorem}[Sparse transcript calibration]\\label{thm:smallbatch}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon\\geq0$, and\n\\begin{equation}\\label{eq:interior}\n 0<\\delta<1-e^{-E}.\n\\end{equation}\nThen, along integer horizons,\n\\[\n \\frac\\Delta{\\sigma_{E,T}}-\\sqrt{2\\log T}\n \\longrightarrow s_{E,\\delta}:=\n \\Phi^{-1}\\!\\left(-\\frac{\\log(1-\\delta)}E\\right).\n\\]\nConsequently,\n\\begin{align}\n \\sigma_{E,T}&\\sim\\frac\\Delta{\\sqrt{2\\log T}}\\longrightarrow0,\n \\label{eq:sigmaasymptotic}\\\\\n v_{E,T}&\\sim\\frac{\\Delta^2T}{2E^2\\log T}\\longrightarrow\\infty,\n \\label{eq:privacydivergence}\\\\\n V_E(T,S)&\\sim v_{E,T}\\qquad\\text{for each fixed }S\\geq0.\n \\label{eq:total-equivalent}\n\\end{align}\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"cor:eventual","claimRevision":"sha256:02f2bb6625d667b7dfca660d192372461093817fd1043929ee8cafc091e082e3","componentId":"uniform","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#cor:eventual"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["uniform-eventual"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/5","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/5/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/5/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"unresolved":1}},"statement":"\\begin{corollary}[One cutoff for all energies]\\label{cor:eventual}\nUnder the hypotheses of Theorem~\\ref{thm:smallbatch}, some integer $T_0>E$\nsatisfies $V_E(E,S)<V_E(T,S)$ for every $T\\geq T_0$ and every $S\\geq0$.\n\\end{corollary}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"prop:average-uniform-bound","claimRevision":"sha256:98adfc1f05587ac23d55fa2bf1c0f1ee6c92d060f48da7fe21e2cb76381d8fe5","componentId":"bound","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#prop:average-uniform-bound"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/6","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/6/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/6/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{proposition}[Average-only calibration stays bounded]\\label{prop:average-uniform-bound}\nFor integers $T\\geq E>0$, $\\Delta>0$, $\\varepsilon\\geq0$, and $0<\\delta<1$,\n\\[\n \\overline v_{E,T}\\leq\\frac{\\Delta^2}{2\\pi\\delta^2},\\qquad\n \\overline V_E(T,S)\\leq\\frac SE+\\frac{\\Delta^2}{2\\pi\\delta^2}\\quad(S\\geq0).\n\\]\n\\end{proposition}"}]
