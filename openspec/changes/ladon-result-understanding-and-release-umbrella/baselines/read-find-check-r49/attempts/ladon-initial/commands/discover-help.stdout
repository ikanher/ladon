usage: ladon proof-search discover [-h] [--repo-root REPO_ROOT]
                                   [--index INDEX_PATH] [--format {text,json}]
                                   [--output OUTPUT] [--progress]
                                   [--projection {llm,review,audit}]
                                   [--evidence-store EVIDENCE_STORE]
                                   [--max-evidence-store-mib MAX_EVIDENCE_STORE_MIB]
                                   [--require-isolation] --module MODULE
                                   --goal GOAL [--candidate CANDIDATE]
                                   [--pattern PATTERN] [--local LOCAL]
                                   [--max-candidates MAX_CANDIDATES]
                                   [--batch-size BATCH_SIZE]
                                   [--scope {closure,external,file,imports,module,namespace,neighborhood,project,repository}]
                                   [--root ROOT] [--freshness {stored,verify}]
                                   [--timeout-seconds TIMEOUT_SECONDS]
                                   [--max-output-mib MAX_OUTPUT_MIB]
                                   [--max-rss-mib MAX_RSS_MIB]
                                   [--toolchain-mode {ambient,explicit}]
                                   [--lake-path LAKE_PATH]
                                   [--lean-path LEAN_PATH]
                                   [--scratch-mode {none,advisory}]

options:
  -h, --help            show this help message and exit
  --repo-root REPO_ROOT
                        Lean repository owning the index.
  --index INDEX_PATH    Override the default <repo>/.ladon/index/proof-
                        search.sqlite path.
  --format {text,json}  Result representation.
  --output OUTPUT       Result path, or - for standard output.
  --progress            Write bounded JSON progress records to standard error.
  --projection {llm,review,audit}
                        Select compact LLM/review output backed by registered
                        evidence, or audit for the complete embedded ProofIR
                        payload.
  --evidence-store EVIDENCE_STORE
                        Override the repository-scoped user-cache semantic
                        evidence registry.
  --max-evidence-store-mib MAX_EVIDENCE_STORE_MIB
                        Maximum semantic evidence registry size in MiB;
                        defaults to 512.
  --require-isolation   Require target initializer isolation; fails closed
                        when unavailable.
  --module MODULE       Module used to check the goal; shortlist selection
                        uses --scope and --root.
  --goal GOAL
  --candidate CANDIDATE
  --pattern PATTERN     Type-text pattern used to build a bounded SQLite
                        shortlist.
  --local LOCAL         Ordered caller-local declaration NAME:TYPE; repeat for
                        dependent hypotheses.
  --max-candidates MAX_CANDIDATES
  --batch-size BATCH_SIZE
  --scope {closure,external,file,imports,module,namespace,neighborhood,project,repository}
  --root ROOT
  --freshness {stored,verify}
  --timeout-seconds TIMEOUT_SECONDS
  --max-output-mib MAX_OUTPUT_MIB
  --max-rss-mib MAX_RSS_MIB
  --toolchain-mode {ambient,explicit}
  --lake-path LAKE_PATH
  --lean-path LEAN_PATH
  --scratch-mode {none,advisory}
                        Skip scratch replay by default, or run at most one
                        independently attributed advisory replay.
