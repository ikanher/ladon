tributed-component-assessment","basis":"Inspected exact r05 source signatures and current mathematical derivation; model-attributed correspondence, not independent certification.","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"finite-properties","currency":"current","differences":[],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/0"],"id":"component-assessment-0","kind":"conventional-only","references":{"":{"input":"assessments","pointer":"/assessments/0","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"Continuity including zero, monotonicity, finite feasibility, attainment and target equality for both profiles","targetRevisions":[]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"finite-properties","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"assessmentStatus":"reported","assessments":[{"author":{"id":"OpenAI Codex, implementation agent","kind":"model"},"authority":"attributed-component-assessment","basis":"Inspected exact r05 source signatures and current mathematical derivation; model-attributed correspondence, not independent certification.","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"fullbatch","currency":"current","differences":[],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/1"],"id":"component-assessment-1","kind":"source-correspondence","references":{"":{"input":"assessments","pointer":"/assessments/1","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"Full-batch transcript variance equals the one-release Gaussian baseline","targetRevisions":[{"revision":"sha256:6f8a19b4b97612857818d6782d60f23e3519b6b9d55e4981e34c48843fba21fa","targetId":"fullbatch"}]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"fullbatch","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"resolved":1}},"statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"assessmentStatus":"reported","assessments":[{"author":{"id":"OpenAI Codex, implementation agent","kind":"model"},"authority":"attributed-component-assessment","basis":"Inspected exact r05 source signatures and current mathematical derivation; model-attributed correspondence, not independent certification.","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"gaussian-and-average","currency":"current","differences":[],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/2"],"id":"component-assessment-2","kind":"conventional-only","references":{"":{"input":"assessments","pointer":"/assessments/2","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"Analytic Gaussian formula/derivative and equality of full-batch average calibration","targetRevisions":[]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"gaussian-and-average","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"