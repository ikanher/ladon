ce signatures and current mathematical derivation; model-attributed correspondence, not independent certification.","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a","componentId":"transcript","currency":"current","differences":["Formal condition is strict at T=2E; closed elsewhere. Formal point packages E>0,T>=E. No attainment premise."],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/3"],"id":"component-assessment-3","kind":"source-correspondence","references":{"":{"input":"assessments","pointer":"/assessments/3","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"Strict transcript privacy and total variance comparison away from the symmetric equality","targetRevisions":[{"revision":"sha256:9282b5fa607890bf653cebfdec185279ada5f5fb778781c968597cdde42e70b1","targetId":"point-privacy"},{"revision":"sha256:bb517de2a7f00d1201af3f2d4de5472f35227dc125185fee19e7a934a4c3a865","targetId":"point-total"},{"revision":"sha256:6f8a19b4b97612857818d6782d60f23e3519b6b9d55e4981e34c48843fba21fa","targetId":"fullbatch"}]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a","componentId":"transcript","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch","point-privacy","point-total"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe