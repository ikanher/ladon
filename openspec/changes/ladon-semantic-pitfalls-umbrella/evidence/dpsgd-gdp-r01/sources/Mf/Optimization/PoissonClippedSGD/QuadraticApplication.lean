import Mf.Optimization.PoissonClippedSGD.UniformOutput
import Mf.Optimization.PoissonClippedSGD.Budget
import Mf.Optimization.FixedSubsetClippedSGD.QuadraticApplication

/-!
# Useful Poisson SGD bound for the balanced quadratic

Koloskova, Hendrikx and Stich, *Revisiting Gradient Clipping: Stochastic Bias
and Tight Convergence Guarantees * (2023), Appendix on mini-batches and privacy
noise, supplies the proof pattern of the imported convergence theorem. This
application reuses the concrete quadratic premises of the fixed-subset case,
with fresh Poisson masks, public expected batch size 8192, and the same physical
Gaussian scale. The step is separately retuned to 3999 / 1000. The output index
is independent and uniform among the 49 pre-update iterates.
-/

noncomputable section
namespace Mf.Optimization.PoissonClippedSGD.QuadraticApplication
open MeasureTheory
open Mf.Optimization.FixedSubsetClippedSGD.QuadraticApplication
open Mf.Optimization.FiniteMemoryAdam.QuadraticReachability

set_option maxRecDepth 65536

/-- The inclusion probability is the expected batch size divided by population. -/
def samplingProbability : NNReal := ⟨8192 / 50000, by norm_num⟩

theorem samplingProbability_coe : (samplingProbability : ℝ) = 8192 / 50000 := rfl

theorem samplingProbability_pos : 0 < samplingProbability := by
  rw [← NNReal.coe_pos, samplingProbability_coe]
  norm_num

theorem samplingProbability_le_one : samplingProbability ≤ 1 := by
  rw [← NNReal.coe_le_coe, samplingProbability_coe]
  norm_num

/-- The sampler normalizes by public B, including empty batches. -/
theorem expected_batch_size : (samplingProbability : ℝ) * 50000 = 8192 := by
  rw [samplingProbability_coe]
  norm_num

theorem count_variance_factor :
    (1-(samplingProbability:ℝ)) / ((samplingProbability:ℝ) * 50000) = 2613 / 25600000 := by
  rw [samplingProbability_coe]
  norm_num

/-- The retuned step satisfies the actual Poisson theorem's sufficient gate. -/
theorem step_gate : (3999 / 1000:ℝ) * (1 / 4) *
    (1 + (1-(samplingProbability:ℝ)) / ((samplingProbability:ℝ) * 50000)) ≤ 1 := by
  rw [count_variance_factor]
  norm_num

/-- The exact fresh Poisson / Gaussian experiment with independent output index. -/
def experimentLaw :=
  outputLaw 50000 100000 49 samplingProbability samplingProbability_le_one totalNoise

def experimentOutput :=
  output (T := 49) (3999 / 1000) samplingProbability (2 / 5) quadraticRecordGradient initialPoint

/-- Integrability is generated by the actual unbounded-noise trajectory law. -/
theorem output_norm_integrable :
    Integrable (fun p => ‖meanGradient (experimentOutput p)‖) experimentLaw := by
  have h := PoissonClippedSGD.output_norm_integrable (T := 49) (by norm_num : 0 < 50000)
    samplingProbability samplingProbability_pos samplingProbability_le_one
    (3999 / 1000) (2 / 5) totalNoise (1 / 4) (by norm_num) (by norm_num)
    quadraticRecordGradient quadraticRecordGradient_measurable initialPoint gradient_lipschitz
  simpa only [population_mean, experimentLaw, experimentOutput] using h

/-- Every model, sampling, noise and output premise is discharged. -/
theorem expected_norm_le_budget :
    (∫ p, ‖meanGradient (experimentOutput p)‖ ∂experimentLaw) ≤
      Real.sqrt retunedBudget + retunedBudget / (2 / 5) := by
  have hclip : 4 * Real.sqrt (99 / 10000) ≤ (2 / 5:ℝ) := by
    have hs := Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 99 / 10000)
    have hp := Real.sqrt_nonneg (99 / 10000:ℝ)
    nlinarith
  have h := uniform_output_convergence (by norm_num : 0 < 50000)
    (by norm_num : 0 < 100000)
    samplingProbability samplingProbability_pos samplingProbability_le_one
    (3999 / 1000) (1 / 4) (2 / 5) (Real.sqrt (99 / 10000)) totalNoise
    (by norm_num) (by norm_num) (by norm_num) (Real.sqrt_nonneg _)
    (by unfold totalNoise; positivity) hclip step_gate
    quadraticRecordGradient quadraticRecordGradient_measurable
    quadraticObjective (fun x => by rw [population_mean]; exact quadraticObjective_hasGradientAt x)
    gradient_lipschitz (fun x => by rw [raw_variance, Real.sq_sqrt (by norm_num)])
    (99 / 5000) objective_lower initialPoint 49 (by norm_num)
  simp only [population_mean, initial_gap, Nat.cast_ofNat] at h
  rw [count_variance_factor] at h
  simpa only [experimentLaw, experimentOutput, retunedBudget, totalNoise, coordinateNoise,
    Nat.cast_ofNat, show ((1-8192 / 50000) / 8192:ℝ) = 2613 / 25600000 by norm_num] using h

/-- Useful unconditional expected true-gradient norm for the retuned cell100. -/
theorem expected_norm_lt :
    (∫ p, ‖meanGradient (experimentOutput p)‖ ∂experimentLaw) < (22707 / 125000:ℝ) :=
  expected_norm_le_budget.trans_lt retunedBudget_ceiling

/-- The concrete Poisson output strictly improves on the initial true gradient. -/
theorem expected_norm_improves_initial :
    (∫ p, ‖meanGradient (experimentOutput p)‖ ∂experimentLaw) < ‖meanGradient initialPoint‖ := by
  have h := expected_norm_le_budget.trans_lt retunedBudget_improves_initial
  have hi : ‖meanGradient initialPoint‖ =
      Real.sqrt (2 * (1 / 4) * (318572823102549 / 500000000000000:ℝ)) := by
    rw [meanGradient, norm_smul, Real.norm_eq_abs]
    have hs := initial_norm_sq
    have hp := norm_nonneg initialPoint
    have ht := Real.sq_sqrt
      (by norm_num : (0:ℝ) ≤ 2 * (1 / 4) * (318572823102549 / 500000000000000))
    have hq := Real.sqrt_nonneg (2 * (1 / 4) * (318572823102549 / 500000000000000:ℝ))
    rw [abs_of_nonneg (by norm_num : (0:ℝ) ≤ 1 / 4)]
    nlinarith
  simpa [hi] using h

end Mf.Optimization.PoissonClippedSGD.QuadraticApplication
