import Mf.Optimization.FiniteMemoryAdam.CumulativeSupportedBiasUtility
import Mf.Optimization.FiniteMemoryAdam.CumulativeSupportedBiasNumericalBudget
import Mf.Optimization.FiniteMemoryAdam.CumulativeEnergyUsefulUtility

/-!
# Actual initialized Adam rate with supported clipping bias

The R22 independent review, Technical Appendix Sections 5–7, combines supported
historical bias with actual update energy. Every positive constant scaled step
is permitted, and the horizon-selected step is constant within its run. All
variance and exceptional coefficients are generated by the actual record,
mask and Gaussian model. No old numerical step interval is invoked.
-/
namespace Mf.Optimization.FiniteMemoryAdam.Cumulative.Energy
open MeasureTheory Finset LocalizedVector
open Mf.Optimization.FinitePoissonSign
noncomputable section

/-- Nonnegativity holds for the actual finite expected gradient measure. -/
theorem expectedSquaredGradient_nonneg {N d T : ℕ} {G L₂ Linf θ ρ : ℝ}
    (F : SmoothObjective d G L₂ Linf) (data : CenteredRecordFamily N d θ ρ)
    (η ζ : ℝ) (x0 : Point d) (q : NNReal) (hq : q ≤ 1) (σ : ℝ) :
    0 ≤ expectedSquaredGradient (T := T) F data η ζ x0 q hq σ := by
  unfold expectedSquaredGradient
  exact div_nonneg (sum_nonneg (fun t _ => integral_nonneg (fun ω => sq_nonneg _)))
    (Nat.cast_nonneg T)

theorem energyBudget_nonneg (N d : ℕ) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (σ θ ρ G rS rZ : ℝ) : 0 ≤ energyBudget N d q σ θ ρ G rS rZ := by
  have hqs : 0 ≤ 1-q := sub_nonneg.mpr hq1
  unfold energyBudget Heterogeneous.samplingFourthBudget
    Heterogeneous.querySecondEnvelope Heterogeneous.queryFourthEnvelope
  apply le_min zero_le_one
  positivity

/-- Fully generated common-step actual-law bound; large steps may be uninformative. -/
theorem supported_bias_physical_window_common_step {T : ℕ} {Linf θ ρ : ℝ}
    (F : SmoothObjective 100000 (1001/1000) 3 Linf)
    (data : CenteredRecordFamily 50000 100000 θ ρ)
    (hLip : ∀ x y, ‖F.gradient x-F.gradient y‖ ≤ 3*‖x-y‖)
    (hT : 16384 ≤ T) (hθ : θ ∈ Set.Icc 0 (38/100))
    (hρ : ρ ∈ Set.Icc 0 (5/1000)) (η : ℝ) (x0 : Point 100000) (hη : 0 < η)
    (hΔ : F.value x0-F.lower ≤ 501/1000)
    (q : NNReal) (hq : q ≤ 1) (hqr : (q:ℝ) ∈ Set.Icc (1/4) 1)
    (σ : ℝ) (hσ : σ ∈ Set.Icc 0 ((19/10)*physicalNoise)) :
    expectedSquaredGradient (T := T) F data η (1/100000000) x0 q hq σ ≤
      66967/(80000*(dimensionScale 100000*η)*T)+
      (49624411/64000)*(dimensionScale 100000*η)+
      4*Real.sqrt (releaseVariance 50000 100000 q σ θ ρ (1001/1000))+
      14*energyBudget 50000 100000 q σ θ ρ (1001/1000) (1/10) (1/10) := by
  have hs : 0 < dimensionScale 100000 := dimensionScale_pos (by norm_num)
  have hq0 : 0 < q := by exact_mod_cast (show (0:ℝ)<q by linarith [hqr.1])
  have hu := model_expected_supported_bias_utility (T := T) F data (by norm_num) (by norm_num)
    (by omega) hθ hρ (by norm_num) (L := 3) (by norm_num) hLip
    η (1/100000000) (1/10) (1/10) x0 hη (by norm_num) (by norm_num) (by norm_num) q hq hq0 σ
  have hH0 : 0 < denominatorCeiling 100000 (1001/1000) (1/100000000) (1/10) (1/10) := by
    unfold denominatorCeiling; positivity
  have hH : denominatorCeiling 100000 (1001/1000) (1/100000000) (1/10) (1/10) ≤ 1203/1000 := by
    unfold denominatorCeiling; linarith [physical_stabilizer_scaled]
  have hJ0 : 0 ≤ expectedUpdateEnergy (T := T) F data η (1/100000000) x0 q hq σ :=
    integral_nonneg (fun ω => pathUpdateEnergy_nonneg _ _)
  have hJ := physical_window_expected_energy_le F data hT hθ hρ η x0 hη.ne' q hq hqr σ hσ
  apply supported_common_step_budget hT (mul_pos (dimensionScale_pos (by norm_num)) hη) hH0 hH
    (sub_nonneg.mpr (F.lower_bound x0)) hΔ
    (releaseVariance_nonneg 50000 100000 q.coe_nonneg hqr.2 σ θ ρ (1001/1000))
    (energyBudget_nonneg 50000 100000 q.coe_nonneg hqr.2 σ θ ρ (1001/1000) (1/10) (1/10))
    hJ0 hJ (expectedSquaredGradient_nonneg F data η (1/100000000) x0 q hq σ)
  convert hu using 1 <;> first | rfl | (simp only [pairingGain, residualCost, exceptionalCost]; ring)

/-- The physical step is selected once from the horizon, not updated during a run. -/
def horizonPhysicalStep (d T : ℕ) : ℝ := horizonScaledStep T / dimensionScale d

theorem horizonPhysicalStep_pos {d T : ℕ} (hd : 0 < d) (hT : 0 < T) :
    0 < horizonPhysicalStep d T := div_pos (horizonScaledStep_pos hT) (dimensionScale_pos hd)

theorem horizonPhysicalStep_scaled {d T : ℕ} (hd : 0 < d) :
    dimensionScale d*horizonPhysicalStep d T = horizonScaledStep T := by
  unfold horizonPhysicalStep
  field_simp [(dimensionScale_pos hd).ne']

/-- Parameterized rate for the actual horizon-indexed constant-step family. -/
theorem supported_bias_physical_window_rate {T : ℕ} {Linf θ ρ : ℝ}
    (F : SmoothObjective 100000 (1001/1000) 3 Linf)
    (data : CenteredRecordFamily 50000 100000 θ ρ)
    (hLip : ∀ x y, ‖F.gradient x-F.gradient y‖ ≤ 3*‖x-y‖)
    (hT : 16384 ≤ T) (hθ : θ ∈ Set.Icc 0 (38/100))
    (hρ : ρ ∈ Set.Icc 0 (5/1000)) (x0 : Point 100000)
    (hΔ : F.value x0-F.lower ≤ 501/1000)
    (q : NNReal) (hq : q ≤ 1) (hqr : (q:ℝ) ∈ Set.Icc (1/4) 1)
    (σ : ℝ) (hσ : σ ∈ Set.Icc 0 ((19/10)*physicalNoise)) :
    expectedSquaredGradient (T := T) F data (horizonPhysicalStep 100000 T)
      (1/100000000) x0 q hq σ ≤ 51/Real.sqrt (T:ℝ)+
      4*Real.sqrt (releaseVariance 50000 100000 q σ θ ρ (1001/1000))+
      14*energyBudget 50000 100000 q σ θ ρ (1001/1000) (1/10) (1/10) := by
  have ht : 0<T := by omega
  have hu := supported_bias_physical_window_common_step F data hLip hT hθ hρ
    (horizonPhysicalStep 100000 T) x0 (horizonPhysicalStep_pos (by norm_num) ht) hΔ q hq hqr σ hσ
  rw [horizonPhysicalStep_scaled (by norm_num)] at hu
  linarith [horizon_step_budget_le ht]

/-- The complete stochastic window has a strict half ceiling at every allowed horizon. -/
theorem supported_bias_window_ceiling {T : ℕ} (hT : 16384 ≤ T) {V π : ℝ}
    (hV : V ≤ 513/1000000) (hπ : π ≤ 553/1000000) :
    51/Real.sqrt (T:ℝ)+4*Real.sqrt V+14*π ≤ 993959/2000000 := by
  have htR : (16384:ℝ) ≤ T := by exact_mod_cast hT
  have hr : (128:ℝ) ≤ Real.sqrt (T:ℝ) := by
    apply Real.le_sqrt_of_sq_le
    norm_num
    exact_mod_cast hT
  have hs : Real.sqrt V ≤ 227/10000 := by
    apply Real.sqrt_le_iff.mpr
    norm_num
    linarith
  have hi : (51:ℝ)/Real.sqrt (T:ℝ) ≤ 51/128 := by gcongr
  linarith

/-- Integrable independent pre-update output, with the rate and complete window ceiling. -/
theorem supported_bias_output_rate {T : ℕ} [NeZero T] {Linf θ ρ : ℝ}
    (F : SmoothObjective 100000 (1001/1000) 3 Linf)
    (data : CenteredRecordFamily 50000 100000 θ ρ)
    (hLip : ∀ x y, ‖F.gradient x-F.gradient y‖ ≤ 3*‖x-y‖)
    (hT : 16384 ≤ T) (hθ : θ ∈ Set.Icc 0 (38/100))
    (hρ : ρ ∈ Set.Icc 0 (5/1000)) (x0 : Point 100000)
    (hΔ : F.value x0-F.lower ≤ 501/1000)
    (q : NNReal) (hq : q ≤ 1) (hqr : (q:ℝ) ∈ Set.Icc (1/4) 1)
    (σ : ℝ) (hσ : σ ∈ Set.Icc 0 ((19/10)*physicalNoise)) :
    Integrable (outputProgress F data (horizonPhysicalStep 100000 T) (1/100000000) q x0)
      (outputLaw 50000 100000 T q hq σ) ∧
    (∫ p, outputProgress F data (horizonPhysicalStep 100000 T) (1/100000000) q x0 p
      ∂outputLaw 50000 100000 T q hq σ) ≤ 51/Real.sqrt (T:ℝ)+
      4*Real.sqrt (releaseVariance 50000 100000 q σ θ ρ (1001/1000))+
      14*energyBudget 50000 100000 q σ θ ρ (1001/1000) (1/10) (1/10) ∧
    (∫ p, outputProgress F data (horizonPhysicalStep 100000 T) (1/100000000) q x0 p
      ∂outputLaw 50000 100000 T q hq σ) ≤ 993959/2000000 := by
  refine ⟨outputProgress_integrable F data (by norm_num) (by norm_num)
    _ _ x0 (by norm_num) q hq σ, ?_⟩
  rw [output_integral_average F data (by norm_num) (by norm_num)
    (horizonPhysicalStep 100000 T) (1/100000000) x0 (by norm_num) q hq σ]
  have hu := supported_bias_physical_window_rate F data hLip hT hθ hρ x0 hΔ q hq hqr σ hσ
  refine ⟨hu, hu.trans ?_⟩
  exact supported_bias_window_ceiling hT
    (releaseVariance_safe (G := 1001/1000) hqr hθ hρ (by norm_num) (physical_noise_window_scaled hσ))
    (energyBudget_safe (G := 1001/1000) hqr hθ hρ (by norm_num) (physical_noise_window_scaled hσ))

end
end Mf.Optimization.FiniteMemoryAdam.Cumulative.Energy
