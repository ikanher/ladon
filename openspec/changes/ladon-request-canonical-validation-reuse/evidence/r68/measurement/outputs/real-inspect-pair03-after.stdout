ter":"/targets/4/revision","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/formalStatements/2/typeText":{"input":"manifest","pointer":"/targets/4/typeText","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mappingSources":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/2/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/wholeClaimStatement":{"input":"manifest","pointer":"/claims/2/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"resolved":3}},"statement":"\\begin{corollary}[All finite horizons]\\label{cor:fixed-epoch-all-horizon}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n\\begin{equation}\\label{eq:epoch-uniform-condition}\n a^2\\leq\\Lambda_E\\varepsilon,\\qquad \\Lambda_E=\\frac{6E}{3E+2},\n\\end{equation}\nthen for every integer $T>E$,\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, simultaneously for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{corollary}","statementScope":"whole-claim-context","wholeClaimStatement":"\\begin{corollary}[All finite horizons]\\label{cor:fixed-epoch-all-horizon}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n\\begin{equation}\\label{eq:epoch-uniform-condition}\n a^2\\leq\\Lambda_E\\varepsilon,\\qquad \\Lambda_E=\\frac{6E}{3E+2},\n\\end{equation}\nthen for every integer $T>E$,\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, simultaneously for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{corollary}"}],"schema":"ladon-result-inspection-v1","section":"components","status":"inspected"}
