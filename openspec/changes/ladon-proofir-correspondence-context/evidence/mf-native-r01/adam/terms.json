[
  {
    "obligation": "interpretation",
    "mode": "prove",
    "term": "by intro h; exact h"
  },
  {
    "obligation": "object-map",
    "mode": "prove",
    "term": "by intro a; trivial"
  },
  {
    "obligation": "conclusion",
    "mode": "prove",
