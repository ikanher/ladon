[
  {
    "obligation": "interpretation",
    "mode": "prove",
    "term": "by intro h; exact h"
  },
  {
    "obligation": "object-map",
    "mode": "prove",
    "term": "by intro i; trivial"
  },
  {
    "obligation": "premise-1",
    "mode": "prove",
    "term": "by intro i; dsimp; intro h; exact i.isLt"
  },
  {
    "obligation": "conclusion",
    "mode": "prove",
    "term": "by intro i; dsimp; intro h formal; exact formal"
  }
