rho\\right).\n\\]\nFor the capped exact-budget schedule $q_T=\\min\\{1,\\rho/T\\}$, it follows that\n\\[\n \\frac{\\sigma_T^{\\mathrm{cal}}\\sqrt{2\\log(1/q_T)}}\\Delta\\longrightarrow1.\n\\]\n\\end{theorem}"},{"assessmentStatus":"reported","assessments":[{"author":{"id":"OpenAI Codex, implementation agent","kind":"model"},"authority":"attributed-component-assessment","basis":"Inspected exact r05 source signatures and current mathematical derivation; model-attributed correspondence, not independent certification.","claimId":"thm:fixed-participation-calibration","claimRevision":"sha256:29a94d4c6ed0af007291954680e81c57324c961be2adf9298233ef2e8a1240e0","componentId":"capped","currency":"current","differences":[],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/24"],"id":"component-assessment-24","kind":"source-correspondence","references":{"":{"input":"assessments","pointer":"/assessments/24","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"Capped-schedule first-order ratio","targetRevisions":[{"revision":"sha256:8fbee428c02d0a4ece60971ebb428717cf46e72285f1b5fcda2490900d87161e","targetId":"capped-ratio"}]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:fixed-participation-calibration","claimRevision":"sha256:29a94d4c6ed0af007291954680e81c57324c961be2adf9298233ef2e8a1240e0","componentId":"capped","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:fixed-participation-calibration"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["capped-ratio"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/14","revision":"sha256:872c241d73ea74763320085ad53169636