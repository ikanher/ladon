3dfe5d","componentId":"profile","currency":"current","differences":["Formal profile is ENNReal-valued with finite ofReal limit; schedule packages rho>0, q in [0,1], and Tq->rho."],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/22"],"id":"component-assessment-22","kind":"source-correspondence","references":{"":{"input":"assessments","pointer":"/assessments/22","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"General fixed-participation exact profile limit","targetRevisions":[{"revision":"sha256:38d1919ba72d0ae45f049ae988b026083a176ace1e5c334d4a451a574de43c75","targetId":"profile-limit"}]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:accountant-limit","claimRevision":"sha256:fa568c1b36e683ed12deb097a7cac602850a9680a928ce3b36e1b9d2b53dfe5d","componentId":"profile","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:accountant-limit"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["profile-limit"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/13","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/13/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/13/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"resolved":1}},"statement":"\\begin{theorem}[The fixed-participation profile limit]\\label{thm:accountant-limit}\nLet $\\rho>0$, $\\Delta>0$, and $\\varepsilon\\geq0$. Suppose\n$q_T\\in[0,1]$, $Tq_T\\to\\rho$, $\\sigma_T>0$ eventually, and\n\\[\n \\frac{\\Delta}{\\sigma_T}-\\sqrt{2\\log T}\\longrightarrow s\\in\\R.\n\\]\nThen\n\\[\n \\AO_S(\\sigma_T,\\Delta,q_T,T,\\varepsilon)\n \\longrightarrow1-\\exp\\{-\\rho\\Phi(s)\\}.\n\\]\n\\end{theorem}"},{"assessmentStatus":"reported","assessments":[{"author":{"id":"OpenAI Codex, implementation agent","kind":"model"},"authority":"attributed-component-assessment","basis":"Inspected exact r05 source signatures and current mathematical derivation; model-attributed correspondence, not independent certification.","claimId":"thm:fixed-participation-calibration","claimRevision":"sha256:29a94d4c6ed0af007291954680e81c57324c961be2adf9298233ef2e8a1240e0","componentId":"offset","currency":"current","differences":[],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/23"],"id":"component-assessment-23","kind":"source-correspondence","references":{"":{"input":"assessments","pointer":"/assessments/23","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"General calibrated offset","targetRevisions":[{"revision":"sha256:5143027dee53cad453059af2bde568d23cac14c8c71dcb5de336535e3faed83b","targetId":"offset-limit"}]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:fixed-participation-calibration","claimRevision":"sha256:29a94d4c6ed0af007291954680e81c57324c961be2adf9298233ef2e