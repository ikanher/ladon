2aa0301e5d3cd8a0d2ae4579","componentId":"polynomial","currency":"current","differences":["Set complement=T-E and radius=R; negate both sides of the formal identity. The formal identity allows arbitrary positive total and does not require low rate."],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/17"],"id":"component-assessment-17","kind":"source-correspondence","references":{"":{"input":"assessments","pointer":"/assessments/17","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"General-radius polynomial identity for all real R,z in the low-rate context.","targetRevisions":[{"revision":"sha256:37d60120ec4c1c981ccf7088ca18adaea2f825235430e7710fe9cdd529989092","targetId":"polynomial"}]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:binomial-stein-polynomial","claimRevision":"sha256:74340e6f05c8612f26cb6e759f87be49a49c86622aa0301e5d3cd8a0d2ae4579","componentId":"polynomial","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:binomial-stein-polynomial"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["polynomial"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/9","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/9/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/9/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"resolved":1}},"statement":"\\begin{lemma}[A binomial telescoping identity]\\label{lem:binomial-stein-polynomial}\nPut $C=T-E$. For any real $R$, define\n\\[\n A_R(z)=R^2-2Er-3c^2+z-z^2.\n\\]\nThen for every $z\\in\\R$,\n\\begin{equation}\\label{eq:binomial-cubic-stein-polynomial}\n \\begin{split}\n &(z-c)\\{R^2-(z-c)^2\\}+c(R^2-c^2)\\\\\n &\\hspace{2em}=r(E+z)A_R(z)-p(C-z)A_R(z+1).\n \\end{split}\n\\end{equation}\n\\end{lemma}"}],"schema":"ladon-result-inspection-v1","section":"components","status":"inspected"}
