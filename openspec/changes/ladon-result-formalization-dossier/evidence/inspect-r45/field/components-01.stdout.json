delta}:=\n \\Phi^{-1}\\!\\left(-\\frac{\\log(1-\\delta)}E\\right).\n\\]\nConsequently,\n\\begin{align}\n \\sigma_{E,T}&\\sim\\frac\\Delta{\\sqrt{2\\log T}}\\longrightarrow0,\n \\label{eq:sigmaasymptotic}\\\\\n v_{E,T}&\\sim\\frac{\\Delta^2T}{2E^2\\log T}\\longrightarrow\\infty,\n \\label{eq:privacydivergence}\\\\\n V_E(T,S)&\\sim v_{E,T}\\qquad\\text{for each fixed }S\\geq0.\n \\label{eq:total-equivalent}\n\\end{align}\n\\end{theorem}"},{"assessmentStatus":"reported","assessments":[{"author":{"id":"OpenAI Codex, implementation agent","kind":"model"},"authority":"attributed-component-assessment","basis":"Inspected exact r05 source signatures and current mathematical derivation; model-attributed correspondence, not independent certification.","claimId":"cor:eventual","claimRevision":"sha256:02f2bb6625d667b7dfca660d192372461093817fd1043929ee8cafc091e082e3","componentId":"uniform","currency":"current","differences":["Translate eventual extra to integer T>=T0 and enlarge cutoff to T0>E."],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/12"],"id":"component-assessment-12","kind":"source-correspondence","references":{"":{"input":"assessments","pointer":"/assessments/12","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"One eventual cutoff for every nonnegative energy","targetRevisions":[{"revision":"sha256:8a2f73ac46e844d9911eef871aff0ecdd666882520a00ba2da1afee316c9f3b1","targetId":"uniform-eventual"}]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"cor:eventual","claimRevision":"sha256:02f2bb6625d667b7dfca660d192372461093817fd1043929ee8cafc091e082e3","componentId":"uniform","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_