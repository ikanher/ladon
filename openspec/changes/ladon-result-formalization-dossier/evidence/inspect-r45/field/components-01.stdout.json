age-uniform-bound}\nFor integers $T\\geq E>0$, $\\Delta>0$, $\\varepsilon\\geq0$, and $0<\\delta<1$,\n\\[\n \\overline v_{E,T}\\leq\\frac{\\Delta^2}{2\\pi\\delta^2},\\qquad\n \\overline V_E(T,S)\\leq\\frac SE+\\frac{\\Delta^2}{2\\pi\\delta^2}\\quad(S\\geq0).\n\\]\n\\end{proposition}"},{"assessmentStatus":"reported","assessments":[{"author":{"id":"OpenAI Codex, implementation agent","kind":"model"},"authority":"attributed-component-assessment","basis":"Inspected exact r05 source signatures and current mathematical derivation; model-attributed correspondence, not independent certification.","claimId":"thm:rate-adaptive-center","claimRevision":"sha256:5ec94143a489a958a3ff42a4e23ff1db84712481f7f73c79fe7f84f17294fd47","componentId":"positive","currency":"current","differences":["Trace average regrouped as binomial count; theta and positive scale identified."],"evidenceRefs":["sha256:58530882c214bcaf0a339523ac0af6e20a22802e0e20ce987cf30f96389e8e55#/components/14"],"id":"component-assessment-14","kind":"source-correspondence","references":{"":{"input":"assessments","pointer":"/assessments/14","revision":"sha256:c465e7b5f5f8504758266a657ce694b13037f5a130c162da3cf5934608c86404"}},"reviewerAuthentication":"not-assessed","scope":"Three rate-dependent positivity domains","targetRevisions":[{"revision":"sha256:f55d8398d4ababee950940b561609abe10c110f127733a4c9c0ed6e34b0b2aff","targetId":"center-positive"}]}],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-center","claimRevision":"sha256:5ec94143a489a958a3ff42a4e23ff1db84712481f7f73c79fe7f84f17294fd47","componentId":"positive","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-center"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["center-pos