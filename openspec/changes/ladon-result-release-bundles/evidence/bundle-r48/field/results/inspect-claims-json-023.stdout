{"availableSections":["components","claims","targets","reviews","assessments","checking","assumptions","lineage","evidence"],"axes":{"attribution":"not-assessed","checking":"stored-operations-only","correspondence":"attributed-reviews-only","environment":"per-target-and-check","exposition":"not-assessed","sourceFreshness":"not-assessed"},"coverage":{"canonicalResolution":{"resolved":25},"claimInventory":{"coverage":"complete","scope":"Every theorem, lemma, proposition and corollary environment in the final TeX, with components distinguishing transcript statements, conventional average-only extensions and translations. Does not inventory every equation, definition or proof step. Links carry the existing model-attributed source correspondence; exact stored target resolution does not establish informal equivalence."},"proofCoverage":"unknown","transitiveTrust":"unknown"},"inputBinding":"sha256:e83809e90d9ed2c5a725872992aaf8640336683b8dcff3d91d08ac4c5253ebcb","inspectionScope":"offline-supplied-evidence","limitations":["inspection-does-not-run-checks","mapping-does-not-establish-equivalence","integrity-does-not-authenticate-producer","unknown-trust-is-not-absence"],"operation":"inspect","pagination":{"nextCursor":"eyJiaW5kaW5nIjoic2hhMjU2OmU4MzgwOWU5MGQ5ZWQyYzVhNzI1ODcyOTkyYWFmODY0MDMzNjY4M2I4ZGNmZjNkOTFkMDhhYzRjNTI1M2ViY2IiLCJvZmZzZXQiOjV9.25ab6cca9fa4573a42807d7f567d022d6f4537e1ac044d92bd13e0ae01069a5a","offset":0,"omitted":10,"returned":5,"total":15},"query":{"claim":null,"limit":5,"section":"claims","target":null},"references":{"/coverage/claimInventory":{"input":"manifest","pointer":"/claimInventory","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resultId":"poisson-fixed-epoch-exposition-20261003-r02","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3","rows":[{"authority":"producer-supplied-statement","claimId":"lem:calibration","components":["finite-properties","fullbatch","gaussian-and-average"],"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"id":"lem:calibration","references":{"":{"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"revision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"authority":"producer-supplied-statement","claimId":"thm:rate-adaptive-pointwise","components":["transcript","closed-symmetric","average"],"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-pointwise"},"id":"thm:rate-adaptive-pointwise","references":{"":{"input":"manifest","pointer":"/claims/1","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"revision":"sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a","statement":"\\begin{theorem}[Finite-horizon comparison]\\label{thm:rate-adaptive-pointwise}\nLet $T>E>0$ be integers, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n$a^2\\leq\\Lambda_{E,T}\\varepsilon$, then\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\\qquad\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S)\n \\quad(S\\geq0).\n\\]\n\\end{theorem}"},{"authority":"producer-supplied-statement","claimId":"cor:fixed-epoch-all-horizon","components":["transcript","average"],"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#cor:fixed-epoch-all-horizon"},"id":"cor:fixed-epoch-all-horizon","references":{"":{"input":"manifest","pointer":"/claims/2","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"revision":"sha256:0108f8bad055aabc20a15fde2fed178bec5d26a78e097a8113a6d68967beea83","statement":"\\begin{corollary}[All finite horizons]\\label{cor:fixed-epoch-all-horizon}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n\\begin{equation}\\label{eq:epoch-uniform-condition}\n a^2\\leq\\Lambda_E\\varepsilon,\\qquad \\Lambda_E=\\frac{6E}{3E+2},\n\\end{equation}\nthen for every integer $T>E$,\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, simultaneously for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{corollary}"},{"authority":"producer-supplied-statement","claimId":"thm:strict-interior-counterexample","components":["transcript","average"],"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:strict-interior-counterexample"},"id":"thm:strict-interior-counterexample","references":{"":{"input":"manifest","pointer":"/claims/3","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"revision":"sha256:636c1150f4da72acb9f277996c4c41540d68c084dec5f7ed60943e53072b1d8b","statement":"\\begin{theorem}[An adjacent smaller batch can win]\\label{thm:strict-interior-counterexample}\nFor $\\Delta=1$, $E=2$, $\\varepsilon=1/4$, and $\\delta=3/4$, write\n$v_T=v_{2,T}$. Then\n\\[\n v_3\\leq\\frac5{32}<\\frac4{25}<v_2,\n \\qquad\n V_2(3,S)<V_2(2,S)\\quad\\text{for }0\\leq S\\leq\\frac9{400}.\n\\]\nThe same strict total-variance comparison holds for average-only calibration.\n\\end{theorem}"},{"authority":"producer-supplied-statement","claimId":"thm:smallbatch","components":["offset","leading"],"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:smallbatch"},"id":"thm:smallbatch","references":{"":{"input":"manifest","pointer":"/claims/4","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"revision":"sha256:bf37f1efcf293770fba61f4b50f99a8a32d5f0425b9db71bb59e3c760afb9ec0","statement":"\\begin{theorem}[Sparse transcript calibration]\\label{thm:smallbatch}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon\\geq0$, and\n\\begin{equation}\\label{eq:interior}\n 0<\\delta<1-e^{-E}.\n\\end{equation}\nThen, along integer horizons,\n\\[\n \\frac\\Delta{\\sigma_{E,T}}-\\sqrt{2\\log T}\n \\longrightarrow s_{E,\\delta}:=\n \\Phi^{-1}\\!\\left(-\\frac{\\log(1-\\delta)}E\\right).\n\\]\nConsequently,\n\\begin{align}\n \\sigma_{E,T}&\\sim\\frac\\Delta{\\sqrt{2\\log T}}\\longrightarrow0,\n \\label{eq:sigmaasymptotic}\\\\\n v_{E,T}&\\sim\\frac{\\Delta^2T}{2E^2\\log T}\\longrightarrow\\infty,\n \\label{eq:privacydivergence}\\\\\n V_E(T,S)&\\sim v_{E,T}\\qquad\\text{for each fixed }S\\geq0.\n \\label{eq:total-equivalent}\n\\end{align}\n\\end{theorem}"}],"schema":"ladon-result-inspection-v1","section":"claims","status":"inspected"}
