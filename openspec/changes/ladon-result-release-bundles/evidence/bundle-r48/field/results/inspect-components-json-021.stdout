d":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"finite-properties","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"fullbatch","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"resolved":1}},"statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:13b61b0fcfaa45b01572aa7643711e7ce8ff724346c26e73bb8377867b31ddc5","componentId":"gaussian-and-average","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{lemma}[Calibration]\\label{lem:calibration}\nFor each finite admissible horizon, both profiles are continuous and\nnonincreasing in $v\\geq0$. Their feasible sets are nonempty and their minima\nare attained. At a positive minimum the profile equals $\\delta$.\nAt full batch the two calibrated variances agree at a positive value\n$v_{\\mathrm{FB}}$ independent of $E$. Writing $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$,\n\\begin{equation}\\label{eq:gaussian-calibration}\n \\delta=G_\\varepsilon(a):=\n \\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right),\\qquad\n G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0.\n\\end{equation}\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a","componentId":"transcript","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch","point-privacy","point-total"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/1/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/1/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{"resolved":3}},"statement":"\\begin{theorem}[Finite-horizon comparison]\\label{thm:rate-adaptive-pointwise}\nLet $T>E>0$ be integers, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n$a^2\\leq\\Lambda_{E,T}\\varepsilon$, then\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\\qquad\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S)\n \\quad(S\\geq0).\n\\]\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:6983fd980402da76a16369679ae90faa0a462a01d51181873f158e269ba8042a","componentId":"closed-symmetric","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:d3b6b9dceb8dc3465120abbc6c89133ad5f754eb13c4918d3a10e8cc9d28f583","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_exposition.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/document":{"input":"manifest","pointer":"/claims/1/document","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"},"/statement":{"input":"manifest","pointer":"/claims/1/statement","revision":"sha256:872c241d73ea74763320085ad53169636f67a92bfe18de9e24309ce9e7e2bac3"}},"resolution":{"statuses":{}},"statement":"\\begin{theorem}[Finite-horizon comparison]\\label{thm:rate-adaptive-pointwise}\nLet $T>E>0$ be integers, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$.\nIf $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$ satisfies\n$a^2\\leq\\Lambda_{E,T}\\varepsilon$, then\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\\qquad\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S)\n \\quad(S\\geq0).\n\\]\n\\end{theorem}"}],"schema":"ladon-result-inspection-v1","section":"components","status":"inspected"}
