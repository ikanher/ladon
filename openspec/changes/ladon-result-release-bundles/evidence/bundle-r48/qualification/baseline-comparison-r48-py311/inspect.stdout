{"availableSections":["components","claims","targets","reviews","assessments","checking","assumptions","lineage","evidence"],"axes":{"attribution":"not-assessed","checking":"stored-operations-only","correspondence":"attributed-reviews-only","environment":"per-target-and-check","exposition":"not-assessed","sourceFreshness":"not-assessed"},"coverage":{"canonicalResolution":{"unresolved":20},"claimInventory":{"coverage":"complete","scope":"Every theorem/lemma/proposition/corollary environment in the captured TeX; excludes unboxed claims and proof-step assertions. Mathematical component boundaries are model-authored; mappings are partial, not independently certified."},"proofCoverage":"unknown","transitiveTrust":"unknown"},"inputBinding":"sha256:3a74f16a026f89f53ce5b55e50d4281ae8bdfb9f8b5aec449e377b9d77115a5f","inspectionScope":"offline-supplied-evidence","limitations":["inspection-does-not-run-checks","mapping-does-not-establish-equivalence","integrity-does-not-authenticate-producer","unknown-trust-is-not-absence"],"operation":"inspect","pagination":{"nextCursor":"eyJiaW5kaW5nIjoic2hhMjU2OjNhNzRmMTZhMDI2Zjg5ZjUzY2U1YjU1ZTUwZDQyODFhZThiZGZiOWY4YjVhZWM0NDllMzc3YjlkNzcxMTVhNWYiLCJvZmZzZXQiOjEyfQ.76b5696f839cafffd58653df27e76198986197a60ed5d561336ec8a93c8c39e3","offset":0,"omitted":18,"returned":12,"total":30},"query":{"claim":null,"limit":20,"section":"components","target":null},"references":{"/coverage/claimInventory":{"input":"manifest","pointer":"/claimInventory","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resultId":"matrix-fixed-epoch-exposition-baseline-v1","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b","rows":[{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:36477c7e74bf3a4a7973f3de079a69d2cb628838a7ef29a3b7dd3e5fd66fe6bb","componentId":"general-transcript-calibration","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{}},"statement":"\\begin{lemma}[Calibration properties]\\label{lem:calibration}\nFor every finite admissible horizon and fixed $\\varepsilon$, the transcript\naccountant value is continuous and nonincreasing in the raw noise, including\nat zero. Its feasible set is nonempty, and the calibration infimum is\nattained. At a positive minimizing noise, the accountant value equals\n$\\delta$. The same properties hold for the average-only accountant value\nas a function of $v$.\n\nAt full batch, $v_{\\mathrm{FB}}>0$ is independent of $E$ and is uniquely\nspecified by\n\\begin{equation}\\label{eq:gaussian-calibration}\n G_\\varepsilon(a)=\\delta,\\qquad a=\\Delta/\\sqrt{v_{\\mathrm{FB}}},\\qquad\n G_\\varepsilon(a)=\\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right).\n\\end{equation}\nAt full batch, $\\overline v_{E,E}=v_{\\mathrm{FB}}$.\nThe forward and reverse full-batch profiles coincide, and\n$G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0$ for $a>0$.\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:36477c7e74bf3a4a7973f3de079a69d2cb628838a7ef29a3b7dd3e5fd66fe6bb","componentId":"average-calibration","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{}},"statement":"\\begin{lemma}[Calibration properties]\\label{lem:calibration}\nFor every finite admissible horizon and fixed $\\varepsilon$, the transcript\naccountant value is continuous and nonincreasing in the raw noise, including\nat zero. Its feasible set is nonempty, and the calibration infimum is\nattained. At a positive minimizing noise, the accountant value equals\n$\\delta$. The same properties hold for the average-only accountant value\nas a function of $v$.\n\nAt full batch, $v_{\\mathrm{FB}}>0$ is independent of $E$ and is uniquely\nspecified by\n\\begin{equation}\\label{eq:gaussian-calibration}\n G_\\varepsilon(a)=\\delta,\\qquad a=\\Delta/\\sqrt{v_{\\mathrm{FB}}},\\qquad\n G_\\varepsilon(a)=\\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right).\n\\end{equation}\nAt full batch, $\\overline v_{E,E}=v_{\\mathrm{FB}}$.\nThe forward and reverse full-batch profiles coincide, and\n$G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0$ for $a>0$.\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"lem:calibration","claimRevision":"sha256:36477c7e74bf3a4a7973f3de079a69d2cb628838a7ef29a3b7dd3e5fd66fe6bb","componentId":"full-batch-properties","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#lem:calibration"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/0","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/0/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/0/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{}},"statement":"\\begin{lemma}[Calibration properties]\\label{lem:calibration}\nFor every finite admissible horizon and fixed $\\varepsilon$, the transcript\naccountant value is continuous and nonincreasing in the raw noise, including\nat zero. Its feasible set is nonempty, and the calibration infimum is\nattained. At a positive minimizing noise, the accountant value equals\n$\\delta$. The same properties hold for the average-only accountant value\nas a function of $v$.\n\nAt full batch, $v_{\\mathrm{FB}}>0$ is independent of $E$ and is uniquely\nspecified by\n\\begin{equation}\\label{eq:gaussian-calibration}\n G_\\varepsilon(a)=\\delta,\\qquad a=\\Delta/\\sqrt{v_{\\mathrm{FB}}},\\qquad\n G_\\varepsilon(a)=\\Phi\\!\\left(\\frac a2-\\frac\\varepsilon a\\right)\n -e^\\varepsilon\\Phi\\!\\left(-\\frac a2-\\frac\\varepsilon a\\right).\n\\end{equation}\nAt full batch, $\\overline v_{E,E}=v_{\\mathrm{FB}}$.\nThe forward and reverse full-batch profiles coincide, and\n$G_\\varepsilon'(a)=\\phi(a/2-\\varepsilon/a)>0$ for $a>0$.\n\\end{lemma}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:4f4fe8f61f31604feb26f7094fbb31e791d4243510b3a3ce53be01b5ddc86c7b","componentId":"transcript-excluding-symmetric-equality","correspondence":{"reviews":[{"id":"review-1","reviewer":{"id":"codex-implementation-agent-baseline-2026-10-02","kind":"model"},"status":"reviewed-with-differences"}],"status":"attributed-reviews"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["pointwise-privacy","pointwise-total"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/1/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/1/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{"unresolved":2}},"statement":"\\begin{theorem}[Horizon-dependent full-batch dominance]\n\\label{thm:rate-adaptive-pointwise}\nLet $E,T\\in\\N_{>0}$ with $T>E$, $\\Delta>0$, $\\varepsilon>0$, and\n$0<\\delta<1$. Put $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$, where\n$v_{\\mathrm{FB}}$ is the calibrated full-batch privacy variance. If\n\\begin{equation}\\label{eq:rate-adaptive-signal-condition}\n a^2\\leq\\Lambda_{E,T}\\varepsilon,\n\\end{equation}\nthen\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:4f4fe8f61f31604feb26f7094fbb31e791d4243510b3a3ce53be01b5ddc86c7b","componentId":"symmetric-equality-endpoint","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/1/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/1/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{}},"statement":"\\begin{theorem}[Horizon-dependent full-batch dominance]\n\\label{thm:rate-adaptive-pointwise}\nLet $E,T\\in\\N_{>0}$ with $T>E$, $\\Delta>0$, $\\varepsilon>0$, and\n$0<\\delta<1$. Put $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$, where\n$v_{\\mathrm{FB}}$ is the calibrated full-batch privacy variance. If\n\\begin{equation}\\label{eq:rate-adaptive-signal-condition}\n a^2\\leq\\Lambda_{E,T}\\varepsilon,\n\\end{equation}\nthen\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:rate-adaptive-pointwise","claimRevision":"sha256:4f4fe8f61f31604feb26f7094fbb31e791d4243510b3a3ce53be01b5ddc86c7b","componentId":"average-only-conclusions","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#thm:rate-adaptive-pointwise"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/1","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/1/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/1/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{}},"statement":"\\begin{theorem}[Horizon-dependent full-batch dominance]\n\\label{thm:rate-adaptive-pointwise}\nLet $E,T\\in\\N_{>0}$ with $T>E$, $\\Delta>0$, $\\varepsilon>0$, and\n$0<\\delta<1$. Put $a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$, where\n$v_{\\mathrm{FB}}$ is the calibrated full-batch privacy variance. If\n\\begin{equation}\\label{eq:rate-adaptive-signal-condition}\n a^2\\leq\\Lambda_{E,T}\\varepsilon,\n\\end{equation}\nthen\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"cor:fixed-epoch-all-horizon","claimRevision":"sha256:ef09f4b140e535d759e1117c17f6c144df1cbb7764461ba151583b0a0b27a7d9","componentId":"transcript-all-horizons","correspondence":{"reviews":[{"id":"review-2","reviewer":{"id":"codex-implementation-agent-baseline-2026-10-02","kind":"model"},"status":"reviewed-with-differences"}],"status":"attributed-reviews"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#cor:fixed-epoch-all-horizon"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["uniform-privacy","uniform-total"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/2","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/2/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/2/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{"unresolved":2}},"statement":"\\begin{corollary}[Full-batch dominance at every finite horizon]\n\\label{cor:fixed-epoch-all-horizon}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$, and put\n$a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$. If\n\\begin{equation}\\label{eq:epoch-uniform-condition}\n a^2\\leq\\Lambda_E\\varepsilon,\n \\qquad \\Lambda_E:=\\frac{6E}{3E+2},\n\\end{equation}\nthen, for every finite integer $T>E$,\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{corollary}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"cor:fixed-epoch-all-horizon","claimRevision":"sha256:ef09f4b140e535d759e1117c17f6c144df1cbb7764461ba151583b0a0b27a7d9","componentId":"average-only-conclusions","correspondence":{"reviews":[],"status":"not-reviewed"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#cor:fixed-epoch-all-horizon"},"expositionReview":"not-assessed","mapping":{"status":"unmapped","targetIds":[]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/2","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/2/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/2/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{}},"statement":"\\begin{corollary}[Full-batch dominance at every finite horizon]\n\\label{cor:fixed-epoch-all-horizon}\nFix $E\\in\\N_{>0}$, $\\Delta>0$, $\\varepsilon>0$, and $0<\\delta<1$, and put\n$a=\\Delta/\\sqrt{v_{\\mathrm{FB}}}$. If\n\\begin{equation}\\label{eq:epoch-uniform-condition}\n a^2\\leq\\Lambda_E\\varepsilon,\n \\qquad \\Lambda_E:=\\frac{6E}{3E+2},\n\\end{equation}\nthen, for every finite integer $T>E$,\n\\[\n v_{\\mathrm{FB}}<\\overline v_{E,T}\\leq v_{E,T},\n\\]\nand, for every $S\\geq0$,\n\\[\n V_E(E,S)=\\overline V_E(E,S)<\\overline V_E(T,S)\\leq V_E(T,S).\n\\]\n\\end{corollary}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:strict-interior-counterexample","claimRevision":"sha256:d09e037ed403b76de648db934086d98508a15946a33839f636b29998ffcf3899","componentId":"finite-transcript-reversal-and-energy-interval","correspondence":{"reviews":[{"id":"review-3","reviewer":{"id":"codex-implementation-agent-baseline-2026-10-02","kind":"model"},"status":"reviewed-with-differences"}],"status":"attributed-reviews"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#thm:strict-interior-counterexample"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["fullbatch-comparator","reversal-bracket","reversal-lower","reversal-total","reversal-upper"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/3","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/3/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/3/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{"unresolved":5}},"statement":"\\begin{theorem}[A finite reversal below the nonparticipation boundary]\n\\label{thm:strict-interior-counterexample}\nLet $\\Delta=1$, $E=2$, $\\varepsilon=1/4$, and $\\delta=3/4$. At the adjacent\nsmaller-batch horizon $T=3$, with $q=2/3$, the calibrated privacy variances\nsatisfy\n\\[\n v_3\\leq\\frac5{32}<\\frac4{25}<v_2.\n\\]\nConsequently,\n\\[\n 0\\leq S\\leq\\frac9{400}\n \\quad\\Longrightarrow\\quad V_2(3,S)<V_2(2,S).\n\\]\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:smallbatch","claimRevision":"sha256:deca59e9ab6e3aa5f8aabf7c76d67c3e01cf7bf625a497166982eefd67efd99c","componentId":"fixed-epoch-offset-via-schedule-specialization","correspondence":{"reviews":[{"id":"review-4","reviewer":{"id":"codex-implementation-agent-baseline-2026-10-02","kind":"model"},"status":"reviewed-with-differences"}],"status":"attributed-reviews"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"latex/natural-language/poisson_fixed_epoch_large_batch_optimality_proof.tex#thm:smallbatch"},"expositionReview":"not-assessed","mapping":{"status":"mapped","targetIds":["calibrated-offset"]},"references":{"":{"appendPath":false,"input":"manifest","pointer":"/claims/4","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/assessments":{"appendPath":false,"input":"assessments","pointer":"/assessments"},"/correspondence/reviews":{"appendPath":false,"input":"manifest","pointer":"/reviews","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/document":{"input":"manifest","pointer":"/claims/4/document","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/mapping":{"appendPath":false,"input":"manifest","pointer":"/links","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"},"/statement":{"input":"manifest","pointer":"/claims/4/statement","revision":"sha256:0483362a398ef90f8fea84c8cd442d581f9ec4d6d512f5537e678617970db89b"}},"resolution":{"statuses":{"unresolved":1}},"statement":"\\begin{theorem}[Sparse calibration and variance]\\label{thm:smallbatch}\nFix a positive integer $E$ and assume~\\eqref{eq:interior}. As $T\\to\\infty$\nthrough integers,\n\\[\n \\frac{\\Delta}{\\sigma_{E,T}}-\\sqrt{2\\log T}\n \\longrightarrow s_{E,\\delta}:=\n \\Phi^{-1}\\!\\left(-\\frac{\\log(1-\\delta)}{E}\\right).\n\\]\nIn particular,\n\\begin{equation}\\label{eq:sigmaasymptotic}\n \\sigma_{E,T}\\sim\\frac{\\Delta}{\\sqrt{2\\log T}}\\longrightarrow0,\n\\end{equation}\nwhereas\n\\begin{equation}\\label{eq:privacydivergence}\n v_{E,T}\\sim\\frac{\\Delta^2T}{2E^2\\log T}\\longrightarrow+\\infty.\n\\end{equation}\nFor every fixed $S\\geq0$,\n\\begin{equation}\\label{eq:total-equivalent}\n V_E(T,S)\\sim v_{E,T}.\n\\end{equation}\n\\end{theorem}"},{"assessmentStatus":"unassessed","assessments":[],"attributionReview":"not-assessed","checking":"inspect-checking-section","claimId":"thm:smallbatch","claimRevision":"sha256:deca59e9ab6e3aa5f8aabf7c76d67c3e01cf7bf625a497166982eefd67efd99c","componentId":"raw-noise-equivalent-and-zero","correspondence":{"reviews":[{"id":"review-5","reviewer":{"id":"codex-implementation-agent-baseline-2026-10-02","kind":"model"},"status":"reviewed-with-differences"}],"status":"attributed-reviews"},"document":{"digest":"sha256:a9b3ebb39ebb62db92975c8cdac82d82c978fcbf1bec5b10d9f036fb50b21118","locator":"lat