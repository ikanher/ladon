{
  "schema": "ladon-generated-family-policy-v2",
  "families": [
    {
      "id": "project.generated_rows",
      "pathPatterns": [
        "Project/Generated/*.lean"
      ],
      "generator": {
        "name": "project-generator",
        "version": "quoted-by-policy"
      },
      "manifest": {
        "identity": "project-generated-manifest",
        "path": "generated/manifest.json"
      },
      "reviewThreshold": {
        "metric": "memberCount",
        "atLeast": 100
      }
    }
  ]
}
